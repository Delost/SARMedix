@using Microsoft.AspNetCore.Http

@{
    string nombre =
        Context.Session.GetString("Nombre") ?? "";

    string apellido =
        Context.Session.GetString("Apellido") ?? "";

    string rol =
        Context.Session.GetString("Rol") ?? "";

    string nombreCompleto =
        (nombre + " " + apellido).Trim();

    string inicial =
        !string.IsNullOrEmpty(nombre)
            ? nombre.Substring(0, 1).ToUpper()
            : "U";

    bool sesionIniciada =
        !string.IsNullOrEmpty(nombre);

    string tituloBarra =
        ViewData["TituloBarra"]?.ToString() ?? "";
}


<!DOCTYPE html>

<html lang="es">


<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />


    <title>
        @ViewData["Title"] - SARMedix
    </title>


    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />


    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />


    <link rel="stylesheet"
          href="~/css/sidebar.css"
          asp-append-version="true" />


    <link rel="stylesheet"
          href="~/LoginSARMedix.styles.css"
          asp-append-version="true" />

</head>


<body>


    <!-- BARRA SUPERIOR -->

    <header class="barra-layout">


        <!-- LOGO -->

        <a asp-controller="Home"
           asp-action="Modulos"
           class="logo-layout">


            <div class="logo-cruz-layout">
            </div>


            <div class="logo-texto-layout">

                SARMedix | SAR de Chiguay

            </div>


        </a>



        <!-- TITULO CENTRAL -->

        <div class="titulo-layout">

            @tituloBarra

        </div>



        <!-- USUARIO -->

        @if (sesionIniciada)
        {
            <div class="usuario-layout">


                <div class="usuario-datos-layout">


                    <span class="usuario-nombre-layout">

                        @nombreCompleto

                    </span>


                    <span class="usuario-rol-layout">

                        @rol

                    </span>


                </div>



                <div class="usuario-circulo-layout">

                    @inicial

                </div>



                <!-- CERRAR SESION -->

                <form asp-controller="Home"
                      asp-action="CerrarSesion"
                      method="post"
                      id="formCerrarSesion"
                      class="form-cerrar-layout">


                    <button type="button"
                            class="btn-cerrar-layout"
                            onclick="abrirConfirmacionCerrarSesion()">

                        Cerrar sesión

                    </button>


                </form>


            </div>
        }
        else
        {
            <div></div>
        }


    </header>



    <!-- CONTENIDO -->

    @if (sesionIniciada)
    {
        <div class="estructura-app">


            <!-- BARRA LATERAL -->

            <partial name="_Sidebar" />



            <!-- CONTENIDO DE LA VISTA -->

            <div class="contenido-app">


                <main role="main"
                      class="pb-3">

                    @RenderBody()

                </main>


            </div>


        </div>
    }
    else
    {
        <div class="container contenedor-layout">


            <main role="main"
                  class="pb-3">

                @RenderBody()

            </main>


        </div>
    }



    <!-- FOOTER -->

    <footer class="footer-layout">

        SARMedix · Sistema de Gestión Farmacéutica · SAR de Chiguay

    </footer>



    <!-- CONFIRMACION CERRAR SESION -->

    @if (sesionIniciada)
    {
        <div id="modalCerrarSesion"
             class="modal-fondo-sesion">


            <div class="modal-contenido-sesion">


                <div class="modal-icono-sesion">

                    ?

                </div>


                <h2>

                    Confirmar acción

                </h2>


                <p>

                    ¿Quieres cerrar sesión?

                </p>


                <div class="modal-botones-sesion">


                    <button type="button"
                            class="btn-sesion-si"
                            onclick="confirmarCerrarSesion()">

                        Sí

                    </button>


                    <button type="button"
                            class="btn-sesion-no"
                            onclick="cerrarConfirmacionCerrarSesion()">

                        No

                    </button>


                </div>


            </div>


        </div>
    }



    <!-- SCRIPTS -->

    <script src="~/lib/jquery/dist/jquery.min.js">
    </script>


    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js">
    </script>


    <script src="~/js/site.js"
            asp-append-version="true">
    </script>


    <script>

        // ABRIR CONFIRMACION

        function abrirConfirmacionCerrarSesion() {

            const modal =
                document.getElementById(
                    "modalCerrarSesion"
                );


            if (modal) {

                modal.style.display =
                    "flex";

            }

        }



        // NO

        function cerrarConfirmacionCerrarSesion() {

            const modal =
                document.getElementById(
                    "modalCerrarSesion"
                );


            if (modal) {

                modal.style.display =
                    "none";

            }

        }



        // SI - CERRAR SESION

        function confirmarCerrarSesion() {

            const formulario =
                document.getElementById(
                    "formCerrarSesion"
                );


            if (formulario) {

                formulario.submit();

            }

        }

    </script>


    @await RenderSectionAsync(
        "Scripts",
        required: false
    )


</body>

</html>