@using System.Text.RegularExpressions
@model List<LoginSARMedix.Models.Historial>

@{
    ViewData["Title"] = "Historial de Usuarios";
    ViewData["TituloBarra"] = "Historial de Usuarios";

    string buscarActual =
        ViewBag.Buscar?.ToString() ?? "";

    string filtroActual =
        ViewBag.Filtro?.ToString() ?? "todos";

    string periodoActual =
        ViewBag.Periodo?.ToString() ?? "todos";

    int totalRegistros =
        ViewBag.TotalRegistros != null
            ? Convert.ToInt32(
                ViewBag.TotalRegistros
            )
            : 0;
}


<div class="historial-card">

    <div class="historial-titulo">

        <h1>
            Historial de Usuarios
        </h1>

        <p>
            Registro de cambios, creación, edición y gestión de usuarios en SARMedix
        </p>

    </div>



    <!-- =========================================================
         HERRAMIENTAS
         ========================================================= -->

    <div class="historial-herramientas">


        <!-- =====================================================
             BUSQUEDA
             ===================================================== -->

        <form asp-controller="Home"
              asp-action="HistorialUsuarios"
              method="get"
              class="form-busqueda">


            <input type="hidden"
                   name="filtro"
                   value="@filtroActual" />


            <input type="hidden"
                   name="periodo"
                   value="@periodoActual" />



            <div class="filtro-busqueda">

                <span class="filtro-icono-busqueda">

                    🔎

                </span>


                <input type="text"
                       name="buscar"
                       value="@buscarActual"
                       placeholder="Buscar por responsable, nombre o cuenta..."
                       autocomplete="off" />

            </div>



            <button type="submit"
                    class="btn-buscar">

                Buscar

            </button>


        </form>



        <!-- =====================================================
             FILTROS
             ===================================================== -->

        <form asp-controller="Home"
              asp-action="HistorialUsuarios"
              method="get"
              class="form-filtros">


            <!--
                MANTENER LA BUSQUEDA ACTUAL.
            -->

            <input type="hidden"
                   name="buscar"
                   value="@buscarActual" />



            <!-- TIPO DE ACCION -->

            <div class="filtro-campo">

                <label for="filtroUsuarios">

                    Acción

                </label>


                <select id="filtroUsuarios"
                        name="filtro">


                    <option value="todos"
                            selected="@(filtroActual == "todos" ? "selected" : null)">

                        Todas las acciones

                    </option>


                    <option value="crear"
                            selected="@(filtroActual == "crear" ? "selected" : null)">

                        Creación

                    </option>


                    <option value="actualizar"
                            selected="@(filtroActual == "actualizar" ? "selected" : null)">

                        Edición

                    </option>


                    <option value="desactivar"
                            selected="@(filtroActual == "desactivar" ? "selected" : null)">

                        Desactivación

                    </option>


                    <option value="reactivar"
                            selected="@(filtroActual == "reactivar" ? "selected" : null)">

                        Reactivación

                    </option>


                    <option value="eliminar"
                            selected="@(filtroActual == "eliminar" ? "selected" : null)">

                        Eliminación

                    </option>


                </select>

            </div>



            <!-- PERIODO -->

            <div class="filtro-campo">

                <label for="periodoUsuarios">

                    Período

                </label>


                <select id="periodoUsuarios"
                        name="periodo">


                    <option value="todos"
                            selected="@(periodoActual == "todos" ? "selected" : null)">

                        Todo el historial

                    </option>


                    <option value="hoy"
                            selected="@(periodoActual == "hoy" ? "selected" : null)">

                        Hoy

                    </option>


                    <option value="7"
                            selected="@(periodoActual == "7" ? "selected" : null)">

                        Últimos 7 días

                    </option>


                    <option value="30"
                            selected="@(periodoActual == "30" ? "selected" : null)">

                        Últimos 30 días

                    </option>


                </select>

            </div>



            <!-- APLICAR -->

            <button type="submit"
                    class="btn-aplicar-filtros">

                Aplicar

            </button>



            <!--
                LIMPIAR SOLAMENTE LOS FILTROS.

                CONSERVA LA BUSQUEDA.
            -->

            <a asp-controller="Home"
               asp-action="HistorialUsuarios"
               asp-route-buscar="@buscarActual"
               class="btn-limpiar-filtros">

                Limpiar

            </a>


        </form>


    </div>



    <!-- =========================================================
         RESUMEN
         ========================================================= -->

    <div class="historial-resumen-filtros">

        <span>

            Registros encontrados:

            <strong>
                @totalRegistros
            </strong>

        </span>


        @if (!string.IsNullOrWhiteSpace(
                buscarActual))
        {
            <span class="filtro-activo">

                🔎 “@buscarActual”

            </span>
        }


        @if (filtroActual != "todos")
        {
            <span class="filtro-activo">

                Acción:
                @(filtroActual == "crear"
                    ? "Creación"
                    : filtroActual == "actualizar"
                        ? "Edición"
                        : filtroActual == "desactivar"
                            ? "Desactivación"
                            : filtroActual == "reactivar"
                                ? "Reactivación"
                                : "Eliminación")

            </span>
        }


        @if (periodoActual != "todos")
        {
            <span class="filtro-activo">

                Período:
                @(periodoActual == "hoy"
                    ? "Hoy"
                    : periodoActual == "7"
                        ? "Últimos 7 días"
                        : "Últimos 30 días")

            </span>
        }

    </div>



    <!-- =========================================================
         TABLA
         ========================================================= -->

    @if (Model != null &&
         Model.Count > 0)
    {
        <div class="tabla-contenedor">

            <table class="tabla-historial">

                <thead>

                    <tr>

                        <th class="columna-id">

                            ID

                        </th>


                        <th class="columna-responsable">

                            Responsable

                        </th>


                        <th class="columna-descripcion">

                            Descripción

                        </th>


                        <th class="columna-fecha">

                            Fecha y hora

                        </th>

                    </tr>

                </thead>



                <tbody>

                    @foreach (var registro in Model)
                    {
                        string descripcion =
                            registro.descripcion ?? "";


                        string tipoRegistro =
                            "Simple";


                        string nombreUsuario =
                            "";


                        string cuenta =
                            "";


                        string[] cambios =
                            Array.Empty<string>();



                        /*
                            CREAR USUARIO
                        */

                        Match crearUsuario =
                            Regex.Match(
                                descripcion,
                                @"^Creó al usuario (.+?) \((.+?)\)$",
                                RegexOptions.IgnoreCase
                            );


                        if (crearUsuario.Success)
                        {
                            tipoRegistro =
                                "CrearUsuario";


                            nombreUsuario =
                                crearUsuario.Groups[1]
                                    .Value;


                            cuenta =
                                crearUsuario.Groups[2]
                                    .Value;
                        }



                        /*
                            ACTUALIZAR USUARIO
                        */

                        Match actualizarUsuario =
                            Regex.Match(
                                descripcion,
                                @"^Actualizó al usuario (.+?) \((.+?)\)\.\s*(.*)$",
                                RegexOptions.IgnoreCase
                            );


                        if (actualizarUsuario.Success)
                        {
                            tipoRegistro =
                                "ActualizarUsuario";


                            nombreUsuario =
                                actualizarUsuario.Groups[1]
                                    .Value;


                            cuenta =
                                actualizarUsuario.Groups[2]
                                    .Value;


                            cambios =
                                actualizarUsuario.Groups[3]
                                    .Value
                                    .Split(
                                        '|',
                                        StringSplitOptions.RemoveEmptyEntries
                                    );
                        }



                        /*
                            DESACTIVAR USUARIO
                        */

                        Match desactivarUsuario =
                            Regex.Match(
                                descripcion,
                                @"^Desactivó al usuario (.+?) \((.+?)\)$",
                                RegexOptions.IgnoreCase
                            );


                        if (desactivarUsuario.Success)
                        {
                            tipoRegistro =
                                "DesactivarUsuario";


                            nombreUsuario =
                                desactivarUsuario.Groups[1]
                                    .Value;


                            cuenta =
                                desactivarUsuario.Groups[2]
                                    .Value;
                        }



                        /*
                            REACTIVAR USUARIO
                        */

                        Match reactivarUsuario =
                            Regex.Match(
                                descripcion,
                                @"^Reactivó al usuario (.+?) \((.+?)\)$",
                                RegexOptions.IgnoreCase
                            );


                        if (reactivarUsuario.Success)
                        {
                            tipoRegistro =
                                "ReactivarUsuario";


                            nombreUsuario =
                                reactivarUsuario.Groups[1]
                                    .Value;


                            cuenta =
                                reactivarUsuario.Groups[2]
                                    .Value;
                        }



                        /*
                            ELIMINAR USUARIO
                        */

                        Match eliminarUsuario =
                            Regex.Match(
                                descripcion,
                                @"^Eliminó al usuario (.+?) \((.+?)\)$",
                                RegexOptions.IgnoreCase
                            );


                        if (eliminarUsuario.Success)
                        {
                            tipoRegistro =
                                "EliminarUsuario";


                            nombreUsuario =
                                eliminarUsuario.Groups[1]
                                    .Value;


                            cuenta =
                                eliminarUsuario.Groups[2]
                                    .Value;
                        }



                        <tr>


                            <!-- ID -->

                            <td>

                                <span class="historial-id">

                                    @registro.id_historial

                                </span>

                            </td>



                            <!-- RESPONSABLE -->

                            <td>

                                <div class="responsable-historial">


                                    <span class="responsable-icono">

                                        👤

                                    </span>


                                    <span>

                                        @registro.usuario_responsable

                                    </span>


                                </div>

                            </td>



                            <!-- DESCRIPCION -->

                            <td class="descripcion-historial">



                                <!-- CREAR -->

                                @if (tipoRegistro ==
                                     "CrearUsuario")
                                {
                                    <div class="evento-card evento-usuario">


                                        <div class="evento-cabecera">


                                            <span class="evento-tipo tipo-crear">

                                                ＋ Usuario creado

                                            </span>


                                            <strong class="evento-nombre">

                                                @nombreUsuario

                                            </strong>


                                        </div>



                                        <div class="evento-explicacion">


                                            <span class="evento-label">

                                                Acción realizada

                                            </span>


                                            <p>

                                                Se creó una nueva cuenta
                                                de usuario para

                                                <strong>
                                                    @nombreUsuario
                                                </strong>

                                                con el nombre de usuario

                                                <strong>
                                                    @cuenta
                                                </strong>.

                                            </p>


                                        </div>



                                        <div class="evento-datos">


                                            <div class="evento-dato">

                                                <span class="evento-label">

                                                    Usuario

                                                </span>

                                                <strong>

                                                    @nombreUsuario

                                                </strong>

                                            </div>


                                            <div class="evento-dato">

                                                <span class="evento-label">

                                                    Cuenta

                                                </span>

                                                <strong>

                                                    @cuenta

                                                </strong>

                                            </div>


                                            <div class="evento-dato">

                                                <span class="evento-label">

                                                    Estado

                                                </span>

                                                <strong class="estado-activo">

                                                    Activo

                                                </strong>

                                            </div>


                                        </div>


                                    </div>
                                }



                                <!-- ACTUALIZAR -->

                                @if (tipoRegistro ==
                                     "ActualizarUsuario")
                                {
                                    <div class="evento-card evento-usuario">


                                        <div class="evento-cabecera">


                                            <span class="evento-tipo tipo-editar">

                                                ✎ Usuario actualizado

                                            </span>


                                            <strong class="evento-nombre">

                                                @nombreUsuario

                                            </strong>


                                        </div>



                                        <div class="evento-explicacion">


                                            <span class="evento-label">

                                                Acción realizada

                                            </span>


                                            <p>

                                                Se modificó la información
                                                del usuario

                                                <strong>
                                                    @nombreUsuario
                                                </strong>

                                                asociado a la cuenta

                                                <strong>
                                                    @cuenta
                                                </strong>.

                                            </p>


                                        </div>



                                        @if (cambios.Length > 0)
                                        {
                                            <div class="cambios-contenedor">


                                                <span class="evento-label">

                                                    Cambios realizados

                                                </span>


                                                <div class="lista-cambios">


                                                    @foreach (
                                                        string cambio
                                                        in cambios)
                                                    {
                                                        <div class="cambio-item">


                                                            <span class="cambio-icono">

                                                                ↔

                                                            </span>


                                                            <span>

                                                                @cambio.Trim()

                                                            </span>


                                                        </div>
                                                    }


                                                </div>


                                            </div>
                                        }


                                    </div>
                                }



                                <!-- DESACTIVAR -->

                                @if (tipoRegistro ==
                                     "DesactivarUsuario")
                                {
                                    <div class="evento-card evento-usuario">


                                        <div class="evento-cabecera">


                                            <span class="evento-tipo tipo-desactivar">

                                                ↓ Usuario desactivado

                                            </span>


                                            <strong class="evento-nombre">

                                                @nombreUsuario

                                            </strong>


                                        </div>



                                        <div class="evento-explicacion">


                                            <span class="evento-label">

                                                Acción realizada

                                            </span>


                                            <p>

                                                Se desactivó la cuenta
                                                del usuario

                                                <strong>
                                                    @nombreUsuario
                                                </strong>

                                                identificada como

                                                <strong>
                                                    @cuenta
                                                </strong>.

                                            </p>


                                        </div>



                                        <div class="evento-datos evento-datos-dos">


                                            <div class="evento-dato">

                                                <span class="evento-label">

                                                    Cuenta

                                                </span>

                                                <strong>

                                                    @cuenta

                                                </strong>

                                            </div>



                                            <div class="evento-dato">

                                                <span class="evento-label">

                                                    Cambio de estado

                                                </span>


                                                <strong class="cambio-estado">


                                                    <span class="estado-activo">

                                                        Activo

                                                    </span>


                                                    <span class="flecha-cambio">

                                                        →

                                                    </span>


                                                    <span class="estado-inactivo">

                                                        Inactivo

                                                    </span>


                                                </strong>


                                            </div>


                                        </div>


                                    </div>
                                }



                                <!-- REACTIVAR -->

                                @if (tipoRegistro ==
                                     "ReactivarUsuario")
                                {
                                    <div class="evento-card evento-usuario">


                                        <div class="evento-cabecera">


                                            <span class="evento-tipo tipo-reactivar">

                                                ↑ Usuario reactivado

                                            </span>


                                            <strong class="evento-nombre">

                                                @nombreUsuario

                                            </strong>


                                        </div>



                                        <div class="evento-explicacion">


                                            <span class="evento-label">

                                                Acción realizada

                                            </span>


                                            <p>

                                                Se reactivó la cuenta
                                                del usuario

                                                <strong>
                                                    @nombreUsuario
                                                </strong>

                                                identificada como

                                                <strong>
                                                    @cuenta
                                                </strong>.

                                            </p>


                                        </div>



                                        <div class="evento-datos evento-datos-dos">


                                            <div class="evento-dato">

                                                <span class="evento-label">

                                                    Cuenta

                                                </span>

                                                <strong>

                                                    @cuenta

                                                </strong>

                                            </div>



                                            <div class="evento-dato">

                                                <span class="evento-label">

                                                    Cambio de estado

                                                </span>


                                                <strong class="cambio-estado">


                                                    <span class="estado-inactivo">

                                                        Inactivo

                                                    </span>


                                                    <span class="flecha-cambio">

                                                        →

                                                    </span>


                                                    <span class="estado-activo">

                                                        Activo

                                                    </span>


                                                </strong>


                                            </div>


                                        </div>


                                    </div>
                                }



                                <!-- ELIMINAR -->

                                @if (tipoRegistro ==
                                     "EliminarUsuario")
                                {
                                    <div class="evento-card evento-usuario">


                                        <div class="evento-cabecera">


                                            <span class="evento-tipo tipo-eliminar">

                                                ✕ Usuario eliminado

                                            </span>


                                            <strong class="evento-nombre">

                                                @nombreUsuario

                                            </strong>


                                        </div>



                                        <div class="evento-explicacion">


                                            <span class="evento-label">

                                                Acción realizada

                                            </span>


                                            <p>

                                                Se eliminó del sistema
                                                el registro del usuario

                                                <strong>
                                                    @nombreUsuario
                                                </strong>

                                                asociado a la cuenta

                                                <strong>
                                                    @cuenta
                                                </strong>.

                                            </p>


                                        </div>


                                    </div>
                                }



                                <!-- SIMPLE -->

                                @if (tipoRegistro ==
                                     "Simple")
                                {
                                    <div class="descripcion-simple">


                                        <span class="descripcion-simple-icono">

                                            👤

                                        </span>


                                        <div class="descripcion-simple-contenido">


                                            <span class="descripcion-simple-categoria">

                                                Usuarios

                                            </span>


                                            <span class="descripcion-simple-texto">

                                                @descripcion

                                            </span>


                                        </div>


                                    </div>
                                }


                            </td>



                            <!-- FECHA -->

                            <td>

                                <div class="fecha-historial">


                                    <span class="fecha-dia">

                                        @registro.fecha_hora.ToString(
                                            "dd-MM-yyyy"
                                        )

                                    </span>


                                    <span class="fecha-hora">

                                        @registro.fecha_hora.ToString(
                                            "HH:mm:ss"
                                        )

                                    </span>


                                </div>

                            </td>


                        </tr>
                    }

                </tbody>

            </table>

        </div>



        <!-- =====================================================
             PAGINACION
             ===================================================== -->

        @if (ViewBag.TotalPaginas > 1)
        {
            <div class="paginacion">


                @if (ViewBag.PaginaActual > 1)
                {
                    <a asp-controller="Home"
                       asp-action="HistorialUsuarios"
                       asp-route-pagina="@(ViewBag.PaginaActual - 1)"
                       asp-route-buscar="@buscarActual"
                       asp-route-filtro="@filtroActual"
                       asp-route-periodo="@periodoActual"
                       class="pagina-boton">

                        ← Anterior

                    </a>
                }



                @for (
                    int i = 1;
                    i <= ViewBag.TotalPaginas;
                    i++)
                {
                    <a asp-controller="Home"
                       asp-action="HistorialUsuarios"
                       asp-route-pagina="@i"
                       asp-route-buscar="@buscarActual"
                       asp-route-filtro="@filtroActual"
                       asp-route-periodo="@periodoActual"
                       class="pagina-boton @(i == ViewBag.PaginaActual ? "pagina-activa" : "")">

                        @i

                    </a>
                }



                @if (ViewBag.PaginaActual <
                     ViewBag.TotalPaginas)
                {
                    <a asp-controller="Home"
                       asp-action="HistorialUsuarios"
                       asp-route-pagina="@(ViewBag.PaginaActual + 1)"
                       asp-route-buscar="@buscarActual"
                       asp-route-filtro="@filtroActual"
                       asp-route-periodo="@periodoActual"
                       class="pagina-boton">

                        Siguiente →

                    </a>
                }


            </div>
        }
    }
    else
    {
        <div class="sin-registros">


            @if (
                !string.IsNullOrWhiteSpace(
                    buscarActual
                )
                ||
                filtroActual != "todos"
                ||
                periodoActual != "todos")
            {
                <strong>

                    No se encontraron usuarios
                    con esos criterios.

                </strong>


                <span>

                    Prueba cambiando la búsqueda
                    o modificando los filtros.

                </span>
            }
            else
            {
                <strong>

                    No existen registros
                    relacionados con usuarios.

                </strong>
            }


        </div>
    }



    <div class="contenedor-volver">

        <a asp-controller="Home"
           asp-action="MovimientoHistorial"
           class="btn-volver">

            ← Volver a Movimientos e Historial

        </a>

    </div>


</div>



<style>

    .historial-card {
        width: 95%;
        max-width: 1200px;
        margin: 5px auto;
    }


    .historial-titulo {
        margin-bottom: 20px;
        text-align: center;
    }


    .historial-titulo h1 {
        margin-bottom: 8px;
        color: #087bc2;
        font-size: 32px;
    }


    .historial-titulo p {
        margin: 0;
        color: #687b89;
        font-size: 16px;
    }



    /* HERRAMIENTAS */

    .historial-herramientas {
        margin-bottom: 10px;

        padding: 15px;

        display: grid;

        grid-template-columns:
            minmax(350px, 1.4fr)
            minmax(480px, 1fr);

        gap: 14px;

        align-items: end;

        border: 1px solid #d7e5eb;

        border-radius: 12px;

        background-color:
            rgba(
                255,
                255,
                255,
                0.96
            );

        box-shadow:
            0 5px 16px
            rgba(
                28,
                65,
                95,
                0.08
            );
    }



    /* BUSQUEDA */

    .form-busqueda {
        display: grid;

        grid-template-columns:
            minmax(0, 1fr)
            auto;

        gap: 8px;

        align-items: end;
    }


    .filtro-busqueda {
        min-height: 43px;

        display: flex;

        align-items: center;

        gap: 8px;

        padding: 0 12px;

        border: 1px solid #cbdce4;

        border-radius: 8px;

        background-color: #fbfdfe;
    }


    .filtro-icono-busqueda {
        font-size: 15px;

        opacity: 0.7;
    }


    .filtro-busqueda input {
        width: 100%;

        border: none;

        outline: none;

        background: transparent;

        color: #24485d;

        font-size: 13px;
    }


    .filtro-busqueda:focus-within {
        border-color: #087bc2;

        box-shadow:
            0 0 0 3px
            rgba(
                8,
                123,
                194,
                0.11
            );
    }


    .btn-buscar {
        min-height: 43px;

        padding: 0 18px;

        border: 1px solid #087bc2;

        border-radius: 8px;

        background-color: #087bc2;

        color: white;

        font-size: 12px;

        font-weight: 700;

        cursor: pointer;
    }


    .btn-buscar:hover {
        background-color: #066aa7;
    }



    /* FILTROS */

    .form-filtros {
        display: grid;

        grid-template-columns:
            minmax(150px, 1fr)
            minmax(150px, 1fr)
            auto
            auto;

        gap: 8px;

        align-items: end;
    }


    .filtro-campo {
        display: flex;

        flex-direction: column;

        gap: 5px;
    }


    .filtro-campo label {
        color: #627985;

        font-size: 10px;

        font-weight: 800;

        text-transform: uppercase;
    }


    .filtro-campo select {
        min-height: 43px;

        padding: 0 10px;

        border: 1px solid #cbdce4;

        border-radius: 8px;

