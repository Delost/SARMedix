@using LoginSARMedix.Models
@model BajaInventario

@{
    ViewData["Title"] = "Baja / merma";
    ViewData["TituloBarra"] = "Baja / merma";

    var lotes =
        ViewBag.LotesBodega as List<Lote>
        ?? new List<Lote>();

    var unidades =
        ViewBag.UnidadesProductos as Dictionary<int, string>
        ?? new Dictionary<int, string>();

    string mensaje =
        TempData["Mensaje"]?.ToString()
        ?? "";

    string tipoMensaje =
        TempData["TipoMensaje"]?.ToString()
        ?? "";
}

<style>
    .salida-pagina{width:min(1040px,94%);margin:34px auto 48px}
    .salida-titulo{margin-bottom:18px}
    .salida-titulo h1{margin:0 0 6px;color:#123451;font-size:30px;font-weight:850}
    .salida-titulo p{margin:0;color:#5f788c}
    .aviso{padding:14px 16px;border:1px solid #f0c9a7;border-radius:10px;background:#fff7ed;color:#815025;margin-bottom:18px}
    .mensaje{padding:13px 16px;border-radius:10px;margin-bottom:18px;font-weight:750}
    .ok{background:#eaf8ef;border:1px solid #b8dfc5;color:#21633a}
    .error{background:#fff0f0;border:1px solid #efc1c1;color:#9d2f2f}
    .panel{background:rgba(255,255,255,.96);border-radius:16px;padding:24px;box-shadow:0 12px 30px rgba(30,72,103,.14)}
    .grid{display:grid;grid-template-columns:1.25fr .85fr;gap:22px}
    .bloque{border:1px solid #dae7ef;border-radius:13px;padding:20px;background:#fbfdff}
    label{display:block;margin:0 0 7px;color:#29465d;font-weight:750;font-size:14px}
    select,input,textarea{width:100%;padding:11px 12px;border:1px solid #c7d8e4;border-radius:9px;background:white;color:#17324d;font-size:14px}
    textarea{min-height:105px;resize:vertical}
    .campo{margin-bottom:17px}
    .resumen{border-radius:13px;padding:21px;background:linear-gradient(145deg,#8d4d22,#bb6b32);color:white}
    .fila{padding:10px 0;border-bottom:1px solid rgba(255,255,255,.2);display:flex;justify-content:space-between;gap:16px}
    .acciones{display:flex;justify-content:flex-end;gap:10px;margin-top:20px}
    .btn{padding:10px 18px;border-radius:9px;font-weight:800;text-decoration:none;cursor:pointer}
    .volver{border:1px solid #cad9e4;background:white;color:#435f72}
    .confirmar{border:0;background:#a94f24;color:white}
    .confirmar:disabled{opacity:.45;cursor:not-allowed}
    @@media(max-width:800px){.grid{grid-template-columns:1fr}}
</style>

<section class="salida-pagina">

    <div class="salida-titulo">
        <h1>Baja / merma de inventario</h1>
        <p>Registra stock que debe salir definitivamente de una Bodega.</p>
    </div>

    <div class="aviso">
        ⚠ Esta acción <strong>no elimina el producto del catálogo</strong>.
        Descuenta stock de un lote y deja trazabilidad. Solo Enfermera o Administrador.
        Los medicamentos controlados continúan en su módulo restringido.
    </div>

    @if (!string.IsNullOrWhiteSpace(mensaje))
    {
        <div class="mensaje @(tipoMensaje == "exito" ? "ok" : "error")">
            @mensaje
        </div>
    }

    <form asp-controller="Home"
          asp-action="RegistrarBajaInventario"
          method="post"
          id="formBaja">

        @Html.AntiForgeryToken()

        <div class="panel">
            <div class="grid">

                <div class="bloque">

                    <div class="campo">
                        <label asp-for="id_lote">Lote en Bodega</label>

                        <select asp-for="id_lote"
                                id="loteBaja"
                                required>
                            <option value="">Seleccione producto y lote...</option>

                            @foreach (var lote in lotes)
                            {
                                string unidad =
                                    unidades.ContainsKey(lote.id_producto)
                                        ? unidades[lote.id_producto]
                                        : "unidades";

                                <option value="@lote.id_lote"
                                        data-producto="@lote.nombre_producto"
                                        data-lote="@lote.numero_lote"
                                        data-sector="@lote.nombre_ubicacion"
                                        data-stock="@lote.cantidad_actual"
                                        data-unidad="@unidad"
                                        data-vencimiento="@(lote.fecha_vencimiento?.ToString("dd/MM/yyyy") ?? "-")">
                                    @lote.nombre_producto — Lote @lote.numero_lote — @lote.nombre_ubicacion — @lote.cantidad_actual @unidad
                                </option>
                            }
                        </select>
                    </div>

                    <div class="campo">
                        <label asp-for="cantidad">Cantidad a dar de baja</label>
                        <input asp-for="cantidad"
                               id="cantidadBaja"
                               type="number"
                               min="1"
                               placeholder="Ej.: 10"
                               required />
                    </div>

                    <div class="campo">
                        <label asp-for="motivo">Motivo</label>
                        <textarea asp-for="motivo"
                                  maxlength="150"
                                  placeholder="Ej.: vencimiento, envase dañado, pérdida de integridad..."
                                  required></textarea>
                    </div>

                </div>

                <aside class="resumen">
                    <h2 style="margin-top:0;font-size:19px;">Resumen</h2>

                    <div class="fila">
                        <span>Producto</span>
                        <strong id="rProducto">—</strong>
                    </div>

                    <div class="fila">
                        <span>Lote</span>
                        <strong id="rLote">—</strong>
                    </div>

                    <div class="fila">
                        <span>Bodega</span>
                        <strong id="rSector">—</strong>
                    </div>

                    <div class="fila">
                        <span>Vencimiento</span>
                        <strong id="rVence">—</strong>
                    </div>

                    <div class="fila">
                        <span>Stock disponible</span>
                        <strong id="rStock">—</strong>
                    </div>

                    <div class="fila">
                        <span>Baja</span>
                        <strong id="rCantidad">0</strong>
                    </div>
                </aside>

            </div>

            <div class="acciones">
                <a asp-controller="Home"
                   asp-action="MovimientoHistorial"
                   class="btn volver">Volver</a>

                <button type="submit"
                        id="btnBaja"
                        class="btn confirmar"
                        disabled>
                    Registrar baja
                </button>
            </div>
        </div>
    </form>
</section>

<script>
    const lote = document.getElementById("loteBaja");
    const cantidad = document.getElementById("cantidadBaja");
    const boton = document.getElementById("btnBaja");

    function actualizarBaja() {
        const op = lote.options[lote.selectedIndex];
        const stock = parseInt(op?.dataset?.stock || "0");
        const cant = parseInt(cantidad.value || "0");
        const unidad = op?.dataset?.unidad || "unidades";

        document.getElementById("rProducto").textContent = op?.dataset?.producto || "—";
        document.getElementById("rLote").textContent = op?.dataset?.lote || "—";
        document.getElementById("rSector").textContent = op?.dataset?.sector || "—";
        document.getElementById("rVence").textContent = op?.dataset?.vencimiento || "—";
        document.getElementById("rStock").textContent = lote.value ? `${stock} ${unidad}` : "—";
        document.getElementById("rCantidad").textContent = cant > 0 ? `${cant} ${unidad}` : `0 ${unidad}`;

        boton.disabled = !(lote.value && cant > 0 && cant <= stock);
    }

    lote.addEventListener("change", actualizarBaja);
    cantidad.addEventListener("input", actualizarBaja);

    document.getElementById("formBaja").addEventListener("submit", function(e) {
        if (!confirm("¿Confirma la baja definitiva de este stock?")) {
            e.preventDefault();
        }
    });

    actualizarBaja();
</script>
