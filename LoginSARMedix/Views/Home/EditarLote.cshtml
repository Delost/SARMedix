@model LoginSARMedix.Models.Lote

@{
    ViewData["Title"] = "Editar Lote";
    ViewData["TituloBarra"] = "Editar Lote";

    string mensaje =
        TempData["Mensaje"]?.ToString()
        ?? ViewBag.Mensaje?.ToString()
        ?? "";

    string tipoMensaje =
        TempData["TipoMensaje"]?.ToString()
        ?? (ViewBag.Mensaje != null ? "error" : "");
}


<h2>Editar lote</h2>


<form asp-controller="Home"
      asp-action="ActualizarLote"
      method="post"
      class="formulario-principal"
      id="formEditarLote"
      onsubmit="return validarYConfirmar()"
      novalidate>


    <!-- ========================================= -->
    <!-- ID DEL LOTE                               -->
    <!-- ========================================= -->

    <input asp-for="id_lote"
           type="hidden" />



    <!-- ========================================= -->
    <!-- MENSAJE                                   -->
    <!-- ========================================= -->

    <div class="espacio-mensaje">

        @if (!string.IsNullOrEmpty(mensaje))
        {
            if (tipoMensaje == "exito")
            {
                <div class="mensaje mensaje-exito"
                     id="mensajeFormulario">

                    @mensaje

                </div>
            }
            else
            {
                <div class="mensaje mensaje-error"
                     id="mensajeFormulario">

                    @mensaje

                </div>
            }
        }
        else
        {
            <div class="mensaje mensaje-error mensaje-oculto"
                 id="mensajeFormulario">
            </div>
        }

    </div>



    <!-- ========================================= -->
    <!-- PRODUCTO                                  -->
    <!-- ========================================= -->

    <div>

        <label>Producto</label>

        <select asp-for="id_producto"
                id="producto">

            @foreach (var producto in ViewBag.Productos)
            {
                <option value="@producto.id_producto">

                    @producto.codigo_interno -
                    @producto.nombre

                </option>
            }

        </select>

    </div>



    <!-- ========================================= -->
    <!-- NUMERO DE LOTE                            -->
    <!-- ========================================= -->

    <div>

        <label>Número de lote</label>

        <input asp-for="numero_lote"
               id="numeroLote" />

    </div>



    <!-- ========================================= -->
    <!-- FECHA DE VENCIMIENTO                      -->
    <!-- ========================================= -->

    <div>

        <label>Fecha de vencimiento</label>

        <input asp-for="fecha_vencimiento"
               id="fechaVencimiento"
               type="date" />

    </div>



    <!-- ========================================= -->
    <!-- CANTIDAD ACTUAL                           -->
    <!-- ========================================= -->

    <div>

        <label>Cantidad actual</label>

        <input asp-for="cantidad_actual"
               id="cantidadActual"
               type="number"
               min="0" />

    </div>



    <!-- ========================================= -->
    <!-- UBICACION                                 -->
    <!-- ========================================= -->

    <div>

        <label>Ubicación</label>

        <select asp-for="id_ubicacion"
                id="ubicacion">

            @foreach (var ubicacion in ViewBag.Ubicaciones)
            {
                <option value="@ubicacion.id_ubicacion">

                    @ubicacion.nombre_sector

                </option>
            }

        </select>

    </div>



    <br />



    <!-- ========================================= -->
    <!-- BOTON ACTUALIZAR                          -->
    <!-- ========================================= -->

    <button type="submit">

        Actualizar lote

    </button>


</form>



<!-- ========================================= -->
<!-- BOTONES DE NAVEGACION                     -->
<!-- ========================================= -->

<div class="contenedor-volver">


    <a asp-controller="Home"
       asp-action="Lotes"
       class="btn-volver-listado">

        ← Volver al listado de lotes

    </a>


    <a asp-controller="Home"
       asp-action="Productos"
       class="btn-volver-productos">

        ← Volver a Productos

    </a>


</div>



<!-- ========================================= -->
<!-- VENTANA DE CONFIRMACION                   -->
<!-- MISMO ESTILO DE USUARIOS Y PERMISOS       -->
<!-- ========================================= -->

<div id="modalConfirmacion"
     class="modal-fondo">

    <div class="modal-contenido">


        <div class="modal-icono">

            ?

        </div>


        <h2>

            Confirmar acción

        </h2>


        <p>

            ¿Quieres actualizar este lote?

        </p>


        <div class="modal-botones">


            <button type="button"
                    class="btn-modal-si"
                    onclick="actualizarLote()">

                Sí

            </button>


            <button type="button"
                    class="btn-modal-no"
                    onclick="cerrarConfirmacion()">

                No

            </button>


            <button type="button"
                    class="btn-modal-cancelar"
                    onclick="cancelarEdicion()">

                Cancelar

            </button>


        </div>


    </div>

</div>



<style>

    /* ========================================= */
    /* MENSAJES                                  */
    /* ========================================= */

    .espacio-mensaje {
        min-height: 48px;

        margin-bottom: 8px;
    }


    .mensaje {
        width: 100%;

        padding: 12px 15px;

        box-sizing: border-box;

        border-radius: 7px;

        text-align: center;

        font-weight: 600;

        opacity: 1;

        transition: opacity 0.5s ease;
    }


    .mensaje-exito {
        background-color: #d1e7dd;

        color: #0f5132;

        border: 1px solid #badbcc;
    }


    .mensaje-error {
        background-color: #f8d7da;

        color: #842029;

        border: 1px solid #f5c2c7;
    }


    .mensaje-oculto {
        visibility: hidden;
    }



    /* ========================================= */
    /* BOTONES DE NAVEGACION                     */
    /* ========================================= */

    .contenedor-volver {
        display: flex;

        justify-content: center;

        gap: 15px;

        flex-wrap: wrap;

        margin-top: 30px;

        margin-bottom: 30px;
    }


    .btn-volver-listado {
        display: inline-block;

        padding: 12px 22px;

        background-color: #59636b;

        color: white;

        border-radius: 7px;

        text-decoration: none;

        font-weight: 600;
    }


    .btn-volver-listado:hover {
        background-color: #474f55;

        color: white;
    }


    .btn-volver-productos {
        display: inline-block;

        padding: 12px 22px;

        background-color: #1198a5;

        color: white;

        border-radius: 7px;

        text-decoration: none;

        font-weight: 600;
    }


    .btn-volver-productos:hover {
        background-color: #0d8490;

        color: white;
    }



    /* ========================================= */
    /* VENTANA DE CONFIRMACION                   */
    /* ========================================= */

    .modal-fondo {
        display: none;

        position: fixed;

        top: 0;

        left: 0;

        width: 100%;

        height: 100%;

        background-color: rgba(0, 0, 0, 0.45);

        align-items: center;

        justify-content: center;

        z-index: 9999;
    }


    .modal-contenido {
        width: 90%;

        max-width: 430px;

        background-color: white;

        border-radius: 15px;

        padding: 30px;

        text-align: center;

        box-shadow:
            0 12px 35px
            rgba(0, 0, 0, 0.25);
    }


    .modal-icono {
        width: 55px;

        height: 55px;

        margin: 0 auto 15px auto;

        display: flex;

        align-items: center;

        justify-content: center;

        background-color: #1198a5;

        color: white;

        border-radius: 50%;

        font-size: 30px;

        font-weight: bold;
    }


    .modal-contenido h2 {
        width: auto;

        max-width: none;

        margin: 0;

        padding: 0;

        background: none;

        border-radius: 0;

        box-shadow: none;

        color: #003b64;

        font-size: 25px;
    }


    .modal-contenido h2::before,
    .modal-contenido h2::after {
        display: none;
    }


    .modal-contenido p {
        margin-top: 15px;

        margin-bottom: 25px;

        font-size: 17px;

        color: #444;
    }


    .modal-botones {
        display: flex;

        justify-content: center;

        gap: 10px;

        flex-wrap: wrap;
    }


    .modal-botones button {
        min-width: 90px;

        padding: 10px 18px;

        border: none;

        border-radius: 7px;

        color: white;

        font-weight: 600;

        cursor: pointer;
    }


    .btn-modal-si {
        background-color: #198754;
    }


    .btn-modal-si:hover {
        background-color: #157347;
    }


    .btn-modal-no {
        background-color: #c82333;
    }


    .btn-modal-no:hover {
        background-color: #a91d2a;
    }


    .btn-modal-cancelar {
        background-color: #59636b;
    }


    .btn-modal-cancelar:hover {
        background-color: #474f55;
    }



    /* ========================================= */
    /* CELULAR                                   */
    /* ========================================= */

    @@media (max-width: 600px) {

        .contenedor-volver {
            flex-direction: column;

            align-items: center;
        }


        .btn-volver-listado,
        .btn-volver-productos {
            width: 90%;

            box-sizing: border-box;

            text-align: center;
        }

    }

</style>



<script>

    let loteConfirmado = false;



    // =========================================
    // MOSTRAR ERROR
    // =========================================

    function mostrarError(
        texto,
        campo
    ) {

        const mensaje =
            document.getElementById(
                "mensajeFormulario"
            );


        mensaje.innerText =
            texto;


        mensaje.className =
            "mensaje mensaje-error";


        mensaje.style.visibility =
            "visible";


        mensaje.style.opacity =
            "1";


        campo.focus();
    }



    // =========================================
    // VALIDAR Y CONFIRMAR
    // =========================================

    function validarYConfirmar() {

        if (loteConfirmado) {

            return true;
        }


        const producto =
            document.getElementById(
                "producto"
            );


        const numeroLote =
            document.getElementById(
                "numeroLote"
            );


        const fechaVencimiento =
            document.getElementById(
                "fechaVencimiento"
            );


        const cantidadActual =
            document.getElementById(
                "cantidadActual"
            );


        const ubicacion =
            document.getElementById(
                "ubicacion"
            );



        // =====================================
        // PRODUCTO
        // =====================================

        if (
            producto.value === ""
            ||
            Number(producto.value) <= 0
        ) {

            mostrarError(
                "Debe seleccionar un producto.",
                producto
            );

            return false;
        }



        // =====================================
        // NUMERO DE LOTE
        // =====================================

        if (
            numeroLote.value.trim()
            === ""
        ) {

            mostrarError(
                "Debe ingresar el número de lote.",
                numeroLote
            );

            return false;
        }



        // =====================================
        // FECHA DE VENCIMIENTO
        // =====================================

        if (
            fechaVencimiento.value
            === ""
        ) {

            mostrarError(
                "Debe ingresar la fecha de vencimiento.",
                fechaVencimiento
            );

            return false;
        }



        // =====================================
        // CANTIDAD ACTUAL
        // =====================================

        if (
            cantidadActual.value.trim()
            === ""
            ||
            Number(cantidadActual.value) < 0
        ) {

            mostrarError(
                "Debe ingresar una cantidad actual válida.",
                cantidadActual
            );

            return false;
        }



        // =====================================
        // UBICACION
        // =====================================

        if (
            ubicacion.value === ""
            ||
            Number(ubicacion.value) <= 0
        ) {

            mostrarError(
                "Debe seleccionar una ubicación.",
                ubicacion
            );

            return false;
        }



        // =====================================
        // MOSTRAR CONFIRMACION
        // =====================================

        document.getElementById(
            "modalConfirmacion"
        ).style.display =
            "flex";


        return false;
    }



    // =========================================
    // BOTON SI
    // =========================================

    function actualizarLote() {

        loteConfirmado =
            true;


        document.getElementById(
            "modalConfirmacion"
        ).style.display =
            "none";


        document.getElementById(
            "formEditarLote"
        ).requestSubmit();
    }



    // =========================================
    // BOTON NO
    // CONSERVA LOS CAMBIOS
    // =========================================

    function cerrarConfirmacion() {

        loteConfirmado =
            false;


        document.getElementById(
            "modalConfirmacion"
        ).style.display =
            "none";
    }



    // =========================================
    // BOTON CANCELAR
    // RESTAURA LOS DATOS ORIGINALES
    // =========================================

    function cancelarEdicion() {

        loteConfirmado =
            false;


        document.getElementById(
            "modalConfirmacion"
        ).style.display =
            "none";


        document.getElementById(
            "formEditarLote"
        ).reset();


        const mensaje =
            document.getElementById(
                "mensajeFormulario"
            );


        mensaje.innerText =
            "";


        mensaje.className =
            "mensaje mensaje-error mensaje-oculto";


        mensaje.style.visibility =
            "hidden";


        mensaje.style.opacity =
            "1";


        document.getElementById(
            "numeroLote"
        ).focus();
    }



    // =========================================
    // OCULTAR MENSAJE
    // =========================================

    setTimeout(
        function () {

            const mensaje =
                document.getElementById(
                    "mensajeFormulario"
                );


            if (
                mensaje &&
                !mensaje.classList.contains(
                    "mensaje-oculto"
                )
            ) {

                mensaje.style.opacity =
                    "0";


                setTimeout(
                    function () {

                        mensaje.style.visibility =
                            "hidden";

                    },
                    500
                );
            }

        },
        3000
    );

</script>