@model LoginSARMedix.Models.Rol

@{
    Layout = null;

    string nombreCompleto =
        ViewBag.Nombre + " " + ViewBag.Apellido;

    string inicial =
        !string.IsNullOrEmpty(ViewBag.Nombre?.ToString())
        ? ViewBag.Nombre.ToString().Substring(0, 1).ToUpper()
        : "U";
}

<!DOCTYPE html>

<html lang="es">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>Crear Rol - SARMedix</title>


    <style>

        * {
            box-sizing: border-box;
        }


        body {
            margin: 0;

            font-family: "Segoe UI", Arial, sans-serif;

            color: #17324d;

            background:
                linear-gradient(
                    rgba(235, 247, 252, 0.82),
                    rgba(235, 247, 252, 0.82)
                ),
                url('/images/fondo-clinico.png');

            background-size: cover;

            background-position: center;

            background-attachment: fixed;

            min-height: 100vh;

            display: flex;

            flex-direction: column;
        }



        /* ================================= */
        /* BARRA SUPERIOR                    */
        /* ================================= */

        .barra-superior {
            height: 82px;

            display: grid;

            grid-template-columns: 1fr 1fr 1fr;

            align-items: center;

            padding: 0 60px;

            background: #0f5278;

            color: white;

            box-shadow:
                0 3px 10px
                rgba(0, 0, 0, 0.15);
        }



        /* ================================= */
        /* LOGO                              */
        /* ================================= */

        .logo {
            display: flex;

            align-items: center;

            gap: 14px;
        }


        .logo-cruz-medica {
            width: 48px;
            height: 48px;

            background: white;

            border-radius: 12px;

            display: flex;

            align-items: center;

            justify-content: center;

            box-shadow:
                0 4px 10px
                rgba(0, 0, 0, 0.15);
        }


        .cruz {
            position: relative;

            width: 22px;
            height: 22px;

            display: block;
        }


        .cruz::before,
        .cruz::after {
            content: "";

            position: absolute;

            background: #0b6fb8;

            border-radius: 3px;
        }


        .cruz::before {
            width: 8px;
            height: 22px;

            left: 7px;
            top: 0;
        }


        .cruz::after {
            width: 22px;
            height: 8px;

            left: 0;
            top: 7px;
        }


        .logo-texto {
            font-size: 25px;

            font-weight: 700;

            color: white;

            letter-spacing: 0.3px;

            white-space: nowrap;
        }



        /* ================================= */
        /* TITULO SUPERIOR                   */
        /* ================================= */

        .titulo-superior {
            text-align: center;

            font-size: 25px;

            font-weight: 600;
        }



        /* ================================= */
        /* USUARIO                           */
        /* ================================= */

        .usuario-superior {
            display: flex;

            justify-content: flex-end;

            align-items: center;

            gap: 16px;
        }


        .usuario-datos {
            text-align: right;
        }


        .usuario-nombre {
            display: block;

            font-size: 16px;

            font-weight: 600;
        }


        .usuario-rol {
            display: block;

            margin-top: 2px;

            font-size: 13px;

            opacity: 0.85;
        }


        .usuario-circulo {
            width: 48px;
            height: 48px;

            display: flex;

            align-items: center;

            justify-content: center;

            border-radius: 50%;

            background:
                rgba(255, 255, 255, 0.22);

            font-size: 20px;

            font-weight: 600;
        }



        /* ================================= */
        /* CONTENIDO                         */
        /* ================================= */

        .contenedor {
            width: 90%;

            max-width: 650px;

            margin: 50px auto;

            flex: 1;
        }


        .titulo {
            text-align: center;

            color: #087bc2;

            font-size: 32px;

            margin-bottom: 8px;
        }


        .descripcion {
            text-align: center;

            color: #687b89;

            margin-bottom: 30px;

            font-size: 16px;
        }



        /* ================================= */
        /* TARJETA                           */
        /* ================================= */

        .tarjeta {
            background:
                rgba(255, 255, 255, 0.96);

            padding: 35px;

            border-radius: 14px;

            box-shadow:
                0 7px 20px
                rgba(28, 65, 95, 0.15);
        }



        /* ================================= */
        /* MENSAJE                           */
        /* ================================= */

        .espacio-mensaje {
            min-height: 58px;

            margin-bottom: 15px;
        }


        .mensaje-error {
            padding: 14px 18px;

            display: flex;

            align-items: center;

            gap: 12px;

            background: #fdecec;

            border: 1px solid #e5aaaa;

            color: #a12828;

            border-radius: 9px;

            font-size: 15px;

            font-weight: 600;

            opacity: 1;
        }


        .mensaje-oculto {
            visibility: hidden;
        }


        .mensaje-icono {
            width: 28px;
            height: 28px;

            min-width: 28px;

            display: flex;

            align-items: center;

            justify-content: center;

            border-radius: 50%;

            background: #a12828;

            color: white;

            font-weight: bold;
        }



        /* ================================= */
        /* FORMULARIO                        */
        /* ================================= */

        .grupo {
            margin-bottom: 22px;
        }


        .grupo label {
            display: block;

            margin-bottom: 8px;

            font-weight: 600;

            color: #17324d;
        }


        .grupo input,
        .grupo textarea {
            width: 100%;

            padding: 12px;

            border: 1px solid #b9cbd7;

            border-radius: 7px;

            font-family: inherit;

            font-size: 15px;

            color: #17324d;

            background: white;
        }


        .grupo input:focus,
        .grupo textarea:focus {
            outline: none;

            border-color: #087bc2;

            box-shadow:
                0 0 0 3px
                rgba(8, 123, 194, 0.10);
        }


        .grupo textarea {
            min-height: 120px;

            resize: vertical;
        }



        /* ================================= */
        /* BOTON CREAR                       */
        /* ================================= */

        .btn-guardar {
            width: 100%;

            padding: 13px;

            background: #0b8f9c;

            color: white;

            border: none;

            border-radius: 7px;

            font-size: 15px;

            font-weight: 600;

            cursor: pointer;

            transition:
                background 0.2s ease,
                transform 0.2s ease;
        }


        .btn-guardar:hover {
            background: #087580;

            transform: translateY(-2px);
        }



        /* ================================= */
        /* VOLVER                            */
        /* ================================= */

        .volver {
            margin-top: 30px;

            text-align: center;
        }


        .btn-volver {
            display: inline-block;

            padding: 11px 20px;

            background: #0b8f9c;

            color: white;

            text-decoration: none;

            border-radius: 7px;

            font-weight: 600;
        }


        .btn-volver:hover {
            background: #087580;

            color: white;
        }



        /* ================================= */
        /* VENTANA DE CONFIRMACION           */
        /* ================================= */

        .modal-fondo {
            display: none;

            position: fixed;

            top: 0;
            left: 0;

            width: 100%;
            height: 100%;

            background:
                rgba(0, 0, 0, 0.45);

            align-items: center;

            justify-content: center;

            z-index: 9999;
        }


        .modal-contenido {
            width: 90%;

            max-width: 430px;

            background: white;

            border-radius: 15px;

            padding: 30px;

            text-align: center;

            box-shadow:
                0 12px 35px
                rgba(0, 0, 0, 0.25);
        }


        .modal-icono {
            width: 55px;
            height: 55px;

            margin:
                0 auto 15px auto;

            display: flex;

            align-items: center;

            justify-content: center;

            background: #1198a5;

            color: white;

            border-radius: 50%;

            font-size: 30px;

            font-weight: bold;
        }


        .modal-contenido h2 {
            margin-top: 0;

            color: #003b64;
        }


        .modal-contenido p {
            margin-top: 15px;

            margin-bottom: 25px;

            font-size: 17px;

            color: #444;
        }


        .modal-botones {
            display: flex;

            justify-content: center;

            gap: 10px;

            flex-wrap: wrap;
        }


        .modal-botones button {
            min-width: 90px;

            padding: 10px 18px;

            border: none;

            border-radius: 7px;

            color: white;

            font-weight: 600;

            cursor: pointer;
        }


        .btn-modal-si {
            background: #198754;
        }


        .btn-modal-si:hover {
            background: #157347;
        }


        .btn-modal-no {
            background: #c82333;
        }


        .btn-modal-no:hover {
            background: #a91d2a;
        }


        .btn-modal-cancelar {
            background: #59636b;
        }


        .btn-modal-cancelar:hover {
            background: #474f55;
        }



        /* ================================= */
        /* FOOTER                            */
        /* ================================= */

        .footer {
            margin-top: auto;

            padding: 18px;

            background:
                rgba(255, 255, 255, 0.90);

            text-align: center;

            color: #668092;

            font-size: 13px;
        }



        /* ================================= */
        /* RESPONSIVE                        */
        /* ================================= */

        @@media (max-width: 900px) {

            .barra-superior {
                grid-template-columns: 1fr 1fr;

                height: auto;

                min-height: 82px;

                padding: 15px 25px;
            }


            .titulo-superior {
                display: none;
            }


            .logo-texto {
                font-size: 20px;
            }


            .contenedor {
                width: 94%;

                margin-top: 30px;
            }
        }


        @@media (max-width: 600px) {

            .barra-superior {
                padding: 12px 15px;
            }


            .logo-cruz-medica {
                width: 42px;

                height: 42px;
            }


            .logo-texto {
                font-size: 17px;
            }


            .usuario-nombre {
                font-size: 14px;
            }


            .usuario-rol {
                font-size: 11px;
            }


            .usuario-circulo {
                width: 42px;

                height: 42px;
            }


            .tarjeta {
                padding: 24px;
            }
        }

    </style>

</head>


<body>


    <!-- ================================= -->
    <!-- BARRA SUPERIOR                    -->
    <!-- ================================= -->

    <header class="barra-superior">


        <div class="logo">


            <div class="logo-cruz-medica">

                <span class="cruz"></span>

            </div>


            <div class="logo-texto">

                SARMedix | SAR de Chiguay

            </div>


        </div>



        <div class="titulo-superior">

            Crear Rol

        </div>



        <div class="usuario-superior">


            <div class="usuario-datos">


                <span class="usuario-nombre">

                    @nombreCompleto

                </span>


                <span class="usuario-rol">

                    @ViewBag.Rol

                </span>


            </div>


            <div class="usuario-circulo">

                @inicial

            </div>


        </div>


    </header>



    <!-- ================================= -->
    <!-- CONTENIDO                         -->
    <!-- ================================= -->

    <main class="contenedor">


        <h1 class="titulo">

            Crear Nuevo Rol

        </h1>


        <p class="descripcion">

            Ingrese los datos del nuevo rol para registrarlo en SARMedix.

        </p>



        <div class="tarjeta">


            <!-- ================================= -->
            <!-- ESPACIO PARA MENSAJES             -->
            <!-- ================================= -->

            <div class="espacio-mensaje">


                @if (ViewBag.Mensaje != null)
                {
                    <div class="mensaje-error"
                         id="mensajeRol">

                        <span class="mensaje-icono">

                            !

                        </span>


                        <span id="textoMensajeRol">

                            @ViewBag.Mensaje

                        </span>

                    </div>
                }
                else
                {
                    <div class="mensaje-error mensaje-oculto"
                         id="mensajeRol">

                        <span class="mensaje-icono">

                            !

                        </span>


                        <span id="textoMensajeRol">

                        </span>

                    </div>
                }


            </div>



            <!-- ================================= -->
            <!-- FORMULARIO                        -->
            <!-- ================================= -->

            <form asp-controller="Home"
                  asp-action="NuevoRol"
                  method="post"
                  id="formCrearRol"
                  onsubmit="return validarYConfirmarRol()"
                  novalidate>


                <div class="grupo">


                    <label asp-for="nombre">

                        Nombre del rol

                    </label>


                    <input asp-for="nombre"
                           id="nombreRol"
                           placeholder="Ej: Encargado de Farmacia" />


                </div>



                <div class="grupo">


                    <label asp-for="descripcion">

                        Descripción

                    </label>


                    <textarea asp-for="descripcion"
                              id="descripcionRol"
                              placeholder="Ingrese una descripción de las funciones del rol"></textarea>


                </div>



                <button type="submit"
                        class="btn-guardar">

                    Crear rol

                </button>


            </form>


        </div>



        <!-- ================================= -->
        <!-- VOLVER                            -->
        <!-- ================================= -->

        <div class="volver">


            <a asp-controller="Home"
               asp-action="RolesPermisos"
               class="btn-volver">

                ← Volver a Roles y Permisos

            </a>


        </div>


    </main>



    <!-- ================================= -->
    <!-- VENTANA DE CONFIRMACION           -->
    <!-- ================================= -->

    <div id="modalConfirmacion"
         class="modal-fondo">


        <div class="modal-contenido">


            <div class="modal-icono">

                ?

            </div>


            <h2>

                Confirmar acción

            </h2>


            <p>

                ¿Quieres crear este rol?

            </p>


            <div class="modal-botones">


                <button type="button"
                        class="btn-modal-si"
                        onclick="crearRol()">

                    Sí

                </button>


                <button type="button"
                        class="btn-modal-no"
                        onclick="cerrarConfirmacionRol()">

                    No

                </button>


                <button type="button"
                        class="btn-modal-cancelar"
                        onclick="cancelarCreacionRol()">

                    Cancelar

                </button>


            </div>


        </div>


    </div>



    <!-- ================================= -->
    <!-- FOOTER                            -->
    <!-- ================================= -->

    <footer class="footer">

        SARMedix · Sistema de Gestión Farmacéutica · SAR de Chiguay

    </footer>



    <script>

        let rolConfirmado = false;



        // =================================
        // MOSTRAR MENSAJE DE ERROR
        // =================================

        function mostrarErrorRol(texto, campo) {

            const mensaje =
                document.getElementById(
                    "mensajeRol"
                );


            const textoMensaje =
                document.getElementById(
                    "textoMensajeRol"
                );


            textoMensaje.innerText =
                texto;


            mensaje.className =
                "mensaje-error";


            mensaje.style.visibility =
                "visible";


            mensaje.style.opacity =
                "1";


            campo.focus();
        }



        // =================================
        // VALIDAR CAMPOS
        // =================================

        function validarYConfirmarRol() {

            if (rolConfirmado) {

                return true;
            }



            const nombre =
                document.getElementById(
                    "nombreRol"
                );


            const descripcion =
                document.getElementById(
                    "descripcionRol"
                );



            if (nombre.value.trim() === "") {

                mostrarErrorRol(
                    "Debe ingresar el nombre del rol.",
                    nombre
                );


                return false;
            }



            if (descripcion.value.trim() === "") {

                mostrarErrorRol(
                    "Debe ingresar una descripción.",
                    descripcion
                );


                return false;
            }



            document.getElementById(
                "modalConfirmacion"
            ).style.display = "flex";


            return false;
        }



        // =================================
        // BOTON SI
        // =================================

        function crearRol() {

            rolConfirmado = true;


            document.getElementById(
                "modalConfirmacion"
            ).style.display = "none";


            document.getElementById(
                "formCrearRol"
            ).requestSubmit();
        }



        // =================================
        // BOTON NO
        // =================================

        function cerrarConfirmacionRol() {

            rolConfirmado = false;


            document.getElementById(
                "modalConfirmacion"
            ).style.display = "none";
        }



        // =================================
        // BOTON CANCELAR
        // =================================

        function cancelarCreacionRol() {

            rolConfirmado = false;


            document.getElementById(
                "modalConfirmacion"
            ).style.display = "none";


            document.getElementById(
                "nombreRol"
            ).value = "";


            document.getElementById(
                "descripcionRol"
            ).value = "";


            const mensaje =
                document.getElementById(
                    "mensajeRol"
                );


            const textoMensaje =
                document.getElementById(
                    "textoMensajeRol"
                );


            textoMensaje.innerText = "";


            mensaje.className =
                "mensaje-error mensaje-oculto";


            mensaje.style.visibility =
                "hidden";


            mensaje.style.opacity =
                "1";


            document.getElementById(
                "nombreRol"
            ).focus();
        }

    </script>


</body>

</html>