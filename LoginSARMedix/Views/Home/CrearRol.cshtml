@model LoginSARMedix.Models.Rol

@{
    ViewData["Title"] = "Crear Rol";
    ViewData["TituloBarra"] = "Crear Rol";
}


<section class="contenedor-crear-rol">

    <h1 class="titulo-crear-rol">
        Crear Nuevo Rol
    </h1>

    <p class="descripcion-crear-rol">
        Ingrese los datos del nuevo rol para registrarlo en SARMedix.
    </p>


    <div class="tarjeta-crear-rol">

        <!-- ================================= -->
        <!-- MENSAJE                           -->
        <!-- ================================= -->

        <div class="espacio-mensaje">

            @if (ViewBag.Mensaje != null)
            {
                <div class="mensaje-error"
                     id="mensajeRol">

                    <span class="mensaje-icono">
                        !
                    </span>

                    <span id="textoMensajeRol">
                        @ViewBag.Mensaje
                    </span>

                </div>
            }
            else
            {
                <div class="mensaje-error mensaje-oculto"
                     id="mensajeRol">

                    <span class="mensaje-icono">
                        !
                    </span>

                    <span id="textoMensajeRol">
                    </span>

                </div>
            }

        </div>


        <!-- ================================= -->
        <!-- FORMULARIO                        -->
        <!-- ================================= -->

        <form asp-controller="Home"
              asp-action="NuevoRol"
              method="post"
              id="formCrearRol"
              onsubmit="return validarYConfirmarRol()"
              novalidate>

            <div class="grupo-rol">

                <label asp-for="nombre">
                    Nombre del rol
                </label>

                <input asp-for="nombre"
                       id="nombreRol"
                       placeholder="Ej: Encargado de Farmacia" />

            </div>


            <div class="grupo-rol">

                <label asp-for="descripcion">
                    Descripción
                </label>

                <textarea asp-for="descripcion"
                          id="descripcionRol"
                          placeholder="Ingrese una descripción de las funciones del rol"></textarea>

            </div>


            <button type="submit"
                    class="btn-guardar-rol">

                Crear rol

            </button>

        </form>

    </div>


    <!-- ================================= -->
    <!-- VOLVER                            -->
    <!-- ================================= -->

    <div class="volver-rol">

        <a asp-controller="Home"
           asp-action="RolesPermisos"
           class="btn-volver-rol">

            ← Volver a Roles y Permisos

        </a>

    </div>

</section>



<!-- ================================= -->
<!-- CONFIRMACION                      -->
<!-- ================================= -->

<div id="modalConfirmacion"
     class="modal-fondo">

    <div class="modal-contenido">

        <div class="modal-icono">
            ?
        </div>

        <div class="modal-titulo">
            Confirmar acción
        </div>

        <p>
            ¿Quieres crear este rol?
        </p>

        <div class="modal-botones">

            <button type="button"
                    class="btn-modal-si"
                    onclick="crearRol()">

                Sí

            </button>

            <button type="button"
                    class="btn-modal-no"
                    onclick="cerrarConfirmacionRol()">

                No

            </button>

            <button type="button"
                    class="btn-modal-cancelar"
                    onclick="cancelarCreacionRol()">

                Cancelar

            </button>

        </div>

    </div>

</div>



<style>

    /* ================================= */
    /* CONTENIDO                         */
    /* ================================= */

    .contenedor-crear-rol {
        width: 90%;
        max-width: 650px;
        margin: 5px auto;
    }


    .titulo-crear-rol {
        margin-bottom: 8px;
        text-align: center;
        color: #087bc2;
        font-size: 32px;
        font-weight: 700;
    }


    .descripcion-crear-rol {
        margin-bottom: 30px;
        text-align: center;
        color: #687b89;
        font-size: 16px;
    }



    /* ================================= */
    /* TARJETA                           */
    /* ================================= */

    .tarjeta-crear-rol {
        padding: 35px;
        background: rgba(255, 255, 255, 0.96);
        border-radius: 14px;
        box-shadow: 0 7px 20px rgba(28, 65, 95, 0.15);
    }



    /* ================================= */
    /* FORMULARIO                        */
    /* ================================= */

    #formCrearRol {
        width: 100%;
        max-width: none;
        margin: 0;
        padding: 0;
        background: transparent;
        box-shadow: none;
    }


    .grupo-rol {
        margin-bottom: 22px;
    }


    .grupo-rol label {
        display: block;
        margin-bottom: 8px;
        color: #17324d;
        font-weight: 600;
    }


    .grupo-rol input,
    .grupo-rol textarea {
        width: 100%;
        padding: 12px;
        border: 1px solid #b9cbd7;
        border-radius: 7px;
        background: white;
        color: #17324d;
        font-family: inherit;
        font-size: 15px;
    }


    .grupo-rol input:focus,
    .grupo-rol textarea:focus {
        outline: none;
        border-color: #087bc2;
        box-shadow: 0 0 0 3px rgba(8, 123, 194, 0.10);
    }


    .grupo-rol textarea {
        min-height: 120px;
        resize: vertical;
    }



    /* ================================= */
    /* MENSAJE                           */
    /* ================================= */

    .espacio-mensaje {
        min-height: 58px;
        margin-bottom: 15px;
    }


    .mensaje-error {
        padding: 14px 18px;
        display: flex;
        align-items: center;
        gap: 12px;
        background: #fdecec;
        border: 1px solid #e5aaaa;
        color: #a12828;
        border-radius: 9px;
        font-size: 15px;
        font-weight: 600;
        opacity: 1;
    }


    .mensaje-oculto {
        visibility: hidden;
    }


    .mensaje-icono {
        width: 28px;
        height: 28px;
        min-width: 28px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background: #a12828;
        color: white;
        font-weight: bold;
    }



    /* ================================= */
    /* BOTON CREAR                       */
    /* ================================= */

    .btn-guardar-rol {
        width: 100%;
        padding: 13px;
        background: #0b8f9c;
        color: white;
        border: none;
        border-radius: 7px;
        font-size: 15px;
        font-weight: 600;
        cursor: pointer;
        transition:
            background 0.2s ease,
            transform 0.2s ease;
    }


    .btn-guardar-rol:hover {
        background: #087580;
        transform: translateY(-2px);
    }



    /* ================================= */
    /* VOLVER                            */
    /* ================================= */

    .volver-rol {
        margin-top: 30px;
        text-align: center;
    }


    .btn-volver-rol {
        display: inline-block;
        padding: 11px 20px;
        background: #0b8f9c;
        color: white;
        text-decoration: none;
        border-radius: 7px;
        font-weight: 600;
    }


    .btn-volver-rol:hover {
        background: #087580;
        color: white;
    }



    /* ================================= */
    /* MODAL                             */
    /* ================================= */

    .modal-fondo {
        display: none;
        position: fixed;
        inset: 0;
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.45);
        align-items: center;
        justify-content: center;
        z-index: 99999;
    }


    .modal-contenido {
        width: 90%;
        max-width: 430px;
        padding: 30px;
        background: white;
        border-radius: 15px;
        text-align: center;
        box-shadow: 0 12px 35px rgba(0, 0, 0, 0.25);
    }


    .modal-icono {
        width: 55px;
        height: 55px;
        margin: 0 auto 15px auto;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #1198a5;
        color: white;
        border-radius: 50%;
        font-size: 30px;
        font-weight: bold;
    }


    .modal-titulo {
        margin: 0;
        color: #003b64;
        font-size: 25px;
        font-weight: 700;
    }


    .modal-contenido p {
        margin-top: 15px;
        margin-bottom: 25px;
        color: #444;
        font-size: 17px;
    }


    .modal-botones {
        display: flex;
        justify-content: center;
        gap: 10px;
        flex-wrap: wrap;
    }


    .modal-botones button {
        width: auto !important;
        min-width: 90px;
        margin: 0 !important;
        padding: 10px 18px !important;
        border: none !important;
        border-radius: 7px !important;
        color: white !important;
        font-weight: 600;
        cursor: pointer;
    }


    .btn-modal-si {
        background: #198754 !important;
    }


    .btn-modal-si:hover {
        background: #157347 !important;
    }


    .btn-modal-no {
        background: #c82333 !important;
    }


    .btn-modal-no:hover {
        background: #a91d2a !important;
    }


    .btn-modal-cancelar {
        background: #59636b !important;
    }


    .btn-modal-cancelar:hover {
        background: #474f55 !important;
    }



    /* ================================= */
    /* RESPONSIVE                        */
    /* ================================= */

    @@media (max-width: 600px) {

        .contenedor-crear-rol {
            width: 94%;
        }

        .tarjeta-crear-rol {
            padding: 24px;
        }

        .modal-botones {
            flex-direction: column;
        }

        .modal-botones button {
            width: 100% !important;
        }
    }

</style>



<script>

    let rolConfirmado = false;


    // =================================
    // MOSTRAR ERROR
    // =================================

    function mostrarErrorRol(texto, campo) {

        const mensaje =
            document.getElementById("mensajeRol");

        const textoMensaje =
            document.getElementById("textoMensajeRol");


        textoMensaje.innerText = texto;

        mensaje.className =
            "mensaje-error";

        mensaje.style.visibility =
            "visible";

        mensaje.style.opacity =
            "1";

        campo.focus();
    }



    // =================================
    // VALIDAR CAMPOS
    // =================================

    function validarYConfirmarRol() {

        if (rolConfirmado) {
            return true;
        }


        const nombre =
            document.getElementById("nombreRol");

        const descripcion =
            document.getElementById("descripcionRol");


        if (nombre.value.trim() === "") {

            mostrarErrorRol(
                "Debe ingresar el nombre del rol.",
                nombre
            );

            return false;
        }


        if (descripcion.value.trim() === "") {

            mostrarErrorRol(
                "Debe ingresar una descripción.",
                descripcion
            );

            return false;
        }


        document.getElementById(
            "modalConfirmacion"
        ).style.display = "flex";


        return false;
    }



    // =================================
    // BOTON SI
    // =================================

    function crearRol() {

        rolConfirmado = true;

        document.getElementById(
            "modalConfirmacion"
        ).style.display = "none";


        document.getElementById(
            "formCrearRol"
        ).requestSubmit();
    }



    // =================================
    // BOTON NO
    // =================================

    function cerrarConfirmacionRol() {

        rolConfirmado = false;

        document.getElementById(
            "modalConfirmacion"
        ).style.display = "none";
    }



    // =================================
    // BOTON CANCELAR
    // =================================

    function cancelarCreacionRol() {

        rolConfirmado = false;


        document.getElementById(
            "modalConfirmacion"
        ).style.display = "none";


        document.getElementById(
            "nombreRol"
        ).value = "";


        document.getElementById(
            "descripcionRol"
        ).value = "";


        const mensaje =
            document.getElementById(
                "mensajeRol"
            );


        const textoMensaje =
            document.getElementById(
                "textoMensajeRol"
            );


        textoMensaje.innerText = "";


        mensaje.className =
            "mensaje-error mensaje-oculto";


        mensaje.style.visibility =
            "hidden";


        mensaje.style.opacity =
            "1";


        document.getElementById(
            "nombreRol"
        ).focus();
    }

</script>