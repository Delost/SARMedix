    // =========================================
    // BUSCAR PRODUCTO ESCANEADO
    // =========================================

    async function buscarProductoEscaneado() {

        const inputCodigo =
            document.getElementById(
                "codigoScanner"
            );


        const resultado =
            document.getElementById(
                "resultadoScanner"
            );


        const producto =
            document.getElementById(
                "producto"
            );


        const numeroLote =
            document.getElementById(
                "numeroLote"
            );


        const fechaVencimiento =
            document.getElementById(
                "fechaVencimiento"
            );


        const cantidad =
            document.getElementById(
                "cantidadEnvases"
            );


        const codigo =
            inputCodigo.value.trim();


        if (codigo === "") {

            resultado.className =
                "resultado-scanner resultado-error";


            resultado.innerHTML =
                "<strong>Debe escanear o ingresar un código.</strong>";


            inputCodigo.focus();

            return;
        }


        const analisis =
            analizarCodigoEscaneado(
                codigo
            );


        const fechaEscaneadaVencida =
            analisis.fechaVencimiento !== ""
            &&
            esFechaVencida(
                analisis.fechaVencimiento
            );


        if (analisis.esGS1) {

            if (analisis.lote !== "") {

                numeroLote.value =
                    analisis.lote;


                marcarLoteDetectado(
                    analisis.lote
                );
            }


            if (
                analisis.fechaVencimiento
                !== ""
            ) {

                fechaVencimiento.value =
                    analisis.fechaVencimiento;


                marcarFechaDetectada(
                    analisis.fechaVencimiento
                );
            }
        }


        validarEstadoVencimiento();


        resultado.className =
            "resultado-scanner";


        resultado.style.display =
            "block";


        resultado.innerHTML =
            analisis.esGS1
                ?
                "Leyendo datos GS1 y buscando producto..."
                :
                "Buscando producto...";


        try {

            const url =
                '@Url.Action(
                                        "BuscarProductoPorCodigoBarras",
                                        "Home"
                                )'
                +
                "?codigo="
                +
                encodeURIComponent(
                    analisis.codigoBusqueda
                );


            const respuesta =
                await fetch(
                    url
                );


            if (!respuesta.ok) {

                resultado.className =
                    "resultado-scanner resultado-error";


                resultado.innerHTML =
                    "<strong>No fue posible consultar el producto.</strong>";


                return;
            }


            const datos =
                await respuesta.json();



            // =====================================
            // PRODUCTO ENCONTRADO
            // =====================================

            if (
                datos.existe
                &&
                datos.producto
            ) {

                producto.value =
                    datos.producto.id_producto;


                if (producto.value === "") {

                    productoActual = {
                        id: "",
                        nombre: "",
                        codigo: "",
                        tipo: "",
                        contenidoPorEnvase: 1,
                        unidadMedida: "Unidades",
                        formaFarmaceutica: ""
                    };


                    resultado.className =
                        "resultado-scanner resultado-error";


                    resultado.innerHTML =
                        "<strong>El producto existe, pero no está disponible en el listado actual.</strong>";


                    ocultarProductoIdentificado();

                    return;
                }


                const opcionProducto =
                    producto.options[
                        producto.selectedIndex
                    ];

                productoActual = {
                    id:
                        datos.producto.id_producto,
                    nombre:
                        datos.producto.nombre
                        ??
                        "",
                    codigo:
                        datos.producto.codigo_interno
                        ??
                        "",
                    tipo:
                        datos.producto.tipo
                        ??
                        opcionProducto?.dataset.tipo
                        ??
                        "",
                    contenidoPorEnvase:
                        Number(opcionProducto?.dataset.contenido) > 0
                            ? Number(opcionProducto.dataset.contenido)
                            : 1,
                    unidadMedida:
                        opcionProducto?.dataset.unidad
                        ||
                        "Unidades",
                    formaFarmaceutica:
                        opcionProducto?.dataset.forma
                        ||
                        ""
                };


                mostrarProductoIdentificado(
                    productoActual.nombre,
                    productoActual.codigo,
                    productoActual.tipo
                );

                actualizarCalculoRecepcion();


                let detallesGS1 =
                    "";


                if (analisis.esGS1) {

                    detallesGS1 +=
                        `<br>GTIN: <strong>${escaparHtml(analisis.gtin)}</strong>`;


                    if (analisis.lote !== "") {

                        detallesGS1 +=
                            `<br>✅ Lote: ${escaparHtml(analisis.lote)}`;
                    }


                    if (
                        analisis.fechaVencimiento
                        !== ""
                    ) {

                        detallesGS1 +=
                            `<br>✅ Vencimiento: ${escaparHtml(formatearFechaPantalla(analisis.fechaVencimiento))}`;
                    }


                    if (analisis.serie !== "") {

                        detallesGS1 +=
                            `<br>Serie: ${escaparHtml(analisis.serie)}`;
                    }


                    if (
                        analisis.datosVariablesEstimados
                    ) {

                        detallesGS1 +=
                            "<br>⚠ El lector no entregó el separador GS/FNC1. Revise lote y serie.";
                    }


                    if (fechaEscaneadaVencida) {

                        detallesGS1 +=
                            `<br><strong>🚨 PRODUCTO VENCIDO: ${escaparHtml(formatearFechaPantalla(analisis.fechaVencimiento))}</strong>`;
                    }
                }


                resultado.className =
                    fechaEscaneadaVencida
                        ?
                        "resultado-scanner resultado-error"
                        :
                        "resultado-scanner resultado-encontrado";


                resultado.innerHTML =
                    `
                        <div class="producto-encontrado-titulo">
                            ${
                                fechaEscaneadaVencida
                                    ?
                                    "🚨 Producto encontrado - VENCIDO"
                                    :
                                    "✅ Lectura completada"
                            }
                        </div>

                        <div class="producto-encontrado-detalle">

                            <strong>
                                ${escaparHtml(productoActual.nombre)}
                            </strong>

                            <br>

                            Código:
                            ${escaparHtml(productoActual.codigo)}

                            ${
                                productoActual.tipo
                                    ?
                                    `<br>Tipo: ${escaparHtml(productoActual.tipo)}`
                                    :
                                    ""
                            }

                            ${detallesGS1}

                        </div>
                    `;


                actualizarResumen();


                setTimeout(
                    function () {

                        if (
                            numeroLote.value.trim()
                            === ""
                        ) {

                            numeroLote.focus();
                        }
                        else if (
                            fechaVencimiento.value
                            === ""
                        ) {

                            fechaVencimiento.focus();
                        }
                        else {

                            cantidad.focus();
                        }

                    },
                    150
                );


                return;
            }



            // =====================================
            // PRODUCTO NO ENCONTRADO
            // =====================================

            producto.value =
                "";


            productoActual = {
                id: "",
                nombre: "",
                codigo: "",
                tipo: "",
                contenidoPorEnvase: 1,
                unidadMedida: "Unidades",
                formaFarmaceutica: ""
            };


            ocultarProductoIdentificado();


            const urlCrearProducto =
                '@Url.Action(
                                        "CrearProducto",
                                        "Home"
                                )'
                +
                "?codigoBarras="
                +
                encodeURIComponent(
                    analisis.codigoBusqueda
                );


            let datosDetectados =
                "";


            if (analisis.esGS1) {

                datosDetectados +=
                    `<br>GTIN detectado: <strong>${escaparHtml(analisis.gtin)}</strong>`;


                if (analisis.lote !== "") {

                    datosDetectados +=
                        `<br>✅ Lote: ${escaparHtml(analisis.lote)}`;
                }


                if (
                    analisis.fechaVencimiento
                    !== ""
                ) {

                    datosDetectados +=
                        `<br>✅ Vencimiento: ${escaparHtml(formatearFechaPantalla(analisis.fechaVencimiento))}`;
                }


                if (analisis.serie !== "") {

                    datosDetectados +=
                        `<br>Serie: ${escaparHtml(analisis.serie)}`;
                }


                if (
                    analisis.datosVariablesEstimados
                ) {

                    datosDetectados +=
                        "<br>⚠ Revise lote y serie: el lector no entregó GS/FNC1.";
                }


                if (fechaEscaneadaVencida) {

                    datosDetectados +=
                        `<br><strong>🚨 VENCIDO: ${escaparHtml(formatearFechaPantalla(analisis.fechaVencimiento))}</strong>`;
                }
            }


            resultado.className =
                "resultado-scanner resultado-no-encontrado";


            resultado.innerHTML =
                `
                    <div class="producto-encontrado-titulo">
                        ⚠ Producto no registrado
                    </div>

                    <div class="producto-encontrado-detalle">

                        Código para búsqueda:
                        <strong>
                            ${escaparHtml(analisis.codigoBusqueda)}
                        </strong>

                        ${datosDetectados}

                    </div>

                    <a href="${urlCrearProducto}"
                       class="btn-registrar-producto">

                        Registrar nuevo producto

                    </a>
                `;


            actualizarResumen();
        }
        catch (error) {

            producto.value =
                "";


            productoActual = {
                id: "",
                nombre: "",
                codigo: "",
                tipo: "",
                contenidoPorEnvase: 1,
                unidadMedida: "Unidades",
                formaFarmaceutica: ""
            };


            ocultarProductoIdentificado();


            resultado.className =
                "resultado-scanner resultado-error";


            resultado.innerHTML =
                "<strong>Error al buscar el producto.</strong>";


            actualizarResumen();
        }
    }



    // =========================================
    // VENCIMIENTO
    // =========================================

    function validarEstadoVencimiento() {

        const fecha =
            document.getElementById(
                "fechaVencimiento"
            )
            .value;


        const aviso =
            document.getElementById(
                "avisoVencimiento"
            );


        if (!fecha) {

            aviso.className =
                "aviso-vencimiento aviso-vencimiento-oculto";


            aviso.textContent =
                "";


            return;
        }


        if (esFechaVencida(fecha)) {

            aviso.className =
                "aviso-vencimiento aviso-vencido";


            aviso.textContent =
                "🚨 Producto vencido. Esta entrada no puede registrarse.";
        }
        else {

            aviso.className =
                "aviso-vencimiento aviso-vigente";


            aviso.textContent =
                "✓ Fecha de vencimiento válida.";
        }
    }



    // =========================================
    // RESUMEN
    // =========================================

    function obtenerTextoUbicacion() {

        const ubicacion =
            document.getElementById(
                "ubicacion"
            );


        if (ubicacion.value === "") {
            return "—";
        }


        return ubicacion.options[
            ubicacion.selectedIndex
        ].textContent.trim();
    }



    function actualizarResumen() {

        const numeroLote =
            document.getElementById(
                "numeroLote"
            ).value.trim();


        const fecha =
            document.getElementById(
                "fechaVencimiento"
            ).value;


        const envases =
            document.getElementById(
                "cantidadEnvases"
            ).value;

        actualizarCalculoRecepcion();

        const cantidad =
            calcularStockEntrada();

        const unidad =
            unidadProducto();


        const ubicacion =
            document.getElementById(
                "ubicacion"
            ).value;


        document.getElementById(
            "resumenProducto"
        ).textContent =
            productoActual.nombre || "—";


        document.getElementById(
            "resumenLote"
        ).textContent =
            numeroLote || "—";


        document.getElementById(
            "resumenVencimiento"
        ).textContent =
            fecha
                ?
                formatearFechaPantalla(
                    fecha
                )
                :
                "—";


        document.getElementById(
            "resumenEnvases"
        ).textContent =
            envases
                && Number(envases) > 0
                ? `${envases} envase(s)`
                : "—";

        document.getElementById(
            "resumenCantidad"
        ).textContent =
            cantidad > 0
                ? `${cantidad} ${unidad}`
                : "—";


        document.getElementById(
            "resumenUbicacion"
        ).textContent =
            obtenerTextoUbicacion();


        const estado =
            document.getElementById(
                "resumenEstado"
            );


        const productoOk =
            productoActual.id !== "";


        const loteOk =
            numeroLote !== "";


        const fechaOk =
            fecha !== ""
            &&
            !esFechaVencida(
                fecha
            );


        const cantidadOk =
            envases !== ""
            && Number(envases) > 0
            && cantidad > 0;


        const ubicacionOk =
            ubicacion !== "";


        if (
            productoOk
            &&
            loteOk
            &&
            fechaOk
            &&
            cantidadOk
            &&
            ubicacionOk
        ) {

            estado.textContent =
                "✓ Todo listo. Puede registrar la entrada.";


            estado.className =
                "resumen-estado resumen-estado-listo";
        }
        else if (
            fecha !== ""
            &&
            esFechaVencida(
                fecha
            )
        ) {

            estado.textContent =
                "🚨 La fecha está vencida. Corríjala antes de continuar.";


            estado.className =
                "resumen-estado resumen-estado-error";
        }
        else {

            estado.textContent =
                "Complete los datos requeridos para registrar la entrada.";


            estado.className =
                "resumen-estado";
        }
    }



    // =========================================
    // MOSTRAR ERROR
    // =========================================

    function mostrarError(
        texto,
        campo
    ) {

        const mensaje =
            document.getElementById(
                "mensajeFormulario"
            );


        mensaje.innerText =
            texto;


        mensaje.className =
            "mensaje mensaje-error";


        mensaje.style.display =
            "block";


        mensaje.style.opacity =
            "1";


        if (campo) {

            campo.focus();
        }


        window.scrollTo({
            top: 0,
            behavior: "smooth"
        });
    }



    // =========================================
    // VALIDAR Y CONFIRMAR
    // =========================================

    function validarYConfirmar() {

        if (loteConfirmado) {
            return true;
        }


        const producto =
            document.getElementById(
                "producto"
            );


        const numeroLote =
            document.getElementById(
                "numeroLote"
            );


        const fechaVencimiento =
            document.getElementById(
                "fechaVencimiento"
            );


        const cantidad =
            document.getElementById(
                "cantidadEnvases"
            );


        const ubicacion =
            document.getElementById(
                "ubicacion"
            );


        if (
            producto.value === ""
            ||
            productoActual.id === ""
        ) {

            if (modoSeleccion === "scanner") {

                mostrarError(
                    "Debe escanear un producto válido.",
                    document.getElementById(
                        "codigoScanner"
                    )
                );
            }
            else {

                mostrarError(
                    "Debe seleccionar un producto.",
                    producto
                );
            }


            return false;
        }


        if (
            numeroLote.value.trim()
            === ""
        ) {

            mostrarError(
                "Debe ingresar el número de lote.",
                numeroLote
            );


            return false;
        }


        if (
            fechaVencimiento.value
            === ""
        ) {

            mostrarError(
                "Debe ingresar la fecha de vencimiento.",
                fechaVencimiento
            );


            return false;
        }


        if (
            esFechaVencida(
                fechaVencimiento.value
            )
        ) {

            mostrarError(
                "No se puede registrar la entrada: el producto está vencido.",
                fechaVencimiento
            );


            return false;
        }


        if (
            cantidad.value.trim()
            === ""
            ||
            Number(cantidad.value) <= 0
        ) {

            mostrarError(
                "Debe ingresar una cantidad de envases mayor a 0.",
                cantidad
            );


            return false;
        }


        if (
            ubicacion.value
            === ""
        ) {

            mostrarError(
                "Debe seleccionar una ubicación destino.",
                ubicacion
            );


            return false;
        }


        actualizarCalculoRecepcion();

        const totalStock =
            calcularStockEntrada();

        actualizarResumen();


        document.getElementById(
            "modalResumen"
        ).innerHTML =
            `
                <strong>Producto:</strong>
                ${escaparHtml(productoActual.nombre)}
                <br>

                <strong>Lote:</strong>
                ${escaparHtml(numeroLote.value.trim())}
                <br>

                <strong>Vencimiento:</strong>
                ${escaparHtml(formatearFechaPantalla(fechaVencimiento.value))}
                <br>

                <strong>Envases recibidos:</strong>
                ${escaparHtml(cantidad.value)} envase(s)
                <br>

                <strong>Stock a sumar:</strong>
                ${escaparHtml(totalStock)} ${escaparHtml(unidadProducto())}
                <br>

                <strong>Destino:</strong>
                ${escaparHtml(obtenerTextoUbicacion())}
            `;


        document.getElementById(
            "modalConfirmacion"
        ).style.display =
            "flex";


        return false;
    }



    // =========================================
    // CONFIRMAR
    // =========================================

    function registrarLote() {

        loteConfirmado =
            true;


        document.getElementById(
            "modalConfirmacion"
        ).style.display =
            "none";


        document.getElementById(
            "formCrearLote"
        ).requestSubmit();
    }



    // =========================================
    // VOLVER DESDE MODAL
    // =========================================

    function cerrarConfirmacion() {

        loteConfirmado =
            false;


        document.getElementById(
            "modalConfirmacion"
        ).style.display =
            "none";
    }



    // =========================================
    // LIMPIAR FORMULARIO
    // =========================================

    function cancelarRegistro() {

        loteConfirmado =
            false;


        document.getElementById(
            "modalConfirmacion"
        ).style.display =
            "none";


        document.getElementById(
            "producto"
        ).value =
            "";


        document.getElementById(
            "codigoScanner"
        ).value =
            "";


        document.getElementById(
            "numeroLote"
        ).value =
            "";


        document.getElementById(
            "fechaVencimiento"
        ).value =
            "";


        document.getElementById(
            "cantidadEnvases"
        ).value =
            "";

        document.getElementById(
            "cantidadTotalStock"
        ).value =
            "";


        document.getElementById(
            "ubicacion"
        ).value =
            "";


        productoActual = {
            id: "",
            nombre: "",
            codigo: "",
            tipo: "",
            contenidoPorEnvase: 1,
            unidadMedida: "Unidades",
            formaFarmaceutica: ""
        };


        valorAutoLote =
            "";


        valorAutoFecha =
            "";


        marcarLoteManual();

        marcarFechaManual();

        validarEstadoVencimiento();

        ocultarProductoIdentificado();

        actualizarCalculoRecepcion();


        const resultado =
            document.getElementById(
                "resultadoScanner"
            );


        resultado.innerHTML =
            "";


        resultado.className =
            "resultado-scanner resultado-oculto";


        const mensaje =
            document.getElementById(
                "mensajeFormulario"
            );


        mensaje.innerText =
            "";


        mensaje.className =
            "mensaje mensaje-error mensaje-oculto";


        actualizarResumen();


        if (
            modoSeleccion
            === "scanner"
        ) {

            document.getElementById(
                "codigoScanner"
            ).focus();
        }
        else {

            document.getElementById(
                "producto"
            ).focus();
        }
    }



    // =========================================
    // EVENTOS EN TIEMPO REAL
    // =========================================

    document
        .getElementById(
            "producto"
        )
        .addEventListener(
            "change",
            function () {

                if (
                    modoSeleccion
                    === "manual"
                ) {

                    cargarProductoManual();
                }
            }
        );


    document
        .getElementById(
            "numeroLote"
        )
        .addEventListener(
            "input",
            function () {

                if (
                    valorAutoLote === ""
                    ||
                    this.value
                        !== valorAutoLote
                ) {

                    marcarLoteManual();
                }
                else {

                    marcarLoteDetectado(
                        valorAutoLote
                    );
                }


                actualizarResumen();
            }
        );


    document
        .getElementById(
            "fechaVencimiento"
        )
        .addEventListener(
            "change",
            function () {

                if (
                    valorAutoFecha === ""
                    ||
                    this.value
                        !== valorAutoFecha
                ) {

                    marcarFechaManual();
                }
                else {

                    marcarFechaDetectada(
                        valorAutoFecha
                    );
                }


                validarEstadoVencimiento();

                actualizarResumen();
            }
        );


    document
        .getElementById(
            "cantidadEnvases"
        )
        .addEventListener(
            "input",
            function () {
                actualizarCalculoRecepcion();
                actualizarResumen();
            }
        );


    document
        .getElementById(
            "ubicacion"
        )
        .addEventListener(
            "change",
            actualizarResumen
        );



    // =========================================
    // INICIO DE LA PANTALLA
    // =========================================

    document.addEventListener(
        "DOMContentLoaded",
        function () {

            const producto =
                document.getElementById(
                    "producto"
                );


            if (
                producto.value
                !== ""
            ) {

                cambiarModo(
                    "manual"
                );


                cargarProductoManual();
            }
            else {

                cambiarModo(
                    "scanner"
                );
            }


            validarEstadoVencimiento();

            actualizarCalculoRecepcion();

            actualizarResumen();
        }
    );



    // =========================================
    // OCULTAR MENSAJE GENERAL
    // =========================================

    setTimeout(
        function () {

            const mensaje =
                document.getElementById(
                    "mensajeFormulario"
                );


            if (
                mensaje
                &&
                !mensaje.classList.contains(
                    "mensaje-oculto"
                )
            ) {

                mensaje.style.opacity =
                    "0";


                setTimeout(
                    function () {

                        mensaje.style.display =
                            "none";

                    },
                    500
                );
            }

        },
        3500
    );

</script>
