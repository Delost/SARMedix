        }


        const opcion =
            select.options[
                select.selectedIndex
            ];


        productoActual = {
            id:
                select.value,
            nombre:
                opcion.dataset.nombre
                ??
                opcion.textContent.trim(),
            codigo:
                opcion.dataset.codigo
                ??
                "",
            tipo:
                opcion.dataset.tipo
                ??
                "",
            contenidoPorEnvase:
                Number(opcion.dataset.contenido) > 0
                    ? Number(opcion.dataset.contenido)
                    : 1,
            unidadMedida:
                opcion.dataset.unidad
                ||
                "Unidades",
            formaFarmaceutica:
                opcion.dataset.forma
                ||
                ""
        };


        mostrarProductoIdentificado(
            productoActual.nombre,
            productoActual.codigo,
            productoActual.tipo
        );

        actualizarCalculoRecepcion();
