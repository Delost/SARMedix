<script>

    let loteConfirmado =
        false;


    let modoSeleccion =
        "scanner";


    let productoActual = {
        id: "",
        nombre: "",
        codigo: "",
        tipo: "",
        contenidoPorEnvase: 1,
        unidadMedida: "Unidades",
        formaFarmaceutica: ""
    };


    let valorAutoLote =
        "";


    let valorAutoFecha =
        "";



    // =========================================
    // UTILIDADES DE TEXTO
    // =========================================

    function escaparHtml(valor) {

        return String(valor ?? "")
            .replace(/&/g, "&amp;")
            .replace(/</g, "&lt;")
            .replace(/>/g, "&gt;")
            .replace(/"/g, "&quot;")
            .replace(/'/g, "&#039;");
    }



    // =========================================
    // ENVASES -> STOCK REAL
    // =========================================

    function unidadProducto() {

        const unidad =
            String(
                productoActual.unidadMedida
                ||
                "Unidades"
            ).trim();

        return unidad === ""
            ? "Unidades"
            : unidad;
    }


    function contenidoProducto() {

        const contenido =
            Number(
                productoActual.contenidoPorEnvase
            );

        return Number.isFinite(contenido)
            && contenido > 0
                ? contenido
                : 1;
    }


    function cantidadEnvasesIngresada() {

        const campo =
            document.getElementById(
                "cantidadEnvases"
            );

        const valor =
            Number(
                campo?.value
                ??
                0
            );

        return Number.isFinite(valor)
            && valor > 0
                ? valor
                : 0;
    }


    function calcularStockEntrada() {

        return cantidadEnvasesIngresada()
            *
            contenidoProducto();
    }


    function actualizarCalculoRecepcion() {

        const contenedor =
            document.getElementById(
                "calculoRecepcion"
            );

        const textoContenido =
            document.getElementById(
                "calculoContenido"
            );

        const textoTotal =
            document.getElementById(
                "calculoTotal"
            );

        const ocultoTotal =
            document.getElementById(
                "cantidadTotalStock"
            );

        if (
            !contenedor
            || !textoContenido
            || !textoTotal
            || !ocultoTotal
        ) {
            return;
        }

        if (productoActual.id === "") {

            ocultoTotal.value = "";
            contenedor.className = "calculo-recepcion";
            textoContenido.textContent =
                "Seleccione un producto para ver su contenido.";
            textoTotal.textContent =
                "El total de stock se calculará automáticamente.";
            return;
        }

        const contenido = contenidoProducto();
        const unidad = unidadProducto();
        const envases = cantidadEnvasesIngresada();
        const total = calcularStockEntrada();

        textoContenido.textContent =
            `Cada envase contiene ${contenido} ${unidad}.`;

        if (envases > 0) {

            ocultoTotal.value = String(total);
            contenedor.className =
                "calculo-recepcion calculo-listo";
            textoTotal.textContent =
                `${envases} envase(s) × ${contenido} ${unidad} = ${total} ${unidad} para el inventario.`;
        }
        else {

            ocultoTotal.value = "";
            contenedor.className = "calculo-recepcion";
            textoTotal.textContent =
                "Ingrese cuántos envases físicos llegaron.";
        }
    }


    // =========================================
    // CAMBIAR ENTRE MANUAL Y ESCANER
