@model LoginSARMedix.Models.Lote

@{
    ViewData["Title"] = "Registrar Entrada";
    ViewData["TituloBarra"] = "Registrar Entrada";

    string mensaje =
        ViewBag.Mensaje as string ?? "";

    bool mensajeExito =
        mensaje.Contains(
            "correctamente",
            StringComparison.OrdinalIgnoreCase
        );
}


<div class="entrada-pagina">

    <div class="entrada-encabezado">

        <div class="entrada-icono-principal">
            ⇩
        </div>

        <div>
            <h1>Registrar entrada</h1>

            <p>
                Recepción de medicamentos e insumos
            </p>
        </div>

    </div>


    <!-- ========================================= -->
    <!-- MENSAJE GENERAL                           -->
    <!-- ========================================= -->

    <div class="espacio-mensaje">

        @if (!string.IsNullOrWhiteSpace(mensaje))
        {
            <div id="mensajeFormulario"
                 class="mensaje @(mensajeExito ? "mensaje-exito" : "mensaje-error")">

                @mensaje

            </div>
        }
        else
        {
            <div id="mensajeFormulario"
                 class="mensaje mensaje-error mensaje-oculto">
            </div>
        }

    </div>


    <form asp-controller="Home"
          asp-action="NuevoLote"
          method="post"
          id="formCrearLote"
          class="formulario-entrada"
          onsubmit="return validarYConfirmar()"
          novalidate>


        <!-- ========================================= -->
        <!-- PASO 1 - IDENTIFICAR PRODUCTO             -->
        <!-- ========================================= -->

        <section class="entrada-seccion">

            <div class="seccion-cabecera">

                <div class="numero-paso">
                    1
                </div>

                <div>
                    <h2>Identificar producto</h2>

                    <p>
                        Escanee la caja o busque el producto manualmente.
                    </p>
                </div>

            </div>


            <div class="selector-modo">

                <button type="button"
                        id="btnModoScanner"
                        class="btn-modo activo"
                        onclick="cambiarModo('scanner')">

                    🔫 Escáner

                </button>


                <button type="button"
                        id="btnModoManual"
                        class="btn-modo"
                        onclick="cambiarModo('manual')">

                    ✋ Manual

                </button>

            </div>


            <!-- ========================================= -->
            <!-- MODO ESCANER                              -->
            <!-- ========================================= -->

            <div id="modoScanner"
                 class="contenido-modo">

                <div class="scanner-caja">

                    <div class="scanner-icono">
                        🔫
                    </div>

                    <div class="scanner-textos">

                        <strong>
                            Escanee el código de la caja
                        </strong>

                        <span>
                            El sistema intentará reconocer producto, lote y vencimiento automáticamente.
                        </span>

                    </div>

                </div>


                <label for="codigoScanner">
                    Código de barras / GS1
                </label>


                <div class="scanner-input-contenedor">

                    <input type="text"
                           id="codigoScanner"
                           autocomplete="off"
                           placeholder="Esperando lectura del escáner..." />

                    <button type="button"
                            class="btn-buscar-codigo"
                            onclick="buscarProductoEscaneado()">

                        Buscar

                    </button>

                </div>


                <div id="resultadoScanner"
                     class="resultado-scanner resultado-oculto">
                </div>

            </div>


            <!-- ========================================= -->
            <!-- MODO MANUAL                               -->
            <!-- ========================================= -->

            <div id="modoManual"
                 class="contenido-modo modo-oculto">

                <label for="producto">
                    Buscar producto
                </label>

                <select asp-for="id_producto"
                        id="producto">

                    <option value="">
                        Seleccione un producto
                    </option>

                    @foreach (var producto in ViewBag.Productos)
                    {
                        <option value="@producto.id_producto"
                                data-nombre="@producto.nombre"
                                data-codigo="@producto.codigo_interno"
                                data-tipo="@producto.tipo"
                                data-contenido="@producto.contenido_por_envase"
                                data-unidad="@producto.unidad_medida"
                                data-forma="@producto.forma_farmaceutica">

                            @producto.codigo_interno -
                            @producto.nombre

                        </option>
                    }

                </select>

                <div class="ayuda-campo">
                    Use esta opción cuando el código no esté disponible o no pueda leerse.
                </div>

            </div>


            <!-- ========================================= -->
            <!-- PRODUCTO IDENTIFICADO                     -->
            <!-- ========================================= -->

            <div id="productoIdentificado"
                 class="producto-identificado producto-identificado-oculto">

                <div class="producto-check">
                    ✓
                </div>

                <div class="producto-identificado-info">

                    <div class="producto-etiqueta">
                        Producto identificado
                    </div>

                    <div id="productoIdentificadoNombre"
                         class="producto-identificado-nombre">
                    </div>

                    <div id="productoIdentificadoDetalle"
                         class="producto-identificado-detalle">
                    </div>

                </div>

            </div>

        </section>



        <!-- ========================================= -->
        <!-- RESTO DEL FORMULARIO                      -->
        <!-- ========================================= -->

        <div id="datosEntrada"
             class="datos-entrada datos-entrada-ocultos">


            <div class="entrada-columnas">


                <!-- ========================================= -->
                <!-- PASO 2 - DATOS DEL LOTE                   -->
                <!-- ========================================= -->

                <section class="entrada-seccion">

                    <div class="seccion-cabecera">

                        <div class="numero-paso">
                            2
                        </div>

                        <div>
                            <h2>Datos del lote</h2>

                            <p>
                                Revise los datos detectados o complételos manualmente.
                            </p>
                        </div>

                    </div>


                    <div class="campo-grupo">

                        <div class="label-con-estado">

                            <label for="numeroLote">
                                Número de lote
                            </label>

                            <span id="estadoLote"
                                  class="estado-dato estado-manual">
                                ✏️ Ingreso manual
                            </span>

                        </div>

                        <input asp-for="numero_lote"
                               id="numeroLote"
                               autocomplete="off"
                               placeholder="Ej: G010376" />

                    </div>


                    <div class="campo-grupo">

                        <div class="label-con-estado">

                            <label for="fechaVencimiento">
                                Fecha de vencimiento
                            </label>

                            <span id="estadoFecha"
                                  class="estado-dato estado-manual">
                                ✏️ Ingreso manual
                            </span>

                        </div>

                        <input asp-for="fecha_vencimiento"
                               id="fechaVencimiento"
                               type="date" />

                        <div id="avisoVencimiento"
                             class="aviso-vencimiento aviso-vencimiento-oculto">
                        </div>

                    </div>

                </section>



                <!-- ========================================= -->
                <!-- PASO 3 - RECEPCION                        -->
                <!-- ========================================= -->

                <section class="entrada-seccion">

                    <div class="seccion-cabecera">

                        <div class="numero-paso">
                            3
                        </div>

                        <div>
                            <h2>Recepción</h2>

                            <p>
                                Indique cuánto llegó y dónde quedará almacenado.
                            </p>
                        </div>

                    </div>


                    <div class="campo-grupo">

                        <label for="cantidadEnvases">
                            Cantidad de envases recibidos
                        </label>

                        <input id="cantidadEnvases"
                               name="cantidadEnvases"
                               type="number"
                               min="1"
                               step="1"
                               placeholder="Ej: 10"
                               autocomplete="off" />

                        <!-- El usuario escribe envases. El sistema guarda stock real. -->
                        <input asp-for="cantidad_actual"
                               id="cantidadTotalStock"
                               type="hidden" />

                        <div id="calculoRecepcion"
                             class="calculo-recepcion">

                            <strong id="calculoContenido">
                                Seleccione un producto para ver su contenido.
                            </strong>

                            <span id="calculoTotal">
                                El total de stock se calculará automáticamente.
                            </span>

                        </div>

                    </div>


                    <div class="campo-grupo">

                        <label for="ubicacion">
                            Ubicación destino
                        </label>

                        <select asp-for="id_ubicacion"
                                id="ubicacion">

                            <option value="">
                                Seleccione una ubicación
                            </option>

                            @foreach (var ubicacion in ViewBag.Ubicaciones)
                            {
                                <option value="@ubicacion.id_ubicacion">
                                    @ubicacion.nombre_sector
                                </option>
                            }

                        </select>

                    </div>

                </section>

            </div>



            <!-- ========================================= -->
            <!-- PASO 4 - RESUMEN                          -->
            <!-- ========================================= -->

            <section class="entrada-seccion resumen-seccion">

                <div class="seccion-cabecera">

                    <div class="numero-paso">
                        4
                    </div>

                    <div>
                        <h2>Revisar entrada</h2>

                        <p>
                            Confirme los datos antes de guardarlos.
                        </p>
                    </div>

                </div>


                <div class="resumen-grid">

                    <div class="resumen-item resumen-producto">

                        <span class="resumen-label">
                            Producto
                        </span>

                        <strong id="resumenProducto">
                            —
                        </strong>

                    </div>


                    <div class="resumen-item">

                        <span class="resumen-label">
                            Lote
                        </span>

                        <strong id="resumenLote">
                            —
                        </strong>

                    </div>


                    <div class="resumen-item">

                        <span class="resumen-label">
                            Vencimiento
                        </span>

                        <strong id="resumenVencimiento">
                            —
                        </strong>

                    </div>


                    <div class="resumen-item">

                        <span class="resumen-label">
                            Recibido
                        </span>

                        <strong id="resumenEnvases">
                            —
                        </strong>

                    </div>


                    <div class="resumen-item">

                        <span class="resumen-label">
                            Stock a sumar
                        </span>

                        <strong id="resumenCantidad">
                            —
                        </strong>

                    </div>


                    <div class="resumen-item resumen-destino">

                        <span class="resumen-label">
                            Destino
                        </span>

                        <strong id="resumenUbicacion">
                            —
                        </strong>

                    </div>

                </div>


                <div id="resumenEstado"
                     class="resumen-estado">

                    Complete los datos requeridos para registrar la entrada.

                </div>


                <button type="submit"
                        id="btnRegistrarEntrada"
                        class="btn-registrar-entrada">

                    ✓ Registrar entrada

                </button>

            </section>

        </div>

    </form>


    <!-- ========================================= -->
    <!-- NAVEGACION                                -->
    <!-- ========================================= -->

    <div class="entrada-navegacion">

        <a asp-controller="Home"
           asp-action="Lotes"
           class="btn-volver-inventario">

            ← Volver a Inventario

        </a>

    </div>

</div>



<!-- ========================================= -->
<!-- MODAL DE CONFIRMACION                     -->
<!-- ========================================= -->

<div id="modalConfirmacion"
     class="modal-fondo">

    <div class="modal-contenido">

        <div class="modal-icono">
            ✓
        </div>

        <h2>
            Confirmar entrada
        </h2>

        <p>
            Revise una última vez antes de registrar.
        </p>


        <div id="modalResumen"
             class="modal-resumen">
        </div>


        <div class="modal-botones">

            <button type="button"
                    class="btn-modal-si"
                    onclick="registrarLote()">

                Sí, registrar

            </button>


            <button type="button"
                    class="btn-modal-no"
                    onclick="cerrarConfirmacion()">

                Volver

            </button>


            <button type="button"
                    class="btn-modal-cancelar"
                    onclick="cancelarRegistro()">

                Limpiar

            </button>

        </div>

    </div>

</div>



<style>

    /* ========================================= */
    /* CONTENEDOR GENERAL                        */
    /* ========================================= */

    .entrada-pagina {
        width: min(1120px, calc(100% - 32px));
        margin: 35px auto;
        padding: 34px;
        box-sizing: border-box;
        background-color: rgba(255, 255, 255, 0.97);
        border-radius: 20px;
        box-shadow: 0 12px 34px rgba(16, 65, 95, 0.15);
    }


    .entrada-encabezado {
        display: flex;
        align-items: center;
        gap: 16px;
        padding-bottom: 24px;
        margin-bottom: 22px;
        border-bottom: 1px solid #e2ebf0;
    }


    .entrada-icono-principal {
        width: 56px;
        height: 56px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        border-radius: 16px;
        background: linear-gradient( 135deg, #0d7898, #1198a5 );
        color: white;
        font-size: 31px;
        font-weight: 800;
        box-shadow: 0 7px 18px rgba(17, 152, 165, 0.22);
    }


    .entrada-encabezado h1 {
        margin: 0;
        color: #073b64;
        font-size: 30px;
        font-weight: 750;
    }


    .entrada-encabezado p {
        margin: 5px 0 0 0;
        color: #6a8191;
        font-size: 15px;
    }



    /* ========================================= */
    /* FORMULARIO                                 */
    /* ========================================= */

    #formCrearLote.formulario-entrada {
        width: 100%;
        max-width: none;
        margin: 0;
        padding: 0;
        background: transparent;
        border-radius: 0;
        box-shadow: none;
    }


    .entrada-seccion {
        width: 100%;
        padding: 24px;
        box-sizing: border-box;
        background-color: #ffffff;
        border: 1px solid #dce8ee;
        border-radius: 16px;
        box-shadow: 0 5px 16px rgba(16, 65, 95, 0.06);
    }


    .seccion-cabecera {
        display: flex;
        align-items: flex-start;
        gap: 13px;
        margin-bottom: 22px;
    }


    .numero-paso {
        width: 34px;
        height: 34px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        border-radius: 10px;
        background-color: #e8f5fa;
        color: #087591;
        font-size: 16px;
        font-weight: 800;
    }


    .seccion-cabecera h2 {
        width: auto;
        max-width: none;
        margin: 0;
        padding: 0;
        background: transparent;
        border-radius: 0;
        box-shadow: none;
        color: #073b64;
        font-size: 20px;
        font-weight: 750;
    }


        .seccion-cabecera h2::before,
        .seccion-cabecera h2::after {
            display: none;
        }


    .seccion-cabecera p {
        margin: 4px 0 0 0;
        color: #718695;
        font-size: 13px;
        line-height: 1.45;
    }



    /* ========================================= */
    /* MENSAJES                                  */
    /* ========================================= */

    .espacio-mensaje {
        min-height: 0;
        margin-bottom: 18px;
    }


    .mensaje {
        width: 100%;
        padding: 13px 16px;
        box-sizing: border-box;
        border-radius: 10px;
        text-align: center;
        font-weight: 650;
        opacity: 1;
        transition: opacity 0.5s ease;
    }


    .mensaje-exito {
        background-color: #dff3e7;
        color: #12623d;
        border: 1px solid #b8dfc8;
    }


    .mensaje-error {
        background-color: #fae1e3;
        color: #8b2631;
        border: 1px solid #f0bec3;
    }


    .mensaje-oculto {
        display: none;
    }



    /* ========================================= */
    /* SELECTOR MANUAL / ESCANER                 */
    /* ========================================= */

    .selector-modo {
        width: 100%;
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 10px;
        margin-bottom: 20px;
    }


    .btn-modo {
        width: 100%;
        padding: 12px 16px;
        border: 1px solid #cfdde5;
        border-radius: 10px;
        background-color: #f8fafb;
        color: #4f6270;
        font-family: inherit;
        font-size: 15px;
        font-weight: 750;
        cursor: pointer;
        transition: transform 0.18s ease, border-color 0.18s ease, background-color 0.18s ease, color 0.18s ease;
    }


        .btn-modo:hover {
            transform: translateY(-1px);
            border-color: #1198a5;
            background-color: #eef9fa;
        }


        .btn-modo.activo {
            border-color: #1198a5;
            background-color: #1198a5;
            color: white;
        }


    .contenido-modo {
        width: 100%;
    }


    .modo-oculto {
        display: none;
    }



    /* ========================================= */
    /* CONTROLES                                  */
    /* ========================================= */

    .formulario-entrada label {
        display: block;
        margin-bottom: 7px;
        color: #173d5e;
        font-size: 14px;
        font-weight: 700;
    }


    .formulario-entrada input,
    .formulario-entrada select {
        width: 100%;
        min-height: 48px;
        padding: 11px 13px;
        box-sizing: border-box;
        border: 1px solid #bfd1dd;
        border-radius: 10px;
        background-color: #fbfdfe;
        color: #20394d;
        font-family: inherit;
        font-size: 15px;
        outline: none;
        transition: border-color 0.18s ease, box-shadow 0.18s ease, background-color 0.18s ease;
    }


        .formulario-entrada input:focus,
        .formulario-entrada select:focus {
            border-color: #1198a5;
            background-color: white;
            box-shadow: 0 0 0 3px rgba(17, 152, 165, 0.12);
        }


    .campo-grupo + .campo-grupo {
        margin-top: 22px;
    }


    .ayuda-campo {
        margin-top: 7px;
        color: #8193a0;
        font-size: 12px;
    }



    /* ========================================= */
    /* ESCANER                                   */
    /* ========================================= */

    .scanner-caja {
        display: flex;
        align-items: center;
        gap: 15px;
        padding: 16px;
        margin-bottom: 17px;
        background-color: #f0f9fb;
        border: 1px solid #c4e4ea;
        border-radius: 12px;
    }


    .scanner-icono {
        width: 52px;
        height: 52px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        border-radius: 50%;
        background-color: #1198a5;
        color: white;
        font-size: 24px;
    }


    .scanner-textos {
        display: flex;
        flex-direction: column;
        gap: 4px;
    }


        .scanner-textos strong {
            color: #073b64;
            font-size: 15px;
        }


        .scanner-textos span {
            color: #6e8492;
            font-size: 13px;
            line-height: 1.4;
        }


    .scanner-input-contenedor {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        gap: 10px;
    }


    .btn-buscar-codigo {
        min-width: 112px;
        padding: 10px 20px;
        border: none;
        border-radius: 10px;
        background-color: #1198a5;
        color: white;
        font-family: inherit;
        font-size: 14px;
        font-weight: 700;
        cursor: pointer;
    }


        .btn-buscar-codigo:hover {
            background-color: #0d8490;
        }



    /* ========================================= */
    /* RESULTADO DEL ESCANEO                     */
    /* ========================================= */

    .resultado-scanner {
        margin-top: 15px;
        padding: 15px 16px;
        border-radius: 11px;
        font-size: 13px;
        line-height: 1.55;
    }


    .resultado-oculto {
        display: none;
    }


    .resultado-encontrado {
        display: block;
        background-color: #e1f3e8;
        color: #145b38;
        border: 1px solid #bddfc9;
    }


    .resultado-no-encontrado {
        display: block;
        background-color: #fff3cd;
        color: #694f00;
        border: 1px solid #f2dd9c;
    }


    .resultado-error {
        display: block;
        background-color: #f8d7da;
        color: #842029;
        border: 1px solid #efb8be;
    }


    .producto-encontrado-titulo {
        margin-bottom: 5px;
        font-size: 15px;
        font-weight: 800;
    }


    .btn-registrar-producto {
        display: inline-block;
        margin-top: 12px;
        padding: 9px 14px;
        border-radius: 8px;
        background-color: #1198a5;
        color: white;
        text-decoration: none;
        font-weight: 700;
    }


        .btn-registrar-producto:hover {
            background-color: #0d8490;
            color: white;
        }



    /* ========================================= */
    /* PRODUCTO IDENTIFICADO                     */
    /* ========================================= */

    .producto-identificado {
        display: flex;
        align-items: center;
        gap: 13px;
        margin-top: 19px;
        padding: 14px 16px;
        border: 1px solid #b9dfc8;
        border-radius: 12px;
        background-color: #edf8f1;
    }


    .producto-identificado-oculto {
        display: none;
    }


    .producto-check {
        width: 38px;
        height: 38px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        border-radius: 50%;
        background-color: #198754;
        color: white;
        font-size: 20px;
        font-weight: 800;
    }


    .producto-etiqueta {
        color: #52705e;
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.04em;
    }


    .producto-identificado-nombre {
        margin-top: 1px;
        color: #0b4f31;
        font-size: 18px;
        font-weight: 800;
    }


    .producto-identificado-detalle {
        margin-top: 3px;
        color: #4f715d;
        font-size: 12px;
    }



    /* ========================================= */
    /* DATOS DE ENTRADA                          */
    /* ========================================= */

    .datos-entrada {
        margin-top: 18px;
    }


    .datos-entrada-ocultos {
        display: none;
    }


    .entrada-columnas {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 18px;
    }


    .label-con-estado {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        margin-bottom: 7px;
    }


        .label-con-estado label {
            margin-bottom: 0;
        }


    .estado-dato {
        padding: 4px 8px;
        border-radius: 999px;
        font-size: 10px;
        font-weight: 750;
        white-space: nowrap;
    }


    .estado-manual {
        background-color: #eef2f5;
        color: #647582;
    }


    .estado-detectado {
        background-color: #dff3e7;
        color: #14613c;
    }


    .aviso-vencimiento {
        margin-top: 8px;
        padding: 9px 11px;
        border-radius: 8px;
        font-size: 12px;
        font-weight: 650;
    }


    .aviso-vencimiento-oculto {
        display: none;
    }


    .aviso-vencido {
        display: block;
        background-color: #f8d7da;
