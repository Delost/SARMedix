    // =========================================
    // FECHAS GS1
    // =========================================

    function convertirFechaGS1(fechaGS1) {

        if (!/^\d{6}$/.test(fechaGS1)) {
            return "";
        }


        const anio =
            2000
            +
            Number(
                fechaGS1.substring(
                    0,
                    2
                )
            );


        const mes =
            Number(
                fechaGS1.substring(
                    2,
                    4
                )
            );


        let dia =
            Number(
                fechaGS1.substring(
                    4,
                    6
                )
            );


        if (mes < 1 || mes > 12) {
            return "";
        }


        // GS1 permite día 00 para representar
        // el último día del mes.
        if (dia === 0) {

            dia =
                new Date(
                    anio,
                    mes,
                    0
                )
                .getDate();
        }


        const fecha =
            new Date(
                anio,
                mes - 1,
                dia
            );


        if (
            fecha.getFullYear()
                !== anio
            ||
            fecha.getMonth()
                !== mes - 1
            ||
            fecha.getDate()
                !== dia
        ) {
            return "";
        }


        return (
            `${anio}-`
            +
            `${String(mes).padStart(2, "0")}-`
            +
            `${String(dia).padStart(2, "0")}`
        );
    }



    function esFechaVencida(fechaTexto) {

        if (!fechaTexto) {
            return false;
        }


        const partes =
            fechaTexto.split("-");


        if (partes.length !== 3) {
            return false;
        }


        const fecha =
            new Date(
                Number(partes[0]),
                Number(partes[1]) - 1,
                Number(partes[2])
            );


        const hoy =
            new Date();


        hoy.setHours(
            0,
            0,
            0,
            0
        );


        fecha.setHours(
            0,
            0,
            0,
            0
        );


        return fecha < hoy;
    }



    function formatearFechaPantalla(fechaTexto) {

        if (!fechaTexto) {
            return "";
        }


        const partes =
            fechaTexto.split("-");


        if (partes.length !== 3) {
            return fechaTexto;
        }


        return (
            `${partes[2]}-`
            +
            `${partes[1]}-`
            +
            `${partes[0]}`
        );
    }



    // =========================================
    // ANALIZAR CODIGO GS1
    // =========================================

    function analizarCodigoEscaneado(
        codigoCrudo
    ) {

        const separadorGS =
            String.fromCharCode(
                29
            );


        let codigo =
            codigoCrudo.trim();


        // Algunos lectores presentan los
        // identificadores como (01), (17), etc.
        codigo =
            codigo.replace(
                /\((\d{2})\)/g,
                "$1"
            );


        const resultado = {
            esGS1: false,
            codigoBusqueda: codigo,
            gtin: "",
            lote: "",
            fechaVencimiento: "",
            serie: "",
            separadorGSDetectado: false,
            datosVariablesEstimados: false
        };


        // AI (01): GTIN de 14 dígitos.
        const coincidenciaGTIN =
            codigo.match(
                /(?:^|\x1D)01(\d{14})/
            );


        if (!coincidenciaGTIN) {
            return resultado;
        }


        resultado.esGS1 =
            true;


        resultado.gtin =
            coincidenciaGTIN[1];


        resultado.codigoBusqueda =
            resultado.gtin;


        // AI (17): vencimiento YYMMDD.
        const coincidenciaFecha =
            codigo.match(
                /17(\d{6})/
            );


        if (coincidenciaFecha) {

            resultado.fechaVencimiento =
                convertirFechaGS1(
                    coincidenciaFecha[1]
                );
        }


        // AI (10): lote de longitud variable.
        const indiceLote =
            codigo.indexOf(
                "10",
                coincidenciaGTIN.index
                +
                coincidenciaGTIN[0].length
            );


        if (indiceLote !== -1) {

            let resto =
                codigo.substring(
                    indiceLote + 2
                );


            const indiceSeparador =
                resto.indexOf(
                    separadorGS
                );


            if (indiceSeparador !== -1) {

                resultado.separadorGSDetectado =
                    true;


                resultado.lote =
                    resto.substring(
                        0,
                        indiceSeparador
                    );


                const despuesSeparador =
                    resto.substring(
                        indiceSeparador + 1
                    );


                if (
                    despuesSeparador
                        .startsWith("21")
                ) {

                    resultado.serie =
                        despuesSeparador
                            .substring(2);
                }
            }
            else {

                // Si el lector no entrega GS/FNC1,
                // intentamos separar AI (21) de forma
                // conservadora y avisamos al usuario.
                const posiciones21 = [];


                for (
                    let i = 1;
                    i < resto.length - 2;
                    i++
                ) {

                    if (
                        resto.substring(
                            i,
                            i + 2
                        )
                        === "21"
                    ) {

                        posiciones21.push(
                            i
                        );
                    }
                }


                let separacionAplicada =
                    false;


                for (
                    let i = posiciones21.length - 1;
                    i >= 0;
                    i--
                ) {

                    const posicion =
                        posiciones21[i];


                    const loteCandidato =
                        resto.substring(
                            0,
                            posicion
                        );


                    const serieCandidata =
                        resto.substring(
                            posicion + 2
                        );


                    if (
                        loteCandidato.length >= 1
                        &&
                        loteCandidato.length <= 20
                        &&
                        serieCandidata.length >= 4
                        &&
                        serieCandidata.length <= 20
                    ) {

                        resultado.lote =
                            loteCandidato;


                        resultado.serie =
                            serieCandidata;


                        resultado.datosVariablesEstimados =
                            true;


                        separacionAplicada =
                            true;


                        break;
                    }
                }


                if (!separacionAplicada) {

                    resultado.lote =
                        resto.substring(
                            0,
                            20
                        );


                    if (resto.length > 20) {

                        resultado.datosVariablesEstimados =
                            true;
                    }
                }
            }
        }


        return resultado;
    }



