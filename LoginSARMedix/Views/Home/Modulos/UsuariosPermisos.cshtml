@{
    Layout = null;

    string nombreCompleto =
        ViewBag.Nombre + " " + ViewBag.Apellido;

    string inicial =
        !string.IsNullOrEmpty(ViewBag.Nombre?.ToString())
        ? ViewBag.Nombre.ToString().Substring(0, 1).ToUpper()
        : "U";
}

<!DOCTYPE html>

<html lang="es">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        Usuarios y Permisos - SARMedix
    </title>


    <style>

        * {
            box-sizing: border-box;
        }


        body {
            margin: 0;

            min-height: 100vh;

            display: flex;

            flex-direction: column;

            font-family:
                "Segoe UI",
                Arial,
                sans-serif;

            color: #17324d;

            background:
                linear-gradient(
                    rgba(235, 247, 252, 0.82),
                    rgba(235, 247, 252, 0.82)
                ),
                url('/images/fondo-clinico.png');

            background-size: cover;

            background-position: center;

            background-attachment: fixed;
        }



        /* ================================= */
        /* BARRA SUPERIOR                    */
        /* ================================= */

        .barra-superior {
            min-height: 82px;

            display: grid;

            grid-template-columns:
                1fr 1fr 1fr;

            align-items: center;

            padding:
                12px 60px;

            background: #0f5278;

            color: white;

            box-shadow:
                0 3px 10px
                rgba(0, 0, 0, 0.15);
        }



        /* ================================= */
        /* LOGO                              */
        /* ================================= */

        .logo {
            display: flex;

            align-items: center;

            gap: 14px;
        }


        .logo-cruz-medica {
            width: 48px;

            height: 48px;

            flex-shrink: 0;

            background: white;

            border-radius: 12px;

            display: flex;

            align-items: center;

            justify-content: center;

            box-shadow:
                0 4px 10px
                rgba(0, 0, 0, 0.15);
        }


        .cruz {
            position: relative;

            width: 22px;

            height: 22px;

            display: block;
        }


        .cruz::before,
        .cruz::after {
            content: "";

            position: absolute;

            background: #0b6fb8;

            border-radius: 3px;
        }


        .cruz::before {
            width: 8px;

            height: 22px;

            left: 7px;

            top: 0;
        }


        .cruz::after {
            width: 22px;

            height: 8px;

            left: 0;

            top: 7px;
        }


        .logo-texto {
            font-size: 25px;

            font-weight: 700;

            color: white;

            letter-spacing: 0.3px;

            white-space: nowrap;
        }



        /* ================================= */
        /* TITULO CENTRAL                    */
        /* ================================= */

        .titulo-superior {
            text-align: center;

            font-size: 25px;

            font-weight: 600;
        }



        /* ================================= */
        /* USUARIO                           */
        /* ================================= */

        .usuario-superior {
            display: flex;

            justify-content: flex-end;

            align-items: center;

            gap: 13px;
        }


        .usuario-datos {
            text-align: right;
        }


        .usuario-nombre {
            display: block;

            font-size: 16px;

            font-weight: 600;
        }


        .usuario-rol {
            display: block;

            margin-top: 2px;

            font-size: 13px;

            opacity: 0.85;
        }


        .usuario-circulo {
            width: 48px;

            height: 48px;

            flex-shrink: 0;

            display: flex;

            align-items: center;

            justify-content: center;

            border-radius: 50%;

            background:
                rgba(255, 255, 255, 0.22);

            font-size: 20px;

            font-weight: 600;
        }



        /* ================================= */
        /* CERRAR SESION                     */
        /* ================================= */

        .form-cerrar-sesion {
            margin: 0;

            padding: 0;
        }


        .btn-cerrar-sesion {
            width: auto;

            padding:
                9px 13px;

            border:
                1px solid
                rgba(255, 255, 255, 0.65);

            border-radius: 7px;

            background: transparent;

            color: white;

            font-family: inherit;

            font-size: 13px;

            font-weight: 600;

            cursor: pointer;

            transition:
                background 0.2s ease,
                border-color 0.2s ease;
        }


        .btn-cerrar-sesion:hover {
            background:
                rgba(255, 255, 255, 0.16);

            border-color: white;
        }



        /* ================================= */
        /* CONTENIDO                         */
        /* ================================= */

        .submenu-contenedor {
            width: 90%;

            max-width: 1050px;

            margin:
                45px auto;

            text-align: center;

            flex: 1;
        }


        .submenu-titulo {
            color: #087bc2;

            font-size: 32px;

            font-weight: 700;

            margin-bottom: 8px;
        }


        .submenu-descripcion {
            color: #5f7180;

            margin-bottom: 35px;

            font-size: 16px;
        }



        /* ================================= */
        /* TARJETAS                          */
        /* ================================= */

        .submenu-grid {
            display: grid;

            grid-template-columns:
                repeat(2, 1fr);

            gap: 25px;
        }


        .submenu-card {
            min-height: 190px;

            background:
                rgba(255, 255, 255, 0.95);

            border-radius: 14px;

            padding: 30px;

            display: flex;

            flex-direction: column;

            justify-content: center;

            align-items: center;

            text-align: center;

            text-decoration: none;

            color: #17324d;

            box-shadow:
                0 7px 20px
                rgba(28, 65, 95, 0.15);

            transition:
                transform 0.2s ease,
                box-shadow 0.2s ease;
        }


        .submenu-card:hover {
            transform:
                translateY(-5px);

            box-shadow:
                0 14px 30px
                rgba(15, 91, 150, 0.25);
        }


        .submenu-icono {
            font-size: 42px;

            margin-bottom: 12px;
        }


        .submenu-card-titulo {
            margin-bottom: 8px;

            color: #087bc2;

            font-size: 21px;

            font-weight: 700;
        }


        .submenu-card p {
            margin: 0;

            color: #687b89;

            font-size: 14px;
        }



        /* ================================= */
        /* BOTON VOLVER                      */
        /* ================================= */

        .volver-contenedor {
            margin-top: 35px;

            text-align: center;
        }


        .btn-volver-submenu {
            display: inline-block;

            padding:
                11px 20px;

            background: #0b8f9c;

            color: white;

            border-radius: 7px;

            text-decoration: none;

            font-weight: 600;
        }


        .btn-volver-submenu:hover {
            background: #087580;

            color: white;
        }



        /* ================================= */
        /* MODAL CERRAR SESION               */
        /* ================================= */

        .modal-fondo-sesion {
            display: none;

            position: fixed;

            top: 0;

            left: 0;

            width: 100%;

            height: 100%;

            align-items: center;

            justify-content: center;

            background-color:
                rgba(0, 0, 0, 0.45);

            z-index: 99999;
        }


        .modal-contenido-sesion {
            width: 90%;

            max-width: 430px;

            padding: 30px;

            background-color: white;

            border-radius: 15px;

            text-align: center;

            box-shadow:
                0 12px 35px
                rgba(0, 0, 0, 0.25);
        }


        .modal-icono-sesion {
            width: 55px;

            height: 55px;

            margin:
                0 auto 15px auto;

            display: flex;

            align-items: center;

            justify-content: center;

            border-radius: 50%;

            background-color: #1198a5;

            color: white;

            font-size: 30px;

            font-weight: bold;
        }


        .modal-titulo-sesion {
            margin: 0;

            color: #003b64;

            font-size: 25px;

            font-weight: 700;
        }


        .modal-texto-sesion {
            margin-top: 15px;

            margin-bottom: 25px;

            color: #444;

            font-size: 17px;
        }


        .modal-botones-sesion {
            display: flex;

            justify-content: center;

            gap: 10px;
        }


        .modal-botones-sesion button {
            min-width: 100px;

            padding:
                10px 18px;

            border: none;

            border-radius: 7px;

            color: white;

            font-family: inherit;

            font-size: 14px;

            font-weight: 600;

            cursor: pointer;
        }


        .btn-sesion-si {
            background-color: #198754;
        }


        .btn-sesion-si:hover {
            background-color: #157347;
        }


        .btn-sesion-no {
            background-color: #c82333;
        }


        .btn-sesion-no:hover {
            background-color: #a91d2a;
        }



        /* ================================= */
        /* FOOTER                            */
        /* ================================= */

        .footer {
            width: 100%;

            margin-top: auto;

            padding: 18px;

            background:
                rgba(255, 255, 255, 0.90);

            text-align: center;

            color: #668092;

            font-size: 13px;
        }



        /* ================================= */
        /* RESPONSIVE                        */
        /* ================================= */

        @@media (max-width: 900px) {

            .barra-superior {
                grid-template-columns:
                    1fr 1fr;

                height: auto;

                min-height: 82px;

                padding:
                    15px 25px;
            }


            .titulo-superior {
                display: none;
            }


            .logo-texto {
                font-size: 20px;
            }


            .submenu-grid {
                grid-template-columns:
                    1fr;
            }


            .submenu-contenedor {
                width: 94%;

                margin-top: 30px;
            }


            .usuario-datos {
                display: none;
            }

        }



        @@media (max-width: 600px) {

            .barra-superior {
                padding:
                    12px 15px;
            }


            .logo-cruz-medica {
                width: 42px;

                height: 42px;
            }


            .logo-texto {
                font-size: 17px;
            }


            .usuario-circulo {
                display: none;
            }


            .btn-cerrar-sesion {
                padding:
                    8px 10px;

                font-size: 12px;
            }


            .modal-botones-sesion {
                flex-direction: column;
            }


            .modal-botones-sesion button {
                width: 100%;
            }

        }

    </style>

</head>



<body>


    <!-- ================================= -->
    <!-- BARRA SUPERIOR                    -->
    <!-- ================================= -->

    <header class="barra-superior">


        <div class="logo">


            <div class="logo-cruz-medica">

                <span class="cruz"></span>

            </div>


            <div class="logo-texto">

                SARMedix | SAR de Chiguay

            </div>


        </div>



        <div class="titulo-superior">

            Seleccione Submódulo

        </div>



        <div class="usuario-superior">


            <div class="usuario-datos">


                <span class="usuario-nombre">

                    @nombreCompleto

                </span>


                <span class="usuario-rol">

                    @ViewBag.Rol

                </span>


            </div>



            <div class="usuario-circulo">

                @inicial

            </div>



            <!-- ================================= -->
            <!-- CERRAR SESION                     -->
            <!-- ================================= -->

            <form asp-controller="Home"
                  asp-action="CerrarSesion"
                  method="post"
                  id="formCerrarSesion"
                  class="form-cerrar-sesion">


                <button type="button"
                        class="btn-cerrar-sesion"
                        onclick="abrirConfirmacionCerrarSesion()">

                    Cerrar sesión

                </button>


            </form>


        </div>


    </header>



    <!-- ================================= -->
    <!-- CONTENIDO DEL SUBMENU             -->
    <!-- ================================= -->

    <main class="submenu-contenedor">


        <div class="submenu-titulo">

            Usuarios y Permisos

        </div>


        <p class="submenu-descripcion">

            Seleccione una opción para gestionar los usuarios del sistema.

        </p>



        <div class="submenu-grid">



            <!-- ================================= -->
            <!-- CREAR USUARIO                     -->
            <!-- ================================= -->

            <a asp-controller="Home"
               asp-action="CrearUsuario"
               class="submenu-card">


                <div class="submenu-icono">

                    👤

                </div>


                <div class="submenu-card-titulo">

                    Crear Usuario

                </div>


                <p>

                    Registrar un nuevo usuario en SARMedix.

                </p>


            </a>



            <!-- ================================= -->
            <!-- LISTADO DE USUARIOS               -->
            <!-- ================================= -->

            <a asp-controller="Home"
               asp-action="Usuarios"
               class="submenu-card">


                <div class="submenu-icono">

                    👥

                </div>


                <div class="submenu-card-titulo">

                    Listado de Usuarios

                </div>


                <p>

                    Consultar, editar y desactivar usuarios.

                </p>


            </a>



            <!-- ================================= -->
            <!-- USUARIOS INACTIVOS                -->
            <!-- ================================= -->

            <a asp-controller="Home"
               asp-action="ListadoEliminarUsuarios"
               class="submenu-card">


                <div class="submenu-icono">

                    🗑️

                </div>


                <div class="submenu-card-titulo">

                    Usuarios Inactivos

                </div>


                <p>

                    Consultar usuarios desactivados y eliminarlos.

                </p>


            </a>



            <!-- ================================= -->
            <!-- ROLES Y PERMISOS                  -->
            <!-- ================================= -->

            <a asp-controller="Home"
               asp-action="RolesPermisos"
               class="submenu-card">


                <div class="submenu-icono">

                    🔐

                </div>


                <div class="submenu-card-titulo">

                    Roles y Permisos

                </div>


                <p>

                    Consultar y administrar los permisos asociados a cada rol.

                </p>


            </a>


        </div>



        <!-- ================================= -->
        <!-- VOLVER                            -->
        <!-- ================================= -->

        <div class="volver-contenedor">


            <a asp-controller="Home"
               asp-action="Modulos"
               class="btn-volver-submenu">

                ← Volver a módulos

            </a>


        </div>


    </main>



    <!-- ================================= -->
    <!-- CONFIRMACION CERRAR SESION        -->
    <!-- ================================= -->

    <div id="modalCerrarSesion"
         class="modal-fondo-sesion">


        <div class="modal-contenido-sesion">


            <div class="modal-icono-sesion">

                ?

            </div>


            <div class="modal-titulo-sesion">

                Confirmar acción

            </div>


            <div class="modal-texto-sesion">

                ¿Quieres cerrar sesión?

            </div>


            <div class="modal-botones-sesion">


                <button type="button"
                        class="btn-sesion-si"
                        onclick="confirmarCerrarSesion()">

                    Sí

                </button>


                <button type="button"
                        class="btn-sesion-no"
                        onclick="cerrarConfirmacionCerrarSesion()">

                    No

                </button>


            </div>


        </div>


    </div>



    <!-- ================================= -->
    <!-- FOOTER                            -->
    <!-- ================================= -->

    <footer class="footer">

        SARMedix · Sistema de Gestión Farmacéutica · SAR de Chiguay

    </footer>



    <script>

        // =========================================
        // ABRIR CONFIRMACION DE CIERRE
        // =========================================

        function abrirConfirmacionCerrarSesion() {

            const modal =
                document.getElementById(
                    "modalCerrarSesion"
                );


            if (modal) {

                modal.style.display =
                    "flex";

            }

        }



        // =========================================
        // NO - CONTINUAR EN EL SISTEMA
        // =========================================

        function cerrarConfirmacionCerrarSesion() {

            const modal =
                document.getElementById(
                    "modalCerrarSesion"
                );


            if (modal) {

                modal.style.display =
                    "none";

            }

        }



        // =========================================
        // SI - CERRAR SESION
        // =========================================

        function confirmarCerrarSesion() {

            const formulario =
                document.getElementById(
                    "formCerrarSesion"
                );


            if (formulario) {

                formulario.submit();

            }

        }

    </script>


</body>

</html>