<script>

    // =========================================================
    // BUSQUEDA Y FILTRO
    // =========================================================

    let busquedaControladosActual =
        "";


    let filtroControladosActual =
        "todos";



    function buscarMedicamentosControlados() {

        const buscador =
            document.getElementById(
                "buscadorControlados"
            );


        busquedaControladosActual =
            buscador
                ? buscador.value
                    .trim()
                    .toLowerCase()
                : "";


        aplicarVistaMedicamentosControlados();

    }



    document
        .getElementById(
            "buscadorControlados"
        )
        ?.addEventListener(
            "keydown",
            function (evento) {

                if (
                    evento.key
                    ===
                    "Enter"
                ) {

                    evento.preventDefault();

                    buscarMedicamentosControlados();

                }

            }
        );



    function aplicarFiltroControlados() {

        const select =
            document.getElementById(
                "filtroEstadoControlados"
            );


        filtroControladosActual =
            select
                ? select.value
                : "todos";


        aplicarVistaMedicamentosControlados();

    }



    function limpiarFiltroControlados() {

        filtroControladosActual =
            "todos";


        const select =
            document.getElementById(
                "filtroEstadoControlados"
            );


        if (select) {

            select.value =
                "todos";

        }


        aplicarVistaMedicamentosControlados();

    }



    function aplicarVistaMedicamentosControlados() {

        const filas =
            document.querySelectorAll(
                ".fila-medicamento-controlado"
            );


        let visibles =
            0;


        filas.forEach(
            function (fila) {

                const contenido =
                    fila.dataset.busqueda
                    ?? "";


                const coincideBusqueda =
                    contenido.includes(
                        busquedaControladosActual
                    );


                let coincideFiltro =
                    true;


                if (
                    filtroControladosActual
                    ===
                    "stock"
                ) {

                    coincideFiltro =
                        fila.dataset.stockBajo
                        ===
                        "true";

                }


                if (
                    filtroControladosActual
                    ===
                    "proximo"
                ) {

                    coincideFiltro =
                        fila.dataset.proximoVencer
                        ===
                        "true";

                }


                if (
                    filtroControladosActual
                    ===
                    "vencido"
                ) {

                    coincideFiltro =
                        fila.dataset.vencido
                        ===
                        "true";

                }


                const visible =
                    coincideBusqueda
                    &&
                    coincideFiltro;


                fila.style.display =
                    visible
                        ? "table-row"
                        : "none";


                const idProducto =
                    fila.dataset.producto;


                const detalle =
                    document.getElementById(
                        "detalle-controlado-"
                        +
                        idProducto
                    );


                if (!visible && detalle) {

                    detalle.style.display =
                        "none";


                    const boton =
                        fila.querySelector(
                            ".controlados-btn-lotes"
                        );


                    if (boton) {

                        boton.classList.remove(
                            "abierto"
                        );


                        boton.setAttribute(
                            "aria-expanded",
                            "false"
                        );

                    }


                    detalle
                        .querySelectorAll(
                            ".controlados-fila-historial"
                        )
                        .forEach(
                            function (historial) {

                                historial.style.display =
                                    "none";

                            }
                        );

                }


                if (visible) {

                    visibles++;

                }

            }
        );


        const cantidad =
            document.getElementById(
                "cantidadResultadosControlados"
            );


        if (cantidad) {

            cantidad.textContent =
                visibles;

        }


        const etiquetaBusqueda =
            document.getElementById(
                "etiquetaBusquedaControlados"
            );


        if (etiquetaBusqueda) {

            if (
                busquedaControladosActual
                !==
                ""
            ) {

                etiquetaBusqueda.textContent =
                    "Búsqueda: “"
                    +
                    busquedaControladosActual
                    +
                    "”";


                etiquetaBusqueda.style.display =
                    "inline-flex";

            }
            else {

                etiquetaBusqueda.style.display =
                    "none";

            }

        }


        const etiquetaFiltro =
            document.getElementById(
                "etiquetaFiltroControlados"
            );


        if (etiquetaFiltro) {

            if (
                filtroControladosActual
                ===
                "todos"
            ) {

                etiquetaFiltro.style.display =
                    "none";

            }
            else {

                let texto =
                    "";


                if (
                    filtroControladosActual
                    ===
                    "stock"
                ) {

                    texto =
                        "Stock bajo";

                }


                if (
                    filtroControladosActual
                    ===
                    "proximo"
                ) {

                    texto =
                        "Próximos a vencer";

                }


                if (
                    filtroControladosActual
                    ===
                    "vencido"
                ) {

                    texto =
                        "Vencidos";

                }


                etiquetaFiltro.textContent =
                    "Estado: "
                    +
                    texto;


                etiquetaFiltro.style.display =
                    "inline-flex";

            }

        }


        const sinResultados =
            document.getElementById(
                "sinResultadosControlados"
            );


        if (sinResultados) {

            sinResultados.style.display =
                visibles === 0
                    ? "table-row"
                    : "none";

        }

    }



    // =========================================================
    // LOTES
    // =========================================================

    function alternarLotesControlado(
        idProducto,
        boton
    ) {

        const detalle =
            document.getElementById(
                "detalle-controlado-"
                +
                idProducto
            );


        if (!detalle) {

            return;

        }


        const abierto =
            detalle.style.display
            ===
            "table-row";


        if (abierto) {

            detalle.style.display =
                "none";


            boton.classList.remove(
                "abierto"
            );


            boton.setAttribute(
                "aria-expanded",
                "false"
            );


            detalle
                .querySelectorAll(
                    ".controlados-fila-historial"
                )
                .forEach(
                    function (fila) {

                        fila.style.display =
                            "none";

                    }
                );


            detalle
                .querySelectorAll(
                    ".controlados-btn-historial"
                )
                .forEach(
                    function (botonHistorial) {

                        botonHistorial.classList.remove(
                            "activo"
                        );

                    }
                );

        }
        else {

            detalle.style.display =
                "table-row";


            boton.classList.add(
                "abierto"
            );


            boton.setAttribute(
                "aria-expanded",
                "true"
            );

        }

    }



    // =========================================================
    // HISTORIAL
    // =========================================================

    function alternarHistorialLote(
        idLote,
        boton
    ) {

        const fila =
            document.getElementById(
                "historial-lote-"
                +
                idLote
            );


        if (!fila) {

            return;

        }


        const abierto =
            fila.style.display
            ===
            "table-row";


        if (abierto) {

            fila.style.display =
                "none";


            boton.classList.remove(
                "activo"
            );


            boton.setAttribute(
                "aria-expanded",
                "false"
            );


            return;

        }


        const tabla =
            boton.closest(
                ".controlados-subtabla"
            );


        if (tabla) {

            tabla
                .querySelectorAll(
                    ".controlados-fila-historial"
                )
                .forEach(
                    function (otraFila) {

                        if (
                            otraFila
                            !==
                            fila
                        ) {

                            otraFila.style.display =
                                "none";

                        }

                    }
                );


            tabla
                .querySelectorAll(
                    ".controlados-btn-historial"
                )
                .forEach(
                    function (otroBoton) {

                        if (
                            otroBoton
                            !==
                            boton
                        ) {

                            otroBoton.classList.remove(
                                "activo"
                            );


                            otroBoton.setAttribute(
                                "aria-expanded",
                                "false"
                            );

                        }

                    }
                );

        }


        fila.style.display =
            "table-row";


        boton.classList.add(
            "activo"
        );


        boton.setAttribute(
            "aria-expanded",
            "true"
        );

    }



    // =========================================================
    // LIMPIAR ERRORES
    // =========================================================

    function limpiarErroresMovimiento() {

        const alerta =
            document.getElementById(
                "mensajeErrorMovimiento"
            );


        if (alerta) {

            alerta.style.display =
                "none";


            alerta.textContent =
                "";

        }


        const cantidad =
            document.getElementById(
                "movimientoCantidad"
            );


        const observacion =
            document.getElementById(
                "movimientoObservacion"
            );


        cantidad
            ?.classList
            .remove(
                "error"
            );


        observacion
            ?.classList
            .remove(
                "error"
            );

    }



    // =========================================================
    // MENSAJE GENERAL
    // =========================================================

    function mostrarErrorGeneralMovimiento(
        mensaje
    ) {

        const alerta =
            document.getElementById(
                "mensajeErrorMovimiento"
            );


        if (!alerta) {

            return;

        }


        alerta.textContent =
            mensaje;


        alerta.style.display =
            "block";

    }



    // =========================================================
    // ABRIR MODAL MOVIMIENTO
    // =========================================================

    function abrirModalMovimiento(
        boton
    ) {

        const modal =
            document.getElementById(
                "modalMovimientoControlado"
            );


        if (!modal) {

            return;

        }


        const idLote =
            boton.dataset.idLote;


        const tipo =
            boton.dataset.tipo;


        const medicamento =
            boton.dataset.medicamento;


        const lote =
            boton.dataset.lote;


        const stock =
            parseInt(
                boton.dataset.stock
                ??
                "0"
            );


        limpiarErroresMovimiento();


        document.getElementById(
            "movimientoIdLote"
        ).value =
            idLote;


        document.getElementById(
            "movimientoTipo"
        ).value =
            tipo;


        document.getElementById(
            "movimientoStockActual"
        ).value =
            stock;


        document.getElementById(
            "modalMedicamento"
        ).textContent =
            medicamento;


        document.getElementById(
            "modalLote"
        ).textContent =
            lote;


        document.getElementById(
            "modalStock"
        ).textContent =
            stock;


        document.getElementById(
            "modalMovimientoEtiqueta"
        ).textContent =
            tipo.toUpperCase();


        document.getElementById(
            "modalMovimientoTitulo"
        ).textContent =
            tipo === "Salida"
                ? "Registrar salida"
                : "Registrar entrada";


        const cantidad =
            document.getElementById(
                "movimientoCantidad"
            );


        cantidad.value =
            "";


        cantidad.min =
            "1";


        if (tipo === "Salida") {

            cantidad.max =
                stock;


            document.getElementById(
                "movimientoAyudaCantidad"
            ).textContent =
                "Máximo disponible en este lote: "
                +
                stock
                +
                " unidades.";

        }
        else {

            cantidad.removeAttribute(
                "max"
            );


            document.getElementById(
                "movimientoAyudaCantidad"
            ).textContent =
                "Ingresa la cantidad que ingresará al lote.";

        }


        const observacion =
            document.getElementById(
                "movimientoObservacion"
            );


        observacion.value =
            "";


        document.getElementById(
            "contadorObservacion"
        ).textContent =
            "0";


        const confirmar =
            document.getElementById(
                "btnConfirmarMovimiento"
            );


        confirmar.disabled =
            false;


        confirmar.textContent =
            tipo === "Salida"
                ? "Registrar salida"
                : "Registrar entrada";


        if (tipo === "Salida") {

            confirmar.classList.add(
                "salida"
            );

        }
        else {

            confirmar.classList.remove(
                "salida"
            );

        }


        modal.style.display =
            "flex";


        setTimeout(
            function () {

                cantidad.focus();

            },
            50
        );

    }



    // =========================================================
    // VALIDAR FORMULARIO
    // =========================================================

    function validarFormularioMovimiento() {

        limpiarErroresMovimiento();


        let valido =
            true;


        let primerError =
            "";


        const tipo =
            document.getElementById(
                "movimientoTipo"
            ).value;


        const cantidadInput =
            document.getElementById(
                "movimientoCantidad"
            );


        const observacionInput =
            document.getElementById(
                "movimientoObservacion"
            );


        const stockActual =
            parseInt(
                document.getElementById(
                    "movimientoStockActual"
                ).value
                ??
                "0"
            );


        const cantidad =
            parseInt(
                cantidadInput.value
                ??
                "0"
            );


        const observacion =
            observacionInput.value
                .trim();



        // CANTIDAD

        if (
            !cantidadInput.value
            ||
            isNaN(cantidad)
            ||
            cantidad <= 0
        ) {

            valido =
                false;


            cantidadInput.classList.add(
                "error"
            );


            primerError =
                "Debe ingresar una cantidad válida.";

        }



        // SALIDA MAYOR AL STOCK

        if (
            cantidadInput.value
            &&
            !isNaN(cantidad)
            &&
            tipo === "Salida"
            &&
            cantidad > stockActual
        ) {

            valido =
                false;


            cantidadInput.classList.add(
                "error"
            );


            if (primerError === "") {

                primerError =
                    "La cantidad no puede ser mayor al stock disponible.";

            }

        }



        // OBSERVACION

        if (observacion === "") {

            valido =
                false;


            observacionInput.classList.add(
                "error"
            );


            if (primerError === "") {

                primerError =
                    "Debe ingresar el motivo u observación.";

            }

        }



        if (!valido) {

            mostrarErrorGeneralMovimiento(
                primerError
            );

        }


        return valido;

    }



    // =========================================================
    // CERRAR MODAL MOVIMIENTO
    // =========================================================

    function cerrarModalMovimiento() {

        const modal =
            document.getElementById(
                "modalMovimientoControlado"
            );


        if (modal) {

            modal.style.display =
                "none";

        }


        limpiarErroresMovimiento();


        const confirmacion =
            document.getElementById(
                "modalConfirmacionMovimiento"
            );


        if (confirmacion) {

            confirmacion.style.display =
                "none";

        }

    }



    // =========================================================
    // OBSERVACION
    // =========================================================

    document
        .getElementById(
            "movimientoObservacion"
        )
        ?.addEventListener(
            "input",
            function () {

                document.getElementById(
                    "contadorObservacion"
                ).textContent =
                    this.value.length;


                this.classList.remove(
                    "error"
                );

            }
        );



    // =========================================================
    // CANTIDAD
    // =========================================================

    document
        .getElementById(
            "movimientoCantidad"
        )
        ?.addEventListener(
            "input",
            function () {

                this.classList.remove(
                    "error"
                );

            }
        );



    // =========================================================
    // ABRIR CONFIRMACION
    // =========================================================

    function abrirConfirmacionMovimiento() {

        const modal =
            document.getElementById(
                "modalConfirmacionMovimiento"
            );


        const mensaje =
            document.getElementById(
                "mensajeConfirmacionMovimiento"
            );


        const tipo =
            document.getElementById(
                "movimientoTipo"
            )?.value
            ??
            "";


        if (
            !modal
            ||
            !mensaje
        ) {

            return;

        }


        mensaje.textContent =
            tipo === "Salida"
                ? "¿Quieres registrar esta salida?"
                : "¿Quieres registrar esta entrada?";


        modal.style.display =
            "flex";

    }



    // =========================================================
    // NO
    //
    // Cierra solamente la confirmacion.
    // Los datos escritos siguen en el formulario.
    // =========================================================

    function cerrarConfirmacionMovimiento() {

        const modal =
            document.getElementById(
                "modalConfirmacionMovimiento"
            );


        if (modal) {

            modal.style.display =
                "none";

        }

    }



    // =========================================================
    // CANCELAR
    //
    // Cierra la confirmacion y también el movimiento completo.
    // =========================================================

    function cancelarConfirmacionMovimiento() {

        cerrarConfirmacionMovimiento();


        cerrarModalMovimiento();

    }



    // =========================================================
    // SI
    //
    // Ahora sí enviamos el formulario al controlador.
    // =========================================================

    function confirmarMovimientoControlado() {

        const formulario =
            document.getElementById(
                "formMovimientoControlado"
            );


        const boton =
            document.getElementById(
                "btnConfirmarMovimiento"
            );


        if (!formulario) {

            return;

        }


        cerrarConfirmacionMovimiento();


        if (boton) {

            boton.disabled =
                true;


            boton.textContent =
                "Registrando...";

        }


        /*
            submit() se usa aquí intencionalmente.

            La validación ya se realizó antes de abrir
            la confirmación y el usuario acaba de presionar Sí.
        */

        formulario.submit();

    }



    // =========================================================
    // INTENTO DE ENVIO
    //
    // Antes se enviaba inmediatamente.
    //
    // Ahora:
    //
    // 1. valida
    // 2. abre confirmación
    // 3. solo "Sí" registra el movimiento
    // =========================================================

    document
        .getElementById(
            "formMovimientoControlado"
        )
        ?.addEventListener(
            "submit",
            function (evento) {

                evento.preventDefault();


                if (!validarFormularioMovimiento()) {

                    return;

                }


                abrirConfirmacionMovimiento();

            }
        );



    // =========================================================
    // CERRAR MODAL MOVIMIENTO PRESIONANDO EL FONDO
    // =========================================================

    document
        .getElementById(
            "modalMovimientoControlado"
        )
        ?.addEventListener(
            "click",
            function (evento) {

                if (evento.target === this) {

                    cerrarModalMovimiento();

                }

            }
        );



    // =========================================================
    // CERRAR CONFIRMACION PRESIONANDO EL FONDO
    // =========================================================

    document
        .getElementById(
            "modalConfirmacionMovimiento"
        )
        ?.addEventListener(
            "click",
            function (evento) {

                if (evento.target === this) {

                    cerrarConfirmacionMovimiento();

                }

            }
        );



    // =========================================================
    // ESC
    // =========================================================

    document.addEventListener(
        "keydown",
        function (evento) {

            if (evento.key !== "Escape") {

                return;

            }


            const confirmacion =
                document.getElementById(
                    "modalConfirmacionMovimiento"
                );


            if (
                confirmacion
                &&
                confirmacion.style.display === "flex"
            ) {

                cerrarConfirmacionMovimiento();


                return;

            }


            cerrarModalMovimiento();

        }
    );

</script>