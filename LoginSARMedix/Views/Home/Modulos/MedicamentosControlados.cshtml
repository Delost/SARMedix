<div id="modalMovimientoControlado"
     class="mc-overlay">

    <div class="mc-modal">


        <!-- BOTON CERRAR -->

        <button type="button"
                class="mc-cerrar"
                onclick="cerrarModalMovimiento()">

            ×

        </button>



        <!-- CABECERA -->

        <div id="mcCabeceraUnica"
             class="mc-cabecera">

            <span id="modalMovimientoEtiqueta"
                  class="mc-etiqueta">

                ENTRADA

            </span>


            <div id="modalMovimientoIcono"
                 class="mc-icono"
                 aria-hidden="true">
            </div>


            <h2 id="modalMovimientoTitulo"
                class="mc-titulo">

                Registrar entrada

            </h2>


            <p class="mc-subtitulo">
                SAR de Chiguay
            </p>

        </div>



        <!-- ERROR -->

        <div id="mensajeErrorMovimiento"
             class="mc-error-general"
             style="display:none;">
        </div>



        <!-- INFORMACION -->

        <div class="mc-info">

            <div>

                <span>
                    Medicamento
                </span>

                <strong id="modalMedicamento">
                    -
                </strong>

            </div>


            <div>

                <span>
                    Lote
                </span>

                <strong id="modalLote">
                    -
                </strong>

            </div>


            <div>

                <span>
                    Stock actual
                </span>

                <strong id="modalStock">
                    0
                </strong>

            </div>

        </div>



        <!-- FORMULARIO -->

        <form asp-controller="Home"
              asp-action="RegistrarMovimientoControlado"
              method="post"
              id="formMovimientoControlado"
              novalidate>

            @Html.AntiForgeryToken()


            <input type="hidden"
                   id="movimientoIdLote"
                   name="idLote" />


            <input type="hidden"
                   id="movimientoTipo"
                   name="tipoMovimiento" />


            <input type="hidden"
                   id="movimientoStockActual"
                   value="0" />



            <!-- CANTIDAD -->

            <div class="mc-campo">

                <label for="movimientoCantidad">
                    Cantidad
                </label>


                <input type="number"
                       id="movimientoCantidad"
                       name="cantidad"
                       min="1"
                       step="1"
                       class="mc-input"
                       required />


                <small id="movimientoAyudaCantidad">

                    Ingresa la cantidad que ingresará al lote.

                </small>

            </div>



            <!-- MOTIVO -->

            <div class="mc-campo">

                <label for="movimientoObservacion">

                    Motivo / observación

                </label>


                <textarea id="movimientoObservacion"
                          name="observacion"
                          maxlength="255"
                          rows="4"
                          class="mc-input"
                          placeholder="Indique el motivo o detalle del movimiento..."
                          required></textarea>


                <div class="mc-contador">

                    <span id="contadorObservacion">
                        0
                    </span>/255

                </div>

            </div>



            <!-- BOTONES -->

            <div class="mc-botones">

                <button type="button"
                        class="mc-btn-cancelar"
                        onclick="cerrarModalMovimiento()">

                    Cancelar

                </button>


                <button type="submit"
                        id="btnConfirmarMovimiento"
                        class="mc-btn-confirmar">

                    Registrar entrada

                </button>

            </div>


        </form>

    </div>

</div>



<!-- =============================================================
     MODAL CONFIRMACION
     ============================================================= -->

<div id="modalConfirmacionMovimiento"
     class="mcc-overlay">

    <div class="mcc-modal">


        <div class="mcc-icono">

