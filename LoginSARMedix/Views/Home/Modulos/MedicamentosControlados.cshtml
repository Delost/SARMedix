@using LoginSARMedix.Models
@model List<Producto>

@{
    ViewData["Title"] = "Medicamentos Controlados";
    ViewData["TituloBarra"] = "Medicamentos Controlados";

    var medicamentos =
        Model ?? new List<Producto>();

    var lotesControlados =
        ViewBag.LotesControlados as List<Lote>
        ?? new List<Lote>();

    var movimientosControlados =
        ViewBag.MovimientosControlados as List<MovimientoControladoHistorial>
        ?? new List<MovimientoControladoHistorial>();

    int totalMedicamentos =
        medicamentos.Count;

    int totalLotes =
        lotesControlados.Count;

    int stockRegistrado =
        lotesControlados.Sum(
            l => l.cantidad_actual
        );

    DateTime hoy =
        DateTime.Today;

    DateTime fechaLimiteProximo =
        hoy.AddDays(30);

    int totalStockBajo =
        medicamentos.Count(
            medicamento =>
            {
                int stock =
                    lotesControlados
                        .Where(
                            l =>
                                l.id_producto
                                ==
                                medicamento.id_producto
                        )
                        .Sum(
                            l => l.cantidad_actual
                        );

                return
                    stock
                    <=
                    medicamento.stock_minimo;
            }
        );

    int totalProximosAVencer =
        medicamentos.Count(
            medicamento =>
                lotesControlados
                    .Where(
                        l =>
                            l.id_producto
                            ==
                            medicamento.id_producto
                    )
                    .Any(
                        lote =>
                            lote.fecha_vencimiento.HasValue
                            &&
                            lote.fecha_vencimiento.Value.Date >= hoy
                            &&
                            lote.fecha_vencimiento.Value.Date <= fechaLimiteProximo
                    )
        );

    int totalVencidos =
        medicamentos.Count(
            medicamento =>
                lotesControlados
                    .Where(
                        l =>
                            l.id_producto
                            ==
                            medicamento.id_producto
                    )
                    .Any(
                        lote =>
                            lote.fecha_vencimiento.HasValue
                            &&
                            lote.fecha_vencimiento.Value.Date < hoy
                    )
        );

    string mensaje =
        TempData["Mensaje"]?.ToString()
        ?? "";

    string tipoMensaje =
        TempData["TipoMensaje"]?.ToString()
        ?? "";
}


<div class="controlados-pagina">


    <!-- =========================================================
         ENCABEZADO
         ========================================================= -->

    <section class="controlados-encabezado">

        <span class="controlados-etiqueta">
            Acceso restringido
        </span>

        <h1>
            Medicamentos Controlados
        </h1>

        <p>
            Consulta los medicamentos que requieren control,
            su stock registrado y realiza movimientos de
            entrada o salida por lote.
        </p>

    </section>



    <!-- =========================================================
         MENSAJE GENERAL
         ========================================================= -->

    @if (!string.IsNullOrWhiteSpace(mensaje))
    {
        <div class="controlados-mensaje
                    @(tipoMensaje == "exito"
                        ? "controlados-mensaje-exito"
                        : "controlados-mensaje-error")">

            <span class="controlados-mensaje-icono">

                @(tipoMensaje == "exito"
                    ? "✓"
                    : "!")

            </span>

            <span>
                @mensaje
            </span>

        </div>
    }



    <!-- =========================================================
         RESUMEN
         ========================================================= -->

    <section class="controlados-resumen">

        <article class="controlados-resumen-tarjeta">

            <span class="controlados-resumen-icono">
                💊
            </span>

            <div>

                <span class="controlados-resumen-numero">
                    @totalMedicamentos
                </span>

                <span class="controlados-resumen-texto">
                    Medicamentos controlados
                </span>

            </div>

        </article>


        <article class="controlados-resumen-tarjeta">

            <span class="controlados-resumen-icono">
                📦
            </span>

            <div>

                <span class="controlados-resumen-numero">
                    @totalLotes
                </span>

                <span class="controlados-resumen-texto">
                    Lotes registrados
                </span>

            </div>

        </article>


        <article class="controlados-resumen-tarjeta">

            <span class="controlados-resumen-icono">
                #️⃣
            </span>

            <div>

                <span class="controlados-resumen-numero">
                    @stockRegistrado
                </span>

                <span class="controlados-resumen-texto">
                    Unidades registradas
                </span>

            </div>

        </article>

    </section>



    <!-- =========================================================
         PANEL PRINCIPAL
         ========================================================= -->

    <section class="controlados-panel">


        <!-- =====================================================
             BUSCADOR Y FILTRO
             ===================================================== -->

        <div class="controlados-herramientas">


            <!-- BUSCADOR -->

            <div class="controlados-form-busqueda">

                <div class="controlados-buscador">

                    <svg viewBox="0 0 24 24"
                         aria-hidden="true">

                        <circle cx="11"
                                cy="11"
                                r="7">
                        </circle>

                        <path d="M20 20L16.5 16.5">
                        </path>

                    </svg>

                    <input type="text"
                           id="buscadorControlados"
                           placeholder="Buscar por código, medicamento, principio activo o concentración..."
                           autocomplete="off" />

                </div>


                <button type="button"
                        class="controlados-btn-buscar"
                        onclick="buscarMedicamentosControlados()">

                    Buscar

                </button>

            </div>



            <!-- FILTRO -->

            <div class="controlados-form-filtros">

                <div class="controlados-filtro-campo">

                    <label for="filtroEstadoControlados">
                        Estado
                    </label>

                    <select id="filtroEstadoControlados">

                        <option value="todos">
                            Todos los estados
                        </option>

                        <option value="stock">
                            Stock bajo (@totalStockBajo)
                        </option>

                        <option value="proximo">
                            Próximos a vencer (@totalProximosAVencer)
                        </option>

                        <option value="vencido">
                            Vencidos (@totalVencidos)
                        </option>

                    </select>

                </div>


                <button type="button"
                        class="controlados-btn-aplicar"
                        onclick="aplicarFiltroControlados()">

                    Aplicar

                </button>


                <button type="button"
                        class="controlados-btn-limpiar"
                        onclick="limpiarFiltroControlados()">

                    Limpiar

                </button>

            </div>

        </div>



        <!-- =====================================================
             RESULTADOS
             ===================================================== -->

        <div class="controlados-resumen-filtros">

            <span>

                Medicamentos encontrados:

                <strong id="cantidadResultadosControlados">
                    @totalMedicamentos
                </strong>

            </span>


            <span id="etiquetaBusquedaControlados"
                  class="controlados-filtro-activo-texto"
                  style="display:none;">
            </span>


            <span id="etiquetaFiltroControlados"
                  class="controlados-filtro-activo-texto"
                  style="display:none;">
            </span>

        </div>



        <!-- =====================================================
             TABLA
             ===================================================== -->

        <div class="controlados-tabla-contenedor">

            <table class="controlados-tabla">

                <thead>

                    <tr>

                        <th>
                            Código
                        </th>

                        <th>
                            Medicamento
                        </th>

                        <th>
                            Principio activo
                        </th>

                        <th>
                            Concentración
                        </th>

                        <th class="controlados-columna-centro">
                            Lotes
                        </th>

                        <th class="controlados-columna-centro">
                            Stock
                        </th>

                        <th class="controlados-columna-centro">
                            Estado
                        </th>

                        <th class="controlados-columna-centro">
                            Acción
                        </th>

                    </tr>

                </thead>


                <tbody id="cuerpoMedicamentosControlados">


                    @if (medicamentos.Count == 0)
                    {
                        <tr>

                            <td colspan="8"
                                class="controlados-vacio">

                                <div class="controlados-vacio-icono">
                                    💊
                                </div>

                                <strong>
                                    No hay medicamentos controlados registrados
                                </strong>

                                <span>
                                    Los medicamentos marcados como
                                    "requiere control" aparecerán aquí.
                                </span>

                            </td>

                        </tr>
                    }



                    @if (medicamentos.Count > 0)
                    {
                        @foreach (var medicamento in medicamentos)
                        {
                            var lotesMedicamento =
                                lotesControlados
                                    .Where(
                                        l =>
                                            l.id_producto
                                            ==
                                            medicamento.id_producto
                                    )
                                    .OrderBy(
                                        l => l.fecha_vencimiento
                                    )
                                    .ToList();


                            int stockMedicamento =
                                lotesMedicamento.Sum(
                                    l => l.cantidad_actual
                                );


                            bool stockBajo =
                                stockMedicamento
                                <=
                                medicamento.stock_minimo;


                            bool tieneLotesVencidos =
                                lotesMedicamento.Any(
                                    lote =>
                                        lote.fecha_vencimiento.HasValue
                                        &&
                                        lote.fecha_vencimiento.Value.Date
                                        <
                                        hoy
                                );


                            bool tieneLotesProximos =
                                lotesMedicamento.Any(
                                    lote =>
                                        lote.fecha_vencimiento.HasValue
                                        &&
                                        lote.fecha_vencimiento.Value.Date
                                        >=
                                        hoy
                                        &&
                                        lote.fecha_vencimiento.Value.Date
                                        <=
                                        fechaLimiteProximo
                                );


                            string textoBusqueda =
                                (
                                    (medicamento.codigo_interno ?? "")
                                    + " "
                                    + (medicamento.nombre ?? "")
                                    + " "
                                    + (medicamento.principio_activo ?? "")
                                    + " "
                                    + (medicamento.concentracion ?? "")
                                )
                                .ToLowerInvariant();



                            <!-- =========================================
                                 FILA DEL MEDICAMENTO
                                 ========================================= -->

                            <tr class="fila-medicamento-controlado"
                                data-busqueda="@textoBusqueda"
                                data-producto="@medicamento.id_producto"
                                data-stock-bajo="@(stockBajo ? "true" : "false")"
                                data-proximo-vencer="@(tieneLotesProximos ? "true" : "false")"
                                data-vencido="@(tieneLotesVencidos ? "true" : "false")">


                                <td>

                                    <span class="controlados-codigo">

                                        @(medicamento.codigo_interno ?? "-")

                                    </span>

                                </td>



                                <td>

                                    <div class="controlados-medicamento">

                                        @if (!string.IsNullOrWhiteSpace(
                                                medicamento.imagen_url))
                                        {
                                            <img src="@medicamento.imagen_url"
                                                 alt="Imagen de @medicamento.nombre"
                                                 class="controlados-imagen" />
                                        }


                                        @if (string.IsNullOrWhiteSpace(
                                                medicamento.imagen_url))
                                        {
                                            <div class="controlados-imagen-vacia">
                                                💊
                                            </div>
                                        }


                                        <span>
                                            @(medicamento.nombre ?? "-")
                                        </span>

                                    </div>

                                </td>



                                <td>

                                    @(medicamento.principio_activo ?? "-")

                                </td>



                                <td>

                                    @(medicamento.concentracion ?? "-")

                                </td>



                                <td class="controlados-columna-centro">

                                    @lotesMedicamento.Count

                                </td>



                                <td class="controlados-columna-centro">

                                    <strong>

                                        @stockMedicamento

                                    </strong>

                                </td>



                                <td class="controlados-columna-centro">

                                    @if (stockBajo)
                                    {
                                        <span class="controlados-estado
                                                     controlados-estado-alerta">

                                            Stock bajo

                                        </span>
                                    }


                                    @if (!stockBajo)
                                    {
                                        <span class="controlados-estado
                                                     controlados-estado-correcto">

                                            Stock OK

                                        </span>
                                    }

                                </td>



                                <td class="controlados-columna-centro">

                                    <button type="button"
                                            class="controlados-btn-lotes"
                                            onclick="alternarLotesControlado(
                                                @medicamento.id_producto,
                                                this
                                            )"
                                            aria-expanded="false">

                                        <span>
                                            Ver lotes
                                        </span>

                                        <span class="controlados-btn-flecha">
                                            ▼
                                        </span>

                                    </button>

                                </td>

                            </tr>



                            <!-- =========================================
                                 DETALLE LOTES
                                 ========================================= -->

                            <tr id="detalle-controlado-@medicamento.id_producto"
                                class="fila-detalle-controlado">

                                <td colspan="8">

                                    <div class="controlados-detalle">


                                        <div class="controlados-detalle-cabecera">

                                            <div>

                                                <strong>

                                                    Lotes de
                                                    @(medicamento.nombre ?? "medicamento")

                                                </strong>

                                                <span>

                                                    Stock mínimo:
                                                    @medicamento.stock_minimo

                                                </span>

                                            </div>

                                        </div>



                                        @if (lotesMedicamento.Count == 0)
                                        {
                                            <div class="controlados-sin-lotes">

                                                Este medicamento todavía
                                                no tiene lotes registrados.

                                            </div>
                                        }



                                        @if (lotesMedicamento.Count > 0)
                                        {
                                            <div class="controlados-subtabla-contenedor">

                                                <table class="controlados-subtabla">

                                                    <thead>

                                                        <tr>

                                                            <th>
                                                                N.º de lote
                                                            </th>

                                                            <th>
                                                                Vencimiento
                                                            </th>

                                                            <th>
                                                                Cantidad
                                                            </th>

                                                            <th>
                                                                Ubicación
                                                            </th>

                                                            <th>
                                                                Estado
                                                            </th>

                                                            <th class="controlados-columna-centro">
                                                                Movimiento
                                                            </th>

                                                        </tr>

                                                    </thead>


                                                    <tbody>


                                                        @foreach (var lote in lotesMedicamento)
                                                        {
                                                            bool vencido =
                                                                lote.fecha_vencimiento.HasValue
                                                                &&
                                                                lote.fecha_vencimiento.Value.Date
                                                                <
                                                                DateTime.Today;


                                                            bool proximoAVencer =
                                                                lote.fecha_vencimiento.HasValue
                                                                &&
                                                                !vencido
                                                                &&
                                                                lote.fecha_vencimiento.Value.Date
                                                                <=
                                                                DateTime.Today.AddDays(30);


                                                            var movimientosLote =
                                                                movimientosControlados
                                                                    .Where(
                                                                        m =>
                                                                            m.id_lote
                                                                            ==
                                                                            lote.id_lote
                                                                    )
                                                                    .OrderByDescending(
                                                                        m => m.fecha_hora
                                                                    )
                                                                    .ThenByDescending(
                                                                        m => m.id_movimiento
                                                                    )
                                                                    .ToList();



                                                            <!-- FILA LOTE -->

                                                            <tr>


                                                                <td>

                                                                    @(lote.numero_lote ?? "-")

                                                                </td>



                                                                <td>

                                                                    @(
                                                                        lote.fecha_vencimiento.HasValue
                                                                            ? lote.fecha_vencimiento.Value.ToString("dd/MM/yyyy")
                                                                            : "-"
                                                                    )

                                                                </td>



                                                                <td>

                                                                    <strong>

                                                                        @lote.cantidad_actual

                                                                    </strong>

                                                                </td>



                                                                <td>

                                                                    @(lote.nombre_ubicacion ?? "-")

                                                                </td>



                                                                <td>


                                                                    @if (vencido)
                                                                    {
                                                                        <span class="controlados-lote-estado
                                                                                     controlados-lote-vencido">

                                                                            Vencido

                                                                        </span>
                                                                    }


                                                                    @if (!vencido &&
                                                                         proximoAVencer)
                                                                    {
                                                                        <span class="controlados-lote-estado
                                                                                     controlados-lote-proximo">

                                                                            Próximo a vencer

                                                                        </span>
                                                                    }


                                                                    @if (!vencido &&
                                                                         !proximoAVencer)
                                                                    {
                                                                        <span class="controlados-lote-estado
                                                                                     controlados-lote-vigente">

                                                                            Vigente

                                                                        </span>
                                                                    }


                                                                </td>



                                                                <td class="controlados-columna-centro">

                                                                    <div class="controlados-acciones-movimiento">


                                                                        <!-- ENTRADA -->

                                                                        <button type="button"
                                                                                class="controlados-btn-movimiento
                                                                                       controlados-btn-entrada"
                                                                                data-id-lote="@lote.id_lote"
                                                                                data-tipo="Entrada"
                                                                                data-medicamento="@(medicamento.nombre ?? "")"
                                                                                data-lote="@(lote.numero_lote ?? "")"
                                                                                data-stock="@lote.cantidad_actual"
                                                                                onclick="abrirModalMovimiento(this)">

                                                                            + Entrada

                                                                        </button>



                                                                        <!-- SALIDA -->

                                                                        @if (lote.cantidad_actual > 0)
                                                                        {
                                                                            <button type="button"
                                                                                    class="controlados-btn-movimiento
                                                                                           controlados-btn-salida"
                                                                                    data-id-lote="@lote.id_lote"
                                                                                    data-tipo="Salida"
                                                                                    data-medicamento="@(medicamento.nombre ?? "")"
                                                                                    data-lote="@(lote.numero_lote ?? "")"
                                                                                    data-stock="@lote.cantidad_actual"
                                                                                    onclick="abrirModalMovimiento(this)">

                                                                                − Salida

                                                                            </button>
                                                                        }


                                                                        @if (lote.cantidad_actual <= 0)
                                                                        {
                                                                            <button type="button"
                                                                                    class="controlados-btn-movimiento
                                                                                           controlados-btn-salida"
                                                                                    disabled>

                                                                                − Salida

                                                                            </button>
                                                                        }



                                                                        <!-- HISTORIAL -->

                                                                        <button type="button"
                                                                                class="controlados-btn-movimiento
                                                                                       controlados-btn-historial"
                                                                                onclick="alternarHistorialLote(
                                                                                    @lote.id_lote,
                                                                                    this
                                                                                )"
                                                                                aria-expanded="false">

                                                                            <span>
                                                                                ◷ Historial
                                                                            </span>

                                                                            <span class="controlados-historial-contador">

                                                                                @movimientosLote.Count

                                                                            </span>

                                                                        </button>


                                                                    </div>

                                                                </td>

                                                            </tr>



                                                            <!-- =========================================
                                                                 HISTORIAL DEL LOTE
                                                                 ========================================= -->

                                                            <tr id="historial-lote-@lote.id_lote"
                                                                class="controlados-fila-historial">

                                                                <td colspan="6">

                                                                    <div class="controlados-historial-lote">


                                                                        <div class="controlados-historial-cabecera">

                                                                            <div>

                                                                                <span class="controlados-historial-etiqueta">

                                                                                    Trazabilidad

                                                                                </span>

                                                                                <strong>

                                                                                    Historial del lote
                                                                                    @(lote.numero_lote ?? "-")

                                                                                </strong>

                                                                            </div>


                                                                            <span class="controlados-historial-total">

                                                                                @movimientosLote.Count

                                                                                @(movimientosLote.Count == 1
                                                                                    ? "movimiento"
                                                                                    : "movimientos")

                                                                            </span>

                                                                        </div>



                                                                        @if (movimientosLote.Count == 0)
                                                                        {
                                                                            <div class="controlados-historial-vacio">

                                                                                <span class="controlados-historial-vacio-icono">
                                                                                    ◷
                                                                                </span>

                                                                                <div>

                                                                                    <strong>

                                                                                        Este lote todavía
                                                                                        no registra movimientos.

                                                                                    </strong>

                                                                                    <span>

                                                                                        Las entradas y salidas
                                                                                        aparecerán aquí
                                                                                        automáticamente.

                                                                                    </span>

                                                                                </div>

                                                                            </div>
                                                                        }



                                                                        @if (movimientosLote.Count > 0)
                                                                        {
                                                                            <div class="controlados-historial-tabla-contenedor">

                                                                                <table class="controlados-historial-tabla">

                                                                                    <thead>

                                                                                        <tr>

                                                                                            <th>
                                                                                                Fecha y hora
                                                                                            </th>

                                                                                            <th>
                                                                                                Tipo
                                                                                            </th>

                                                                                            <th>
                                                                                                Cantidad
                                                                                            </th>

                                                                                            <th>
                                                                                                Stock
                                                                                            </th>

                                                                                            <th>
                                                                                                Responsable
                                                                                            </th>

                                                                                            <th>
                                                                                                Motivo
                                                                                            </th>

                                                                                        </tr>

                                                                                    </thead>


                                                                                    <tbody>


                                                                                        @foreach (var movimiento in movimientosLote)
                                                                                        {
                                                                                            bool esEntrada =
                                                                                                string.Equals(
                                                                                                    movimiento.tipo_movimiento,
                                                                                                    "Entrada",
                                                                                                    StringComparison.OrdinalIgnoreCase
                                                                                                );


                                                                                            <tr>


                                                                                                <td>

                                                                                                    <div class="controlados-historial-fecha">

                                                                                                        <strong>

                                                                                                            @(movimiento.fecha_hora.ToString("dd/MM/yyyy"))

                                                                                                        </strong>

                                                                                                        <span>

                                                                                                            @(movimiento.fecha_hora.ToString("HH:mm:ss"))

                                                                                                        </span>

                                                                                                    </div>

                                                                                                </td>



                                                                                                <td>

                                                                                                    <span class="controlados-historial-tipo
                                                                                                                 @(esEntrada
                                                                                                                    ? "controlados-historial-entrada"
                                                                                                                    : "controlados-historial-salida")">

                                                                                                        @(esEntrada
                                                                                                            ? "↑ Entrada"
                                                                                                            : "↓ Salida")

                                                                                                    </span>

                                                                                                </td>



                                                                                                <td>

                                                                                                    <strong class="@(esEntrada
                                                                                                                        ? "controlados-cantidad-entrada"
                                                                                                                        : "controlados-cantidad-salida")">

                                                                                                        @(
                                                                                                            (esEntrada
                                                                                                                ? "+"
                                                                                                                : "-")
                                                                                                            +
                                                                                                            movimiento.cantidad
                                                                                                        )

                                                                                                    </strong>

                                                                                                </td>



                                                                                                <td>

                                                                                                    <span class="controlados-stock-cambio">

                                                                                                        @movimiento.stock_anterior

                                                                                                        <strong>
                                                                                                            →
                                                                                                        </strong>

                                                                                                        @movimiento.stock_resultante

                                                                                                    </span>

                                                                                                </td>



                                                                                                <td>

                                                                                                    <div class="controlados-historial-responsable">

                                                                                                        <span>
                                                                                                            👤
                                                                                                        </span>

                                                                                                        <strong>

                                                                                                            @(movimiento.usuario_responsable
                                                                                                                ?? "Usuario no disponible")

                                                                                                        </strong>

                                                                                                    </div>

                                                                                                </td>



                                                                                                <td>

                                                                                                    <span class="controlados-historial-motivo">

                                                                                                        @(movimiento.observacion ?? "-")

                                                                                                    </span>

                                                                                                </td>


                                                                                            </tr>
                                                                                        }


                                                                                    </tbody>

                                                                                </table>

                                                                            </div>
                                                                        }


                                                                    </div>

                                                                </td>

                                                            </tr>
                                                        }


                                                    </tbody>

                                                </table>

                                            </div>
                                        }


                                    </div>

                                </td>

                            </tr>
                        }



                        <!-- =================================================
                             SIN RESULTADOS
                             ================================================= -->

                        <tr id="sinResultadosControlados"
                            class="controlados-sin-resultados">

                            <td colspan="8">

                                <div class="controlados-sin-resultados-contenido">

                                    <span>
                                        🔎
                                    </span>

