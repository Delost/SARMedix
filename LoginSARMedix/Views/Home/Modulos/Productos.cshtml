@using Microsoft.AspNetCore.Http

@{
    ViewData["Title"] = "Productos";
    ViewData["TituloBarra"] = "Seleccione Submódulo";

    string permisosTexto =
        Context.Session.GetString("Permisos") ?? "";

    var permisos =
        permisosTexto.Split(
            '|',
            StringSplitOptions.RemoveEmptyEntries
        );

    bool permisoRegistrar =
        permisos.Any(
            p => p.Equals(
                "Registrar productos",
                StringComparison.OrdinalIgnoreCase
            )
        );

    bool permisoConsultar =
        permisos.Any(
            p => p.Equals(
                "Consultar productos",
                StringComparison.OrdinalIgnoreCase
            )
        );
}


<style>


    /* AJUSTE DE ESTA VISTA*/


    main[role="main"] {
        padding: 0 !important;
        justify-content: flex-start;
        align-items: stretch;
    }


    /* CONTENIDO */

    .submenu-contenedor {
        width: 100%;
        min-height: calc(100vh - 144px);

        display: flex;
        flex-direction: column;
        align-items: center;

        padding: 48px 25px 45px 25px;

        background-color: #eef4fb;
    }


    .submenu-titulo {
        color: #07527c;
        font-size: 29px;
        font-weight: 700;
        text-align: center;
    }


    .submenu-descripcion {
        margin: 10px 0 38px 0;

        color: #60798b;
        font-size: 15px;
        text-align: center;
    }


    /* TARJETAS */

    .submenu-grid {
        width: 100%;
        max-width: 950px;

        display: flex;
        justify-content: center;
        gap: 25px;
        flex-wrap: wrap;
    }


    .submenu-card {
        width: 300px;
        min-height: 216px;

        padding: 34px 28px;

        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;

        background-color: white;

        border-radius: 14px;

        box-shadow:
            0 8px 22px
            rgba(16, 65, 95, 0.11);

        text-decoration: none;

        color: inherit;

        text-align: center;

        transition:
            transform 0.2s ease,
            box-shadow 0.2s ease;
    }


    .submenu-card:hover {
        transform: translateY(-4px);

        box-shadow:
            0 13px 30px
            rgba(16, 65, 95, 0.17);

        color: inherit;
    }


    .submenu-icono {
        width: 64px;
        height: 64px;

        margin-bottom: 20px;

        display: flex;
        align-items: center;
        justify-content: center;

        border-radius: 50%;

        background-color: #e8f5fa;

        font-size: 30px;
    }


    .submenu-card-titulo {
        margin-bottom: 9px;

        color: #07527c;

        font-size: 18px;
        font-weight: 700;
    }


    .submenu-card p {
        margin: 0;

        color: #60798b;

        font-size: 14px;

        line-height: 1.5;
    }


    /* VOLVER */

    .volver-contenedor {
        margin-top: 38px;

        text-align: center;
    }


    .btn-volver-submenu {
        display: inline-block;

        padding: 11px 22px;

        border-radius: 7px;

        background-color: #1198a5;

        color: white;

        text-decoration: none;

        font-size: 14px;
        font-weight: 600;

        transition:
            background-color 0.2s ease;
    }


    .btn-volver-submenu:hover {
        background-color: #0d8490;

        color: white;
    }


    /* RESPONSIVE */

    @@media (max-width: 750px) {

        .submenu-card {
            width: 100%;
            max-width: 440px;
        }

    }


    @@media (max-width: 500px) {

        .submenu-contenedor {
            padding: 35px 18px;
        }


        .submenu-titulo {
            font-size: 25px;
        }

    }

</style>



<section class="submenu-contenedor">


    <div class="submenu-titulo">

        Productos

    </div>


    <p class="submenu-descripcion">

        Seleccione una opción para gestionar
        los productos e inventario.

    </p>



    <div class="submenu-grid">


        <!-- REGISTRAR PRODUCTO -->

        @if (permisoRegistrar)
        {
            <a asp-controller="Home"
               asp-action="CrearProducto"
               class="submenu-card">


                <div class="submenu-icono">

                    ➕

                </div>


                <div class="submenu-card-titulo">

                    Registrar Producto

                </div>


                <p>

                    Registrar un nuevo medicamento
                    o insumo en SARMedix.

                </p>


            </a>
        }



        <!-- LISTADO DE PRODUCTOS -->

        @if (permisoConsultar)
        {
            <a asp-controller="Home"
               asp-action="ListadoProductos2"
               class="submenu-card">


                <div class="submenu-icono">

                    📦

                </div>


                <div class="submenu-card-titulo">

                    Listado de Productos

                </div>


                <p>

                    Consultar y editar los medicamentos
                    e insumos registrados.

                </p>


            </a>
        }



        <!-- LOTES -->

        @if (permisoConsultar)
        {
            <a asp-controller="Home"
               asp-action="Lotes"
               class="submenu-card">


                <div class="submenu-icono">

                    📁

                </div>


                <div class="submenu-card-titulo">

                    Gestión de Lotes

                </div>


                <p>

                    Consultar y administrar los lotes
                    asociados a los productos.

                </p>


            </a>
        }


    </div>

    

    <!-- VOLVER -->

    <div class="volver-contenedor">


        <a asp-controller="Home"
           asp-action="Modulos"
           class="btn-volver-submenu">

            ← Volver a módulos

        </a>


    </div>


</section>