@{
    Layout = null;

    var permisos = ViewBag.Permisos as List<string> ?? new List<string>();

    bool permisoUsuarios =
        permisos.Any(p => p.Equals("Crear usuario", StringComparison.OrdinalIgnoreCase)) ||
        permisos.Any(p => p.Equals("Gestionar usuarios y permisos", StringComparison.OrdinalIgnoreCase));

    bool permisoProductos =
        permisos.Any(p => p.Equals("Consultar productos", StringComparison.OrdinalIgnoreCase)) ||
        permisos.Any(p => p.Equals("Registrar productos", StringComparison.OrdinalIgnoreCase)) ||
        permisos.Any(p => p.Equals("Gestionar productos", StringComparison.OrdinalIgnoreCase));

    bool permisoMovimientos =
        permisos.Any(p => p.Equals("Registrar movimientos", StringComparison.OrdinalIgnoreCase)) ||
        permisos.Any(p => p.Equals("Consultar historial", StringComparison.OrdinalIgnoreCase)) ||
        permisos.Any(p => p.Equals("Gestionar movimientos", StringComparison.OrdinalIgnoreCase));

    bool permisoControlados =
        permisos.Any(p => p.Equals("Gestionar medicamentos controlados", StringComparison.OrdinalIgnoreCase));

    string nombreCompleto = ViewBag.Nombre + " " + ViewBag.Apellido;

    string inicial = !string.IsNullOrEmpty(ViewBag.Nombre?.ToString())
        ? ViewBag.Nombre.ToString().Substring(0, 1).ToUpper()
        : "U";
}

<!DOCTYPE html>

<html lang="es">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>SARMedix - Seleccione Módulo</title>

    <style>

        * {
            box-sizing: border-box;
        }


        body {
            margin: 0;

            min-height: 100vh;

            display: flex;

            flex-direction: column;

            font-family: "Segoe UI", Arial, sans-serif;

            background: #f1f5fb;

            color: #17324d;
        }



        /* ================================= */
        /* BARRA SUPERIOR                    */
        /* ================================= */

        .barra-superior {
            height: 82px;

            display: grid;

            grid-template-columns: 1fr 1fr 1fr;

            align-items: center;

            padding: 0 60px;

            background: #0f5278;

            color: white;

            box-shadow:
                0 3px 10px
                rgba(0,0,0,0.15);
        }



        /* ================================= */
        /* LOGO                              */
        /* ================================= */

        .logo {
            display: flex;

            align-items: center;

            gap: 14px;
        }


        .logo-cruz-medica {
            width: 48px;

            height: 48px;

            background: white;

            border-radius: 12px;

            display: flex;

            align-items: center;

            justify-content: center;

            box-shadow:
                0 4px 10px
                rgba(0, 0, 0, 0.15);
        }


        .cruz {
            position: relative;

            width: 22px;

            height: 22px;

            display: block;
        }


        .cruz::before,
        .cruz::after {
            content: "";

            position: absolute;

            background: #0b6fb8;

            border-radius: 3px;
        }


        .cruz::before {
            width: 8px;

            height: 22px;

            left: 7px;

            top: 0;
        }


        .cruz::after {
            width: 22px;

            height: 8px;

            left: 0;

            top: 7px;
        }


        .logo-texto {
            font-size: 25px;

            font-weight: 700;

            color: white;

            letter-spacing: 0.3px;
        }



        /* ================================= */
        /* TITULO CENTRAL                    */
        /* ================================= */

        .titulo-superior {
            text-align: center;

            font-size: 25px;

            font-weight: 600;
        }



        /* ================================= */
        /* INFORMACION DEL USUARIO           */
        /* ================================= */

        .usuario-superior {
            display: flex;

            justify-content: flex-end;

            align-items: center;

            gap: 16px;
        }


        .usuario-datos {
            text-align: right;
        }


        .usuario-nombre {
            display: block;

            font-size: 16px;

            font-weight: 600;
        }


        .usuario-rol {
            display: block;

            margin-top: 2px;

            font-size: 13px;

            opacity: 0.85;
        }


        .usuario-circulo {
            width: 48px;

            height: 48px;

            display: flex;

            align-items: center;

            justify-content: center;

            border-radius: 50%;

            background:
                rgba(255,255,255,0.22);

            font-size: 20px;

            font-weight: 600;
        }



        /* ================================= */
        /* CERRAR SESION                     */
        /* ================================= */

        .form-cerrar-sesion {
            margin: 0;
        }


        .btn-cerrar-sesion {
            padding: 9px 13px;

            border:
                1px solid
                rgba(255,255,255,0.65);

            border-radius: 7px;

            background: transparent;

            color: white;

            font-size: 13px;

            font-weight: 600;

            cursor: pointer;

            transition:
                background 0.2s ease;
        }


        .btn-cerrar-sesion:hover {
            background:
                rgba(255,255,255,0.16);
        }



        /* ================================= */
        /* CONTENEDOR PRINCIPAL              */
        /* ================================= */

        .contenido {
            width: 100%;

            max-width: 1240px;

            margin: 0 auto;

            padding:
                55px 40px 70px;

            flex: 1;
        }



        /* ================================= */
        /* CUADRICULA DE MODULOS             */
        /* ================================= */

        .modulos {
            display: grid;

            grid-template-columns:
                repeat(2, 1fr);

            gap: 34px;
        }



        /* ================================= */
        /* TARJETAS                          */
        /* ================================= */

        .modulo {
            position: relative;

            height: 300px;

            overflow: hidden;

            border-radius: 14px;

            background: white;

            box-shadow:
                0 7px 20px
                rgba(28, 65, 95, 0.13);

            transition:
                transform 0.22s ease,
                box-shadow 0.22s ease;

            text-decoration: none;

            color: inherit;
        }



        /*
            Cuando tiene permiso,
            la tarjeta crece al pasar el mouse
        */

        .modulo.habilitado:hover {
            transform:
                scale(1.035);

            box-shadow:
                0 15px 32px
                rgba(15, 91, 150, 0.25);

            z-index: 5;

            cursor: pointer;
        }



        /* ================================= */
        /* TITULO DE CADA MODULO             */
        /* ================================= */

        .modulo-titulo {
            display: none;
        }



        /* ================================= */
        /* IMAGEN GENERAL                    */
        /* ================================= */

        .modulo-imagen {
            position: relative;

            height: 100%;

            background-size: cover;

            background-position:
                center center;

            background-repeat:
                no-repeat;
        }



        /* ================================= */
        /* AJUSTE PARA LAS IMAGENES DE ABAJO */
        /* ================================= */

        .imagen-movimientos {
            background-position:
                center 78%;
        }


        .imagen-controlados {
            background-position:
                center 78%;
        }



        /* ================================= */
        /* TARJETA BLOQUEADA                 */
        /* ================================= */

        .modulo.bloqueado {
            cursor: not-allowed;

            box-shadow:
                0 5px 15px
                rgba(0,0,0,0.09);
        }



        /* Titulo gris cuando no tiene permiso */

        .modulo.bloqueado
        .modulo-titulo {
            background: #d7d9dc;

            color: #63717c;
        }



        /* Imagen en escala de grises */

        .modulo.bloqueado
        .modulo-imagen {
            filter:
                grayscale(100%);
        }



        /* Capa oscura encima de la imagen */

        .modulo-bloqueo {
            position: absolute;

            inset: 0;

            display: flex;

            flex-direction: column;

            justify-content: center;

            align-items: center;

            background:
                rgba(80, 88, 95, 0.58);

            color: white;

            font-weight: 700;

            z-index: 2;
        }


        .candado {
            margin-bottom: 9px;

            font-size: 38px;
        }


        .sin-permiso {
            font-size: 19px;
        }



        /* ================================= */
        /* FOOTER                            */
        /* ================================= */

        .footer {
            width: 100%;

            margin-top: auto;

            padding: 18px;

            background:
                rgba(255, 255, 255, 0.90);

            text-align: center;

            color: #668092;

            font-size: 13px;
        }



        /* ================================= */
        /* RESPONSIVE                        */
        /* ================================= */

        @@media (max-width: 1200px) {

            .barra-superior {
                grid-template-columns:
                    1fr 1fr;

                height: auto;

                min-height: 85px;

                padding:
                    15px 25px;
            }


            .titulo-superior {
                display: none;
            }


            .modulos {
                grid-template-columns:
                    1fr;
            }


            .contenido {
                padding:
                    35px 20px;
            }


            .modulo-imagen,
            .imagen-movimientos,
            .imagen-controlados {
                background-position:
                    center top;
            }
        }

    </style>

</head>


<body>


    <!-- ================================= -->
    <!-- BARRA SUPERIOR                    -->
    <!-- ================================= -->

    <header class="barra-superior">


        <!-- LOGO -->

        <div class="logo">


            <div class="logo-cruz-medica">

                <span class="cruz"></span>

            </div>


            <div class="logo-texto">

                SARMedix | SAR de Chiguay

            </div>


        </div>



        <!-- TITULO -->

        <div class="titulo-superior">

            Seleccione Módulo

        </div>



        <!-- USUARIO -->

        <div class="usuario-superior">


            <div class="usuario-datos">


                <span class="usuario-nombre">

                    @nombreCompleto

                </span>


                <span class="usuario-rol">

                    @ViewBag.Rol

                </span>


            </div>



            <div class="usuario-circulo">

                @inicial

            </div>



            <form asp-controller="Home"
                  asp-action="CerrarSesion"
                  method="post"
                  class="form-cerrar-sesion">


                <button type="submit"
                        class="btn-cerrar-sesion">

                    Cerrar sesión

                </button>


            </form>


        </div>


    </header>



    <!-- ================================= -->
    <!-- MODULOS                           -->
    <!-- ================================= -->

    <main class="contenido">


        <div class="modulos">



            <!-- ================================= -->
            <!-- USUARIOS Y PERMISOS               -->
            <!-- ================================= -->

            @if (permisoUsuarios)
            {
                <a href="/Home/UsuariosPermisos"
                   class="modulo habilitado">


                    <div class="modulo-titulo">

                        Usuarios y Permisos

                    </div>


                    <div class="modulo-imagen"
                         style="
                        background-image:
                        url('/images/modulos/usuarios-permisos.jpg');
                        ">

                    </div>


                </a>
            }
            else
            {
                <div class="modulo bloqueado">


                    <div class="modulo-titulo">

                        Usuarios y Permisos

                    </div>


                    <div class="modulo-imagen"
                         style="
                        background-image:
                        url('/images/modulos/usuarios-permisos.jpg');
                        ">


                        <div class="modulo-bloqueo">


                            <div class="candado">

                                🔒

                            </div>


                            <div class="sin-permiso">

                                Sin permiso

                            </div>


                        </div>


                    </div>


                </div>
            }



            <!-- ================================= -->
            <!-- PRODUCTOS                         -->
            <!-- ================================= -->

            @if (permisoProductos)
            {
                <a href="/Home/Productos"
                   class="modulo habilitado">


                    <div class="modulo-titulo">

                        Productos

                    </div>


                    <div class="modulo-imagen"
                         style="
                        background-image:
                        url('/images/modulos/productos.jpg');
                        ">

                    </div>


                </a>
            }
            else
            {
                <div class="modulo bloqueado">


                    <div class="modulo-titulo">

                        Productos

                    </div>


                    <div class="modulo-imagen"
                         style="
                        background-image:
                        url('/images/modulos/productos.jpg');
                        ">


                        <div class="modulo-bloqueo">


                            <div class="candado">

                                🔒

                            </div>


                            <div class="sin-permiso">

                                Sin permiso

                            </div>


                        </div>


                    </div>


                </div>
            }



            <!-- ================================= -->
            <!-- MOVIMIENTOS E HISTORIAL           -->
            <!-- ================================= -->

            @if (permisoMovimientos)
            {
                <a href="/Home/MovimientoHistorial"
                   class="modulo habilitado">


                    <div class="modulo-titulo">

                        Movimientos e Historial

                    </div>


                    <div class="modulo-imagen imagen-movimientos"
                         style="
                        background-image:
                        url('/images/modulos/movimientos.jpg');
                        ">

                    </div>


                </a>
            }
            else
            {
                <div class="modulo bloqueado">


                    <div class="modulo-titulo">

                        Movimientos e Historial

                    </div>


                    <div class="modulo-imagen imagen-movimientos"
                         style="
                        background-image:
                        url('/images/modulos/movimientos.jpg');
                        ">


                        <div class="modulo-bloqueo">


                            <div class="candado">

                                🔒

                            </div>


                            <div class="sin-permiso">

                                Sin permiso

                            </div>


                        </div>


                    </div>


                </div>
            }



            <!-- ================================= -->
            <!-- MEDICAMENTOS CONTROLADOS          -->
            <!-- ================================= -->

            @if (permisoControlados)
            {
                <a href="/Home/MedicamentosControlados"
                   class="modulo habilitado">


                    <div class="modulo-titulo">

                        Medicamentos Controlados

                    </div>


                    <div class="modulo-imagen imagen-controlados"
                         style="
                        background-image:
                        url('/images/modulos/controlados.jpg');
                        ">

                    </div>


                </a>
            }
            else
            {
                <div class="modulo bloqueado">


                    <div class="modulo-titulo">

                        Medicamentos Controlados

                    </div>


                    <div class="modulo-imagen imagen-controlados"
                         style="
                        background-image:
                        url('/images/modulos/controlados.jpg');
                        ">


                        <div class="modulo-bloqueo">


                            <div class="candado">

                                🔒

                            </div>


                            <div class="sin-permiso">

                                Sin permiso

                            </div>


                        </div>


                    </div>


                </div>
            }


        </div>


    </main>



    <!-- ================================= -->
    <!-- FOOTER                            -->
    <!-- ================================= -->

    <footer class="footer">

        SARMedix · Sistema de Gestión Farmacéutica · SAR de Chiguay

    </footer>


</body>

</html>