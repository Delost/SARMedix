@model LoginSARMedix.Models.Usuario

<h2>Ingrese los datos del nuevo usuario</h2>

<form asp-controller="Home"
      asp-action="NuevoUsuario"
      method="post"
      class="formulario-principal"
      id="formCrearUsuario"
      onsubmit="return validarYConfirmar()"
      novalidate>


    <div class="espacio-mensaje">

        @if (TempData["Mensaje"] != null)
        {
            <div class="mensaje mensaje-exito"
                 id="mensajeFormulario">

                @TempData["Mensaje"]

            </div>
        }
        else
        {
            <div class="mensaje mensaje-error mensaje-oculto"
                 id="mensajeFormulario">
            </div>
        }

    </div>


    <div class="grupo-campo">

        <label>Nombre</label>

        <input asp-for="nombre"
               id="nombre"
               autocomplete="off" />

    </div>


    <div class="grupo-campo">

        <label>Apellido</label>

        <input asp-for="apellido"
               id="apellido"
               autocomplete="off" />

    </div>


    <div class="grupo-campo">

        <label>Correo electrónico</label>

        <input asp-for="email"
               id="email"
               type="email"
               autocomplete="off" />

    </div>


    <div class="grupo-campo">

        <label>RUT</label>

        <input asp-for="rut"
               id="rut"
               maxlength="10"
               autocomplete="off"
               oninput="formatearRut(this)" />

    </div>


    <div class="grupo-campo">

        <label>Rol</label>

        <select asp-for="id_rol"
                id="id_rol">

            <option value="">
                Seleccione un rol
            </option>

            <option value="1">
                Administrador
            </option>

            <option value="2">
                TENS
            </option>

            <option value="3">
                Enfermera
            </option>

            <option value="4">
                Auxiliar
            </option>

        </select>

    </div>


    <div class="grupo-campo">

        <label>Nombre de usuario</label>

        <input asp-for="nombre_usuario"
               id="nombre_usuario"
               autocomplete="off" />

    </div>


    <div class="grupo-campo">

        <label>Contraseña</label>

        <input asp-for="contrasena"
               id="contrasena"
               type="password"
               autocomplete="new-password" />

    </div>


    <br />


    <button type="submit">
        Crear usuario
    </button>

</form>


<div class="contenedor-volver">

    <a asp-controller="Home"
       asp-action="UsuariosPermisos"
       class="btn-volver-usuarios">

        ← Volver a Usuarios y Permisos

    </a>

</div>


@if (ViewBag.Mensaje != null)
{
    <script>
        alert('@ViewBag.Mensaje');
    </script>
}



<!-- =========================================
     VENTANA DE CONFIRMACIÓN
========================================= -->

<div id="modalConfirmacion"
     class="modal-fondo">

    <div class="modal-contenido">

        <div class="modal-icono">
            ?
        </div>

        <h2>
            Confirmar acción
        </h2>

        <p>
            ¿Quieres crear este usuario?
        </p>

        <div class="modal-botones">

            <button type="button"
                    class="btn-modal-si"
                    onclick="crearUsuario()">

                Sí

            </button>


            <button type="button"
                    class="btn-modal-no"
                    onclick="cerrarConfirmacion()">

                No

            </button>


            <button type="button"
                    class="btn-modal-cancelar"
                    onclick="cancelarCreacion()">

                Cancelar

            </button>

        </div>

    </div>

</div>



<style>

    .espacio-mensaje {
        min-height: 48px;
        margin-bottom: 8px;
    }


    .mensaje {
        width: 100%;
        padding: 12px 15px;
        border-radius: 7px;
        text-align: center;
        font-weight: 600;
        opacity: 1;
        transition: opacity 0.5s ease;
        box-sizing: border-box;
    }


    .mensaje-exito {
        background-color: #d1e7dd;
        color: #0f5132;
        border: 1px solid #badbcc;
    }


    .mensaje-error {
        background-color: #f8d7da;
        color: #842029;
        border: 1px solid #f5c2c7;
    }


    .mensaje-oculto {
        visibility: hidden;
    }


    /* =========================================
       CAMPOS DEL FORMULARIO
    ========================================= */

    .grupo-campo {
        width: 100%;
        margin-bottom: 18px;
    }


    .grupo-campo label {
        display: block;
        margin-bottom: 8px;
        font-weight: 600;
    }


    .formulario-principal input,
    .formulario-principal select {
        width: 100%;
        height: 54px;
        padding: 0 16px;

        border: 1px solid #b8cfe0;
        border-radius: 10px;

        font-size: 16px;

        background-color: white;

        box-sizing: border-box;

        outline: none;
    }


    .formulario-principal input:focus,
    .formulario-principal select:focus {
        border-color: #1198a5;
        box-shadow: 0 0 0 3px rgba(17, 152, 165, 0.15);
    }


    .formulario-principal button[type="submit"] {
        width: 100%;
        min-height: 48px;
        border: none;
        border-radius: 8px;
        background-color: #1198a5;
        color: white;
        font-size: 16px;
        font-weight: 600;
        cursor: pointer;
    }


    .formulario-principal button[type="submit"]:hover {
        background-color: #0d8490;
    }


    .contenedor-volver {
        display: flex;
        justify-content: center;
        margin-top: 30px;
        margin-bottom: 30px;
    }


    .btn-volver-usuarios {
        display: inline-block;
        padding: 12px 22px;
        background-color: #1198a5;
        color: white;
        border-radius: 7px;
        text-decoration: none;
        font-weight: 600;
    }


    .btn-volver-usuarios:hover {
        background-color: #0d8490;
        color: white;
    }


    /* =========================================
       VENTANA DE CONFIRMACIÓN
    ========================================= */

    .modal-fondo {
        display: none;
        position: fixed;

        top: 0;
        left: 0;

        width: 100%;
        height: 100%;

        background-color: rgba(0, 0, 0, 0.45);

        align-items: center;
        justify-content: center;

        z-index: 9999;
    }


    .modal-contenido {
        width: 90%;
        max-width: 430px;

        background-color: white;

        border-radius: 15px;

        padding: 30px;

        text-align: center;

        box-shadow:
            0 12px 35px
            rgba(0, 0, 0, 0.25);
    }


    .modal-icono {
        width: 55px;
        height: 55px;

        margin:
            0 auto
            15px auto;

        display: flex;

        align-items: center;
        justify-content: center;

        background-color: #1198a5;

        color: white;

        border-radius: 50%;

        font-size: 30px;

        font-weight: bold;
    }


    .modal-contenido h2 {
        margin-top: 0;
        color: #003b64;
    }


    .modal-contenido p {
        margin-top: 15px;
        margin-bottom: 25px;

        font-size: 17px;

        color: #444;
    }


    .modal-botones {
        display: flex;

        justify-content: center;

        gap: 10px;

        flex-wrap: wrap;
    }


    .modal-botones button {
        min-width: 90px;

        padding:
            10px 18px;

        border: none;

        border-radius: 7px;

        color: white;

        font-weight: 600;

        cursor: pointer;
    }


    .btn-modal-si {
        background-color: #198754;
    }


    .btn-modal-si:hover {
        background-color: #157347;
    }


    .btn-modal-no {
        background-color: #c82333;
    }


    .btn-modal-no:hover {
        background-color: #a91d2a;
    }


    .btn-modal-cancelar {
        background-color: #59636b;
    }


    .btn-modal-cancelar:hover {
        background-color: #474f55;
    }

</style>



<script>

    let usuarioConfirmado = false;


    function formatearRut(input) {

        let rut = input.value
            .replace(/[^0-9kK]/g, '')
            .toUpperCase();


        rut = rut.substring(0, 9);


        if (rut.length > 1) {

            rut =
                rut.slice(0, -1)
                + "-"
                + rut.slice(-1);
        }


        input.value = rut;
    }



    function mostrarError(texto, campo) {

        const mensaje =
            document.getElementById(
                "mensajeFormulario"
            );


        mensaje.innerText = texto;


        mensaje.className =
            "mensaje mensaje-error";


        mensaje.style.visibility =
            "visible";


        mensaje.style.opacity =
            "1";


        campo.focus();
    }



    function validarYConfirmar() {

        if (usuarioConfirmado) {

            return true;
        }


        const nombre =
            document.getElementById(
                "nombre"
            );


        const apellido =
            document.getElementById(
                "apellido"
            );


        const email =
            document.getElementById(
                "email"
            );


        const rut =
            document.getElementById(
                "rut"
            );


        const rol =
            document.getElementById(
                "id_rol"
            );


        const nombreUsuario =
            document.getElementById(
                "nombre_usuario"
            );


        const contrasena =
            document.getElementById(
                "contrasena"
            );



        if (nombre.value.trim() === "") {

            mostrarError(
                "Debe ingresar el nombre.",
                nombre
            );

            return false;
        }



        if (apellido.value.trim() === "") {

            mostrarError(
                "Debe ingresar el apellido.",
                apellido
            );

            return false;
        }



        if (email.value.trim() === "") {

            mostrarError(
                "Debe ingresar el correo electrónico.",
                email
            );

            return false;
        }



        if (!email.value.includes("@@") ||
            !email.value.includes(".")) {

            mostrarError(
                "Debe ingresar un correo electrónico válido.",
                email
            );

            return false;
        }



        if (rut.value.trim() === "") {

            mostrarError(
                "Debe ingresar el RUT.",
                rut
            );

            return false;
        }



        if (rol.value === "") {

            mostrarError(
                "Debe seleccionar un rol.",
                rol
            );

            return false;
        }



        if (nombreUsuario.value.trim() === "") {

            mostrarError(
                "Debe ingresar el nombre de usuario.",
                nombreUsuario
            );

            return false;
        }



        if (contrasena.value.trim() === "") {

            mostrarError(
                "Debe ingresar una contraseña.",
                contrasena
            );

            return false;
        }



        document.getElementById(
            "modalConfirmacion"
        ).style.display = "flex";


        return false;
    }



    function crearUsuario() {

        usuarioConfirmado = true;


        document.getElementById(
            "modalConfirmacion"
        ).style.display = "none";


        document.getElementById(
            "formCrearUsuario"
        ).requestSubmit();
    }



    function cerrarConfirmacion() {

        usuarioConfirmado = false;


        document.getElementById(
            "modalConfirmacion"
        ).style.display = "none";
    }



    function cancelarCreacion() {

        usuarioConfirmado = false;


        document.getElementById(
            "modalConfirmacion"
        ).style.display = "none";


        document.getElementById(
            "nombre"
        ).value = "";


        document.getElementById(
            "apellido"
        ).value = "";


        document.getElementById(
            "email"
        ).value = "";


        document.getElementById(
            "rut"
        ).value = "";


        document.getElementById(
            "id_rol"
        ).value = "";


        document.getElementById(
            "nombre_usuario"
        ).value = "";


        document.getElementById(
            "contrasena"
        ).value = "";


        const mensaje =
            document.getElementById(
                "mensajeFormulario"
            );


        mensaje.innerText = "";


        mensaje.className =
            "mensaje mensaje-error mensaje-oculto";


        mensaje.style.visibility =
            "hidden";


        mensaje.style.opacity =
            "1";


        document.getElementById(
            "nombre"
        ).focus();
    }



    setTimeout(function () {

        const mensaje =
            document.getElementById(
                "mensajeFormulario"
            );


        if (
            mensaje &&
            mensaje.classList.contains(
                "mensaje-exito"
            )
        ) {

            mensaje.style.opacity = "0";


            setTimeout(function () {

                mensaje.style.visibility =
                    "hidden";

            }, 500);
        }

    }, 3000);

</script>