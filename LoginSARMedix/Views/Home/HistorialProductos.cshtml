@using System.Text.RegularExpressions
@model List<LoginSARMedix.Models.Historial>

@{
    ViewData["Title"] = "Historial de Productos";
    ViewData["TituloBarra"] = "Historial de Productos";

    string buscarActual =
        ViewBag.Buscar?.ToString() ?? "";

    string filtroActual =
        ViewBag.Filtro?.ToString() ?? "todos";

    string periodoActual =
        ViewBag.Periodo?.ToString() ?? "todos";

    int totalRegistros =
        ViewBag.TotalRegistros != null
            ? Convert.ToInt32(
                ViewBag.TotalRegistros
            )
            : 0;
}


<div class="historial-card">

    <div class="historial-titulo">

        <h1>
            Historial de Productos
        </h1>

        <p>
            Registro de cambios realizados en productos y lotes de SARMedix
        </p>

    </div>



    <!-- =========================================================
         HERRAMIENTAS
         ========================================================= -->

    <div class="historial-herramientas">


        <!-- =====================================================
             BUSQUEDA

             ESTE FORMULARIO SOLO SE ENCARGA DE BUSCAR.

             MANTIENE LOS FILTROS QUE YA ESTEN ACTIVOS.
             ===================================================== -->

        <form asp-controller="Home"
              asp-action="HistorialProductos"
              method="get"
              class="form-busqueda">


            <input type="hidden"
                   name="filtro"
                   value="@filtroActual" />


            <input type="hidden"
                   name="periodo"
                   value="@periodoActual" />



            <div class="filtro-busqueda">

                <span class="filtro-icono-busqueda">

                    🔎

                </span>


                <input type="text"
                       name="buscar"
                       value="@buscarActual"
                       placeholder="Buscar por responsable, producto, lote o motivo..."
                       autocomplete="off" />

            </div>



            <button type="submit"
                    class="btn-buscar">

                Buscar

            </button>


        </form>



        <!-- =====================================================
             FILTROS

             ESTE FORMULARIO SOLO SE ENCARGA DE:
             - TIPO
             - PERIODO

             CONSERVA LA BUSQUEDA ACTUAL.
             ===================================================== -->

        <form asp-controller="Home"
              asp-action="HistorialProductos"
              method="get"
              class="form-filtros">


            <input type="hidden"
                   name="buscar"
                   value="@buscarActual" />



            <!-- TIPO -->

            <div class="filtro-campo">

                <label for="filtroProductos">

                    Tipo

                </label>


                <select id="filtroProductos"
                        name="filtro">


                    <option value="todos"
                            selected="@(filtroActual == "todos" ? "selected" : null)">

                        Todos los cambios

                    </option>


                    <option value="productos"
                            selected="@(filtroActual == "productos" ? "selected" : null)">

                        Productos

                    </option>


                    <option value="lotes"
                            selected="@(filtroActual == "lotes" ? "selected" : null)">

                        Lotes

                    </option>


                    <option value="entradas"
                            selected="@(filtroActual == "entradas" ? "selected" : null)">

                        Entradas de stock

                    </option>


                    <option value="salidas"
                            selected="@(filtroActual == "salidas" ? "selected" : null)">

                        Salidas de stock

                    </option>


                </select>

            </div>



            <!-- PERIODO -->

            <div class="filtro-campo">

                <label for="periodoProductos">

                    Período

                </label>


                <select id="periodoProductos"
                        name="periodo">


                    <option value="todos"
                            selected="@(periodoActual == "todos" ? "selected" : null)">

                        Todo el historial

                    </option>


                    <option value="hoy"
                            selected="@(periodoActual == "hoy" ? "selected" : null)">

                        Hoy

                    </option>


                    <option value="7"
                            selected="@(periodoActual == "7" ? "selected" : null)">

                        Últimos 7 días

                    </option>


                    <option value="30"
                            selected="@(periodoActual == "30" ? "selected" : null)">

                        Últimos 30 días

                    </option>


                </select>

            </div>



            <!-- APLICAR FILTROS -->

            <button type="submit"
                    class="btn-aplicar-filtros">

                Aplicar

            </button>



            <!--
                LIMPIAR SOLO LOS FILTROS.

                IMPORTANTE:
                CONSERVAMOS buscarActual.
            -->

            <a asp-controller="Home"
               asp-action="HistorialProductos"
               asp-route-buscar="@buscarActual"
               class="btn-limpiar-filtros">

                Limpiar

            </a>


        </form>


    </div>



    <!-- =========================================================
         RESUMEN
         ========================================================= -->

    <div class="historial-resumen-filtros">

        <span>

            Registros encontrados:

            <strong>
                @totalRegistros
            </strong>

        </span>


        @if (!string.IsNullOrWhiteSpace(
                buscarActual))
        {
            <span class="filtro-activo">

                🔎 “@buscarActual”

            </span>
        }


        @if (filtroActual != "todos")
        {
            <span class="filtro-activo">

                Filtro: @filtroActual

            </span>
        }


        @if (periodoActual != "todos")
        {
            <span class="filtro-activo">

                Período:
                @(periodoActual == "hoy"
                    ? "Hoy"
                    : periodoActual == "7"
                        ? "Últimos 7 días"
                        : "Últimos 30 días")

            </span>
        }

    </div>



    <!-- =========================================================
         TABLA
         ========================================================= -->

    @if (Model != null &&
         Model.Count > 0)
    {
        <div class="tabla-contenedor">

            <table class="tabla-historial">

                <thead>

                    <tr>

                        <th class="columna-id">

                            ID

                        </th>


                        <th class="columna-responsable">

                            Responsable

                        </th>


                        <th class="columna-descripcion">

                            Descripción

                        </th>


                        <th class="columna-fecha">

                            Fecha y hora

                        </th>

                    </tr>

                </thead>



                <tbody>

                    @foreach (var registro in Model)
                    {
                        string descripcion =
                            registro.descripcion ?? "";


                        /*
                            DETECTAR MOVIMIENTO
                        */

                        Match movimiento =
                            Regex.Match(
                                descripcion,
                                @"^Registró\s+(entrada|salida)\s+de\s+(\d+)\s+unidad\(es\)\s+del medicamento\s+(.+?),\s+lote\s+(.+?)\.\s+Stock:\s+(\d+)\s+→\s+(\d+)\.\s+Motivo:\s+(.+)$",
                                RegexOptions.IgnoreCase
                            );


                        bool esMovimiento =
                            movimiento.Success;



                        /*
                            DETECTAR LOTE
                        */

                        bool esLote =
                            descripcion.StartsWith(
                                "Creó el lote ",
                                StringComparison.OrdinalIgnoreCase
                            )
                            ||
                            descripcion.StartsWith(
                                "Actualizó el lote ",
                                StringComparison.OrdinalIgnoreCase
                            )
                            ||
                            descripcion.StartsWith(
                                "Eliminó el lote ",
                                StringComparison.OrdinalIgnoreCase
                            );



                        /*
                            SI NO ES MOVIMIENTO NI LOTE,
                            ES UNA ACCION DE PRODUCTO.
                        */

                        bool esProducto =
                            !esMovimiento
                            &&
                            !esLote;



                        <tr>


                            <!-- ID -->

                            <td>

                                <span class="historial-id">

                                    @registro.id_historial

                                </span>

                            </td>



                            <!-- RESPONSABLE -->

                            <td>

                                <div class="responsable-historial">


                                    <span class="responsable-icono">

                                        👤

                                    </span>


                                    <span>

                                        @registro.usuario_responsable

                                    </span>


                                </div>

                            </td>



                            <!-- DESCRIPCION -->

                            <td class="descripcion-historial">



                                <!-- MOVIMIENTO -->

                                @if (esMovimiento)
                                {
                                    string tipoMovimiento =
                                        movimiento.Groups[1]
                                            .Value;


                                    string cantidad =
                                        movimiento.Groups[2]
                                            .Value;


                                    string medicamento =
                                        movimiento.Groups[3]
                                            .Value;


                                    string lote =
                                        movimiento.Groups[4]
                                            .Value;


                                    string stockAnterior =
                                        movimiento.Groups[5]
                                            .Value;


                                    string stockResultante =
                                        movimiento.Groups[6]
                                            .Value;


                                    string motivo =
                                        movimiento.Groups[7]
                                            .Value;


                                    bool esEntrada =
                                        tipoMovimiento.Equals(
                                            "entrada",
                                            StringComparison.OrdinalIgnoreCase
                                        );


                                    <div class="descripcion-movimiento">


                                        <div class="movimiento-cabecera">


                                            <span class="movimiento-icono">

                                                💊

                                            </span>


                                            <span class="movimiento-tipo
                                                         @(esEntrada
                                                             ? "movimiento-entrada"
                                                             : "movimiento-salida")">

                                                @(esEntrada
                                                    ? "↑ Entrada"
                                                    : "↓ Salida")

                                            </span>


                                            <strong class="movimiento-producto">

                                                @medicamento

                                            </strong>


                                        </div>



                                        <div class="movimiento-accion">


                                            <span class="movimiento-label">

                                                Acción realizada

                                            </span>


                                            <p>

                                                Se registró una

                                                <strong>
                                                    @tipoMovimiento.ToLower()
                                                </strong>

                                                de

                                                <strong>
                                                    @cantidad unidad(es)
                                                </strong>

                                                del medicamento

                                                <strong>
                                                    @medicamento
                                                </strong>

                                                correspondiente al lote

                                                <strong>
                                                    @lote
                                                </strong>.

                                            </p>


                                        </div>



                                        <div class="movimiento-datos">


                                            <div class="movimiento-dato">

                                                <span class="movimiento-label">

                                                    Lote

                                                </span>


                                                <strong>

                                                    @lote

                                                </strong>

                                            </div>



                                            <div class="movimiento-dato">

                                                <span class="movimiento-label">

                                                    Cantidad

                                                </span>


                                                <strong class="@(esEntrada ? "cantidad-entrada" : "cantidad-salida")">

                                                    @((esEntrada ? "+" : "-") + cantidad)

                                                </strong>

                                            </div>



                                            <div class="movimiento-dato">

                                                <span class="movimiento-label">

                                                    Stock

                                                </span>


                                                <strong>

                                                    @stockAnterior


                                                    <span class="movimiento-flecha">

                                                        →

                                                    </span>


                                                    @stockResultante

                                                </strong>

                                            </div>


                                        </div>



                                        <div class="movimiento-motivo">


                                            <span class="movimiento-label">

                                                Motivo

                                            </span>


                                            <span>

                                                @motivo

                                            </span>


                                        </div>


                                    </div>
                                }



                                <!-- LOTE -->

                                @if (esLote)
                                {
                                    <div class="descripcion-evento evento-lote">


                                        <div class="evento-cabecera">


                                            <span class="evento-icono categoria-lotes">

                                                📋

                                            </span>


                                            <span class="evento-categoria categoria-lotes">

                                                Lotes

                                            </span>


                                        </div>



                                        <div class="evento-contenido">


                                            <span class="evento-label">

                                                Acción realizada

                                            </span>


                                            <p>

                                                @descripcion

                                            </p>


                                        </div>


                                    </div>
                                }



                                <!-- PRODUCTO -->

                                @if (esProducto)
                                {
                                    <div class="descripcion-evento evento-producto">


                                        <div class="evento-cabecera">


                                            <span class="evento-icono categoria-productos">

                                                📦

                                            </span>


                                            <span class="evento-categoria categoria-productos">

                                                Productos

                                            </span>


                                        </div>



                                        <div class="evento-contenido">


                                            <span class="evento-label">

                                                Acción realizada

                                            </span>


                                            <p>

                                                @descripcion

                                            </p>


                                        </div>


                                    </div>
                                }


                            </td>



                            <!-- FECHA -->

                            <td>

                                <div class="fecha-historial">


                                    <span class="fecha-dia">

                                        @registro.fecha_hora.ToString(
                                            "dd-MM-yyyy"
                                        )

                                    </span>


                                    <span class="fecha-hora">

                                        @registro.fecha_hora.ToString(
                                            "HH:mm:ss"
                                        )

                                    </span>


                                </div>

                            </td>


                        </tr>
                    }

                </tbody>

            </table>

        </div>



        <!-- =====================================================
             PAGINACION
             ===================================================== -->

        @if (ViewBag.TotalPaginas > 1)
        {
            <div class="paginacion">


                @if (ViewBag.PaginaActual > 1)
                {
                    <a asp-controller="Home"
                       asp-action="HistorialProductos"
                       asp-route-pagina="@(ViewBag.PaginaActual - 1)"
                       asp-route-buscar="@buscarActual"
                       asp-route-filtro="@filtroActual"
                       asp-route-periodo="@periodoActual"
                       class="pagina-boton">

                        ← Anterior

                    </a>
                }



                @for (
                    int i = 1;
                    i <= ViewBag.TotalPaginas;
                    i++)
                {
                    <a asp-controller="Home"
                       asp-action="HistorialProductos"
                       asp-route-pagina="@i"
                       asp-route-buscar="@buscarActual"
                       asp-route-filtro="@filtroActual"
                       asp-route-periodo="@periodoActual"
                       class="pagina-boton @(i == ViewBag.PaginaActual ? "pagina-activa" : "")">

                        @i

                    </a>
                }



                @if (ViewBag.PaginaActual <
                     ViewBag.TotalPaginas)
                {
                    <a asp-controller="Home"
                       asp-action="HistorialProductos"
                       asp-route-pagina="@(ViewBag.PaginaActual + 1)"
                       asp-route-buscar="@buscarActual"
                       asp-route-filtro="@filtroActual"
                       asp-route-periodo="@periodoActual"
                       class="pagina-boton">

                        Siguiente →

                    </a>
                }


            </div>
        }
    }
    else
    {
        <div class="sin-registros">


            @if (
                !string.IsNullOrWhiteSpace(
                    buscarActual
                )
                ||
                filtroActual != "todos"
                ||
                periodoActual != "todos")
            {
                <strong>

                    No se encontraron cambios
                    con esos criterios.

                </strong>


                <span>

                    Prueba cambiando la búsqueda
                    o modificando los filtros.

                </span>
            }
            else
            {
                <strong>

                    No existen registros
                    relacionados con productos.

                </strong>
            }


        </div>
    }



    <!-- VOLVER -->

    <div class="contenedor-volver">

        <a asp-controller="Home"
           asp-action="MovimientoHistorial"
           class="btn-volver">

            ← Volver a Movimientos e Historial

        </a>

    </div>


</div>



<style>

    /* =========================================================
       CONTENEDOR
       ========================================================= */

    .historial-card {
        width: 95%;
        max-width: 1200px;
        margin: 5px auto;
    }


    .historial-titulo {
        margin-bottom: 20px;
        text-align: center;
    }


    .historial-titulo h1 {
        margin-bottom: 8px;
        color: #087bc2;
        font-size: 32px;
    }


    .historial-titulo p {
        margin: 0;
        color: #687b89;
        font-size: 16px;
    }



    /* =========================================================
       HERRAMIENTAS
       ========================================================= */

    .historial-herramientas {
        margin-bottom: 10px;

        padding: 15px;

        display: grid;

        grid-template-columns:
            minmax(350px, 1.4fr)
            minmax(480px, 1fr);

        gap: 14px;

        align-items: end;

        border:
            1px solid #d7e5eb;

        border-radius: 12px;

        background-color:
            rgba(
                255,
                255,
                255,
                0.96
            );

        box-shadow:
            0 5px 16px
            rgba(
                28,
                65,
                95,
                0.08
            );
    }



    /* =========================================================
       FORMULARIO DE BUSQUEDA
       ========================================================= */

    .form-busqueda {
        display: grid;

        grid-template-columns:
            minmax(0, 1fr)
            auto;

        gap: 8px;

        align-items: end;
    }


    .filtro-busqueda {
        min-height: 43px;

        display: flex;

        align-items: center;

        gap: 8px;

        padding: 0 12px;

        border:
            1px solid #cbdce4;

        border-radius: 8px;

        background-color: #fbfdfe;
    }


    .filtro-icono-busqueda {
        font-size: 15px;

        opacity: 0.7;
    }


    .filtro-busqueda input {
        width: 100%;

        border: none;

        outline: none;

        background: transparent;

        color: #24485d;

        font-size: 13px;
    }


    .filtro-busqueda:focus-within {
        border-color: #1198a5;

        box-shadow:
            0 0 0 3px
            rgba(
                17,
                152,
                165,
                0.11
            );
    }



    /* BOTON BUSCAR */

    .btn-buscar {
        min-height: 43px;

        padding: 0 18px;

        border:
            1px solid #087bc2;

        border-radius: 8px;

        background-color: #087bc2;

        color: white;

        font-size: 12px;

        font-weight: 700;

        cursor: pointer;

        transition:
            background-color 0.2s ease,
            transform 0.2s ease;
    }


    .btn-buscar:hover {
        background-color: #066aa7;

        transform:
            translateY(
                -1px
            );
    }



    /* =========================================================
       FORMULARIO DE FILTROS
       ========================================================= */

    .form-filtros {
        display: grid;

        grid-template-columns:
            minmax(150px, 1fr)
            minmax(150px, 1fr)
            auto
            auto;

        gap: 8px;

        align-items: end;
    }


    .filtro-campo {
        display: flex;

        flex-direction: column;

        gap: 5px;
    }


    .filtro-campo label {
        color: #627985;

        font-size: 10px;

        font-weight: 800;

        text-transform: uppercase;

        letter-spacing: 0.35px;
    }


    .filtro-campo select {
        min-height: 43px;

        padding: 0 10px;

        border:
            1px solid #cbdce4;

        border-radius: 8px;

        background-color: #fbfdfe;

        color: #24485d;

        outline: none;

        font-size: 13px;
    }


    .filtro-campo select:focus {
        border-color: #1198a5;

        box-shadow:
            0 0 0 3px
            rgba(
                17,
                152,
                165,
                0.11
            );
    }



    /* =========================================================
       BOTONES DE FILTROS
       ========================================================= */

    .btn-aplicar-filtros,
    .btn-limpiar-filtros {
        min-height: 43px;

        padding: 0 15px;

        display: inline-flex;

        align-items: center;

        justify-content: center;

        border-radius: 8px;

        font-size: 12px;

        font-weight: 700;

        text-decoration: none;

        cursor: pointer;

        transition:
            background-color 0.2s ease,
            transform 0.2s ease;
    }


    .btn-aplicar-filtros {
        border:
            1px solid #1198a5;

        background-color: #1198a5;

        color: white;
    }


    .btn-aplicar-filtros:hover {
        background-color: #0d8490;

        transform:
            translateY(
                -1px
            );
    }


    .btn-limpiar-filtros {
        border:
            1px solid #b9cbd4;

        background-color: white;

        color: #527080;
    }


    .btn-limpiar-filtros:hover {
        background-color: #f1f6f8;

        color: #35586a;

        transform:
            translateY(
                -1px
            );
    }



    /* =========================================================
       RESUMEN
       ========================================================= */

    .historial-resumen-filtros {
        margin:
            0
            2px
            12px;

        display: flex;

        align-items: center;

        gap: 8px;

        flex-wrap: wrap;

        color: #647985;

        font-size: 12px;
    }


    .filtro-activo {
        padding: 4px 8px;

        border-radius: 999px;

        background-color: #e9f6f8;

        color: #137683;

        font-weight: 700;
    }



    /* =========================================================
       TABLA
       ========================================================= */

    .tabla-contenedor {
        width: 100%;

        overflow-x: auto;

        background-color: white;

        border-radius: 12px;

        box-shadow:
            0 7px 20px
            rgba(
                28,
                65,
                95,
                0.12
            );
    }


    .tabla-historial {
        width: 100%;

        table-layout: fixed;

        border-collapse: collapse;
    }


    .tabla-historial th {
        padding: 14px;

        background-color: #0f5278;

        color: white;

        text-align: left;

        font-weight: 600;
    }


    .tabla-historial td {
        padding: 12px 14px;

        border-bottom:
            1px solid #dce6ec;

        color: #17324d;

        vertical-align: top;
    }


    .tabla-historial tbody tr:hover {
        background-color: #f4f9fc;
    }


    .columna-id {
        width: 7%;
    }


    .columna-responsable {
        width: 16%;
    }


    .columna-descripcion {
        width: 59%;
    }


    .columna-fecha {
        width: 18%;
    }



    /* ID */

    .historial-id {
        display: inline-flex;

        min-width: 34px;

        padding: 5px 7px;

        align-items: center;

        justify-content: center;

        border-radius: 6px;

        background-color: #edf5f9;

        color: #31566d;

        font-size: 12px;

        font-weight: 700;
    }



    /* RESPONSABLE */

    .responsable-historial {
        display: flex;

        align-items: center;

        gap: 7px;
    }


    .responsable-icono {
        width: 26px;

        min-width: 26px;

        height: 26px;

        display: flex;

        align-items: center;

        justify-content: center;

        border-radius: 50%;

        background-color: #eef6fa;

        font-size: 12px;
    }



    /* =========================================================
       EVENTOS
       ========================================================= */

    .descripcion-evento,
    .descripcion-movimiento {
        width: 100%;

        padding: 11px 13px;

        border:
            1px solid #dce7ec;

        border-radius: 9px;

        background-color: #fbfdfe;

        box-sizing: border-box;
    }


    .evento-producto {
        border-left:
            4px solid #c37a38;
    }


    .evento-lote {
        border-left:
            4px solid #4f7d99;
    }


    .evento-cabecera,
    .movimiento-cabecera {
        margin-bottom: 8px;

        display: flex;

        align-items: center;

        gap: 8px;

        flex-wrap: wrap;
    }


    .evento-icono,
    .movimiento-icono {
        width: 30px;

        min-width: 30px;

        height: 30px;

        display: flex;

        align-items: center;

        justify-content: center;

        border-radius: 8px;
    }


    .evento-categoria,
    .movimiento-tipo {
        display: inline-flex;

        align-items: center;

        padding: 4px 9px;

        border-radius: 999px;

        font-size: 10px;

        font-weight: 800;

        text-transform: uppercase;
    }


